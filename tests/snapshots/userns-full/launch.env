declare -- NET_MODE="dns"
declare -- CAPS_KEEP="true"
declare -- NEST_TCP=""
declare -- NEST_UDP=""
declare -- SBX_DNS_ADDR="127.0.0.2"
declare -- DNSMASQ_BIN="@DNSMASQ@"
declare -a DNSMASQ_ARGS=([0]="--server=/github.com/1.1.1.1" [1]="--nftset=/github.com/inet#sbx_filter#allowed4_1" [2]="--server=/google.com/1.1.1.1" [3]="--nftset=/google.com/inet#sbx_filter#allowed4_1")
declare -- TEST_DOMAIN="github.com"
declare -- RESOLV_DEST="@RESOLV_DEST@"
