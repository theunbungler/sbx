table inet sbx_filter {
    set allowed4_1 {
        type ipv4_addr
        flags timeout
    }
    chain output {
        type filter hook output priority 0; policy drop;
        oif "lo" accept
        ct state established,related accept
        ip daddr 127.0.0.2 udp dport 53 accept
        ip daddr 127.0.0.2 tcp dport 53 accept
        ip daddr 1.1.1.1 udp dport 53 accept
        ip daddr 1.1.1.1 tcp dport 53 accept
        ip daddr 192.168.1.0/24 tcp dport { 80,443 } accept
        ip daddr 192.168.1.0/24 udp dport { 80,443 } accept
        ip daddr @allowed4_1 tcp dport { 80,443 } accept
        ip daddr @allowed4_1 udp dport { 80,443 } accept
        meta nfproto ipv6 drop
    }
    chain forward {
        type filter hook forward priority 0; policy drop;
        ct state established,related accept
        ip daddr 192.168.1.0/24 tcp dport { 80,443 } accept
        ip daddr 192.168.1.0/24 udp dport { 80,443 } accept
        ip daddr @allowed4_1 tcp dport { 80,443 } accept
        ip daddr @allowed4_1 udp dport { 80,443 } accept
        meta nfproto ipv6 drop
    }
    chain input {
        type filter hook input priority 0; policy accept;
        iifname "sbx-a" ip daddr 10.200.0.1 udp dport 53 accept
        iifname "sbx-a" ip daddr 10.200.0.1 tcp dport 53 accept
        iifname "sbx-a" counter drop
    }
    chain postrouting {
        type nat hook postrouting priority srcnat; policy accept;
        ip saddr 10.200.0.2 oifname != "sbx-a" masquerade
    }
}
