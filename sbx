#!/bin/bash

# sbx - Portable Unprivileged Sandbox Orchestrator
#
# Layout: helpers and subcommands, then the launch as a sequence of phases,
# then main. The launch builds its state in globals (BWRAP_ARGS, the plan
# settings, the session paths), one phase after another, in the order bwrap
# needs its mount arguments.

set -e

STATE_DIR="$HOME/.local/state/sbx"
CONFIG_DIR="$HOME/.config/sbx"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# shellcheck source=lib/copy-mounts.sh
source "$SCRIPT_DIR/lib/copy-mounts.sh"
# shellcheck source=lib/state-paths.sh
source "$SCRIPT_DIR/lib/state-paths.sh"
# shellcheck source=lib/render.sh
source "$SCRIPT_DIR/lib/render.sh"
# shellcheck source=lib/deps.sh
source "$SCRIPT_DIR/lib/deps.sh"
# shellcheck source=lib/profiles.sh
source "$SCRIPT_DIR/lib/profiles.sh"
# shellcheck source=lib/profile-check.sh
source "$SCRIPT_DIR/lib/profile-check.sh"
# shellcheck source=lib/net-merge.sh
source "$SCRIPT_DIR/lib/net-merge.sh"
# shellcheck source=lib/resolve.sh
source "$SCRIPT_DIR/lib/resolve.sh"
# shellcheck source=lib/sessions.sh
source "$SCRIPT_DIR/lib/sessions.sh"
# shellcheck source=lib/nestnet.sh
source "$SCRIPT_DIR/lib/nestnet.sh"
# shellcheck source=lib/egress.sh
source "$SCRIPT_DIR/lib/egress.sh"

# Serializes every observation of the two-step session claim (see
# claim_session): --gc takes it too, since it is exactly the observer the
# claim protects against. Directly under $STATE_DIR, not in join/, because a
# session may be named ".claim". Masked inside the sandbox like join/.
CLAIM_LOCK="$STATE_DIR/claim.lock"

# Flags. Profiles are resolved to paths as they are parsed.
FS_PROFILES=()
NET_PROFILES=()
LAST_PROFILES=()   # --cli: fs profiles applied after every --fs (compatibility)
WORKDIR=""
WORKSPACE=""      # the --workspace file, expanded into the flags as parsed
WS_WORKDIR=""     # its wd; a --wd on the command line wins wherever it is
SECCOMP_FILE=""   # --seccomp, as given (absolute)
SECCOMP_COPY=""   # the copy launch.sh loads, in the masked join/ area
HOST_PORT_SPECS=()   # as typed; lib/resolve.sh validates and buckets them
COMMAND=()
GUI_FLAG=false
DRY_RUN=false
DRY_RUN_JSON=false
RESEED=false
ASSUME_YES=false

# Set by the GUI phase; read by teardown.
XPRA_DISPLAY=""

# Every path runs this before touching state — except --dry-run, which
# must create nothing.
sbx_state_init() {
    mkdir -p "$STATE_DIR"
}

# --dry-run applies only to a launch. Each command that acts on state calls
# this with its own remaining arguments, so the combination is refused in
# either order: "--dry-run --gc" is caught through DRY_RUN, "--gc --dry-run"
# through the scan (which stops at --, where the payload's arguments begin).
sbx_refuse_dry_run() {   # <this command> <remaining args...>
    local cmd="$1" arg
    shift
    if [[ "$DRY_RUN" != "true" ]]; then
        for arg in "$@"; do
            if [[ "$arg" == "--" ]]; then
                break
            fi
            if [[ "$arg" == "--dry-run" ]]; then
                DRY_RUN=true
                break
            fi
        done
    fi
    if [[ "$DRY_RUN" == "true" ]]; then
        echo "Error: --dry-run applies only to a launch; it cannot be combined with $cmd." >&2
        exit 2
    fi
}

# Takes the claim lock on fd 8, warning (not failing) if it cannot: a
# filesystem without working flock should degrade visibly, not refuse every
# launch. <consequence> finishes the warning.
sbx_claim_lock() {   # <consequence>
    if exec 8>>"$CLAIM_LOCK"; then
        flock -x 8 || echo "Warning: could not lock $CLAIM_LOCK; $1" >&2
    else
        echo "Warning: could not open $CLAIM_LOCK; $1" >&2
    fi
}

usage() {
    cat <<EOF
Usage: $(basename "$0") [options] [command]

Options:
  --list-profiles        Show available profiles
                         (sbx-profile ls / check / new manage profile files)
  --list-sessions        Show active sessions
  --doctor [--json]      Check dependencies and host setup, with install commands
  --changes [<id>]       Show what a record mount changed (default: latest)
  --join <session>       Open a new shell inside a running session
                         (--join <session> -- <cmd> runs <cmd> instead)
  --attach <session>     Reattach to a session's original terminal
  --fs <profile>         Apply a filesystem profile (multiple allowed)
  --net <profile>        Apply a network profile (multiple allowed)
  --cli <profile>        Apply an fs profile after every --fs one (compatibility)
  --seccomp <file>       Load this compiled seccomp filter (raw BPF) for the
                         payload, its joins and containers (one per launch)
  --workspace <name>     Apply a saved selection: ./.sbx/<name>.json, else
                         ~/.config/sbx/<name>.json ({fs, net, wd, gui})
  --host-port <spec>     Reach a host service on 127.0.0.1:<port> from inside.
                         <spec> is <port>[/tcp|/udp]; bare means tcp.
                         (repeatable; implies a network namespace)
  --wd <path>            Start in this directory inside the sandbox
                         (default: launch dir if present, else \$HOME, else /)
  --gui                  Enable isolated GUI via xpra (attach with: xpra attach :<N>)
  --dry-run [--json]     Show what this launch would do, without doing it
                         (exits 1 if the launch would stop)
  --reseed               Discard this directory's forked stores, so the next
                         launch re-seeds them from the host (asks first)
  --gc                   Remove crash residue and old change archives
  --yes                  Do not prompt for confirmation
  -h, --help             Show this help message

Profiles are searched in:
  1. ./.sbx/profiles/
  2. \$HOME/.config/sbx/profiles/
  3. $SCRIPT_DIR/profiles/
EOF
}

resolve_profile() {   # <type> <name>
    sbx_profile_resolve "$1" "$2" "$CONFIG_DIR" "$SCRIPT_DIR/profiles"
}

# A workspace is flags written down: its profiles are applied where
# --workspace appears among the flags, its gui is OR'd with --gui, and its
# wd is used only when no --wd is given. Validated first, so a malformed
# file never half-applies.
expand_workspace() {   # <path>
    local level msg origin=user errors=0 name
    local -a names=()
    if [[ "$1" == ./.sbx/* ]]; then
        origin=project
    fi
    while IFS=$'\t' read -r level msg; do
        if [[ "$level" == error ]]; then
            echo "Error: $(sbx_sanitize_message "$msg")" >&2
            errors=1
        fi
    done < <(sbx_profile_check workspace "$1" "$origin")
    if [[ $errors -ne 0 ]]; then
        exit 1
    fi
    mapfile -t names < <(jq -r '.fs[]?' "$1")
    for name in "${names[@]}"; do
        FS_PROFILES+=("$(resolve_profile fs "$name")")
    done
    mapfile -t names < <(jq -r '.net[]?' "$1")
    for name in "${names[@]}"; do
        NET_PROFILES+=("$(resolve_profile net "$name")")
    done
    if [[ "$(jq -r '.gui // false' "$1")" == "true" ]]; then
        GUI_FLAG=true
    fi
    WS_WORKDIR="$(jq -r '.wd // ""' "$1" | envsubst)"
}

# ---------------------------------------------------------------------------
# Subcommands. Each runs when the parser reaches it, and exits.
# ---------------------------------------------------------------------------

cmd_doctor() {   # [--json]
    if [[ -n "${1:-}" && "$1" != "--json" ]]; then
        echo "Error: --doctor takes only --json." >&2
        exit 2
    fi
    local rc=0
    sbx_deps_doctor "${1:-}" || rc=$?
    exit "$rc"
}

cmd_gc() {
    local sdir sname sc scname wdir wname cdir keep forked_report

    # The sweeps judge a session dead by the absence of a liveness record,
    # which is exactly the intermediate state the claim hides behind this
    # lock. Held across all three; fd 8 is free, since --gc exits before
    # the claim or teardown run.
    sbx_claim_lock "a concurrent launch's session may be collected mid-claim."

    for sdir in "$STATE_DIR"/sessions/*; do
        [[ -d "$sdir" ]] || continue
        sname=$(basename "$sdir")
        sbx_session_alive "$STATE_DIR" "$sname" && continue
        echo "Removing crash residue: $sname"
        sbx_session_remove "$STATE_DIR" "$sname"
    done

    # Sidecars with no session directory can never belong to a live
    # session. Confined to join/, so it never reaches claim.lock.
    for sc in "$STATE_DIR"/join/*; do
        [[ -f "$sc" ]] || continue
        scname=$(basename "$sc")
        scname="${scname%.pid}"
        scname="${scname%.json}"
        scname="${scname%.lock}"
        [[ -d "$STATE_DIR/sessions/$scname" ]] && continue
        rm -f "${sc:?}"
    done

    # Record-mount work trees stranded by a session that never ran teardown
    # (SIGKILL, OOM, power loss). A live session's tree is bound into it.
    for wdir in "$STATE_DIR"/work/*; do
        [[ -d "$wdir" ]] || continue
        wname=$(basename "$wdir")
        sbx_session_alive "$STATE_DIR" "$wname" && continue
        echo "Removing stranded work tree: $wname"
        rm -rf "${wdir:?}"
    done

    exec 8>&-

    keep=$(sbx_keep_changes)
    for cdir in "$STATE_DIR"/changes/*; do
        [[ -d "$cdir" ]] || continue
        sbx_prune_changes "$cdir" "$keep"
    done

    # Forked stores are the user's accumulated tool state and are never
    # removed on a heuristic; they are listed so the space is visible.
    # forked/ outlives its last store, so print only when there are rows.
    forked_report=$(du -sh "$STATE_DIR"/forked/*/*/* 2>/dev/null | sed 's/^/  /')
    if [[ -n "$forked_report" ]]; then
        echo "Forked stores (not removed; use --reseed):"
        echo "$forked_report"
    fi
    exit 0
}

cmd_list_sessions() {
    local sdir scwd sid pid
    echo "Active Sessions (this directory):"
    for sdir in "$STATE_DIR"/sessions/*; do
        [[ -d "$sdir" && -f "$sdir/session.json" ]] || continue
        # session.json is inside the sandbox's rw session directory: every
        # field is attacker-authored, so control characters are stripped,
        # and liveness comes from the pid record instead (lib/sessions.sh).
        scwd=$(jq -r '.cwd' "$sdir/session.json" 2>/dev/null | tr -d '\000-\037')
        [[ "$scwd" == "$PWD" ]] || continue
        sid=$(jq -r '.id' "$sdir/session.json" 2>/dev/null | tr -d '\000-\037')
        if pid=$(sbx_session_live_pid "$STATE_DIR" "$(basename "$sdir")"); then
            echo "  $sid (PID: $pid)"
        fi
    done
    exit 0
}

cmd_changes() {   # [<id>]
    local changes_dir target d
    changes_dir="$STATE_DIR/changes/$(sbx_copy_path_slug "$PWD")"
    if [[ -n "${1-}" && "$1" != -* ]]; then
        target="$changes_dir/$1"
    else
        target=$(find "$changes_dir" -mindepth 1 -maxdepth 1 -type d 2>/dev/null |
                 LC_ALL=C sort | tail -n1)
    fi
    if [[ -z "$target" || ! -d "$target" ]]; then
        echo "No recorded changes for this directory." >&2
        exit 1
    fi
    echo "$target"
    # A record mount's contents come from inside the sandbox: strip control
    # characters before they reach a terminal.
    find "$target" -mindepth 2 -type f -printf '  + %P\n' | tr -d '\000-\037'
    for d in "$target"/*.deleted; do
        [[ -f "$d" ]] || continue
        sed 's/^/  - /' "$d" | tr -d '\000-\037'
    done
    exit 0
}

# Checks shared by --join and --attach; sets SDIR. The name is typed by
# hand and interpolated into paths, so it is validated first.
open_session() {   # <name>
    if ! sbx_session_name_valid "$1"; then
        echo "Error: Invalid session name '$1'." >&2
        exit 1
    fi
    SDIR="$STATE_DIR/sessions/$1"
    # -S: the server's rendezvous point is a unix socket.
    if [[ ! -d "$SDIR" || ! -S "$SDIR/tmux.sock" ]]; then
        echo "Error: Session '$1' not found or no socket available." >&2
        exit 1
    fi
    if ! command -v tmux >/dev/null 2>&1; then
        echo "Error: sbx requires tmux, which is not on PATH." >&2
        exit 1
    fi
}

cmd_join() {   # <name> [-- <cmd>...]
    local name="$1" meta join_path join_wd lock
    local -a cmd=(/bin/bash)
    shift
    if [[ "${1-}" == "--" && $# -gt 1 ]]; then
        shift
        cmd=("$@")
    fi
    open_session "$name"

    # Everything --join needs comes from the host-written sidecar, never
    # from the session directory: that is bound rw into the sandbox it is
    # about to enter. Absent means a session this sbx did not start; fail
    # closed rather than guess.
    meta="$STATE_DIR/join/$name.json"
    if [[ ! -f "$meta" ]]; then
        echo "Error: Session '$name' has no join metadata; it was not started by this version of sbx." >&2
        exit 1
    fi
    join_path=$(jq -r '.path' "$meta")
    join_wd=$(jq -r '.workdir' "$meta")

    # Shared for the life of the join (the fd survives the exec); teardown
    # takes it exclusively before archiving record mounts. See teardown.
    lock="$STATE_DIR/join/$name.lock"
    if exec 9>>"$lock"; then
        flock -s 9 || echo "Warning: could not lock $lock; teardown may not wait for this join." >&2
    fi

    # new-session, not attach: an independent client with its own pty and
    # size, forked by the already-capless server (the drop happens once, in
    # launch.sh). env PATH by absolute path: tmux hands a pane the client's
    # PATH regardless of update-environment. -c: start where the payload
    # did; a directory missing inside makes tmux fall back to $HOME.
    exec tmux -S "$SDIR/tmux.sock" new-session -c "$join_wd" -- \
        /usr/bin/env "PATH=$join_path" "${cmd[@]}"
}

# Mirroring, deliberately: the way back to a payload you detached from.
cmd_attach() {   # <name>
    open_session "$1"
    exec tmux -S "$SDIR/tmux.sock" attach -t main
}

parse_args() {
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --doctor)
                sbx_refuse_dry_run --doctor "${@:2}"
                sbx_state_init
                cmd_doctor "${2:-}"
                ;;
            --list-profiles)
                sbx_refuse_dry_run --list-profiles "${@:2}"
                sbx_state_init
                sbx_profile_list "$CONFIG_DIR" "$SCRIPT_DIR/profiles"
                exit 0
                ;;
            --gc)
                sbx_refuse_dry_run --gc "${@:2}"
                sbx_state_init
                cmd_gc
                ;;
            --list-sessions)
                sbx_refuse_dry_run --list-sessions "${@:2}"
                sbx_state_init
                cmd_list_sessions
                ;;
            --changes)
                sbx_refuse_dry_run --changes "${@:2}"
                sbx_state_init
                cmd_changes "${2-}"
                ;;
            --join)
                sbx_refuse_dry_run --join "${@:2}"
                sbx_state_init
                cmd_join "${@:2}"
                ;;
            --attach)
                sbx_refuse_dry_run --attach "${@:2}"
                sbx_state_init
                cmd_attach "$2"
                ;;
            --reseed)
                RESEED=true
                shift
                ;;
            --yes)
                ASSUME_YES=true
                shift
                ;;
            --fs)
                FS_PROFILES+=("$(resolve_profile fs "$2")")
                shift 2
                ;;
            --net)
                NET_PROFILES+=("$(resolve_profile net "$2")")
                shift 2
                ;;
            --cli)
                LAST_PROFILES+=("$(resolve_profile fs "$2")")
                shift 2
                ;;
            --workspace)
                if [[ -n "$WORKSPACE" ]]; then
                    echo "Error: only one --workspace per launch." >&2
                    exit 2
                fi
                WORKSPACE="$(sbx_workspace_resolve "$2" "$CONFIG_DIR")"
                expand_workspace "$WORKSPACE"
                shift 2
                ;;
            --seccomp)
                if [[ -n "$SECCOMP_FILE" ]]; then
                    echo "Error: only one --seccomp per launch." >&2
                    exit 2
                fi
                SECCOMP_FILE="$(realpath -m -- "$2")"
                shift 2
                ;;
            --host-port)
                HOST_PORT_SPECS+=("$2")
                shift 2
                ;;
            --wd)
                # envsubst like every other path sbx accepts, so '$HOME/src'
                # works quoted or expanded by the caller's shell.
                WORKDIR="$(echo "$2" | envsubst)"
                shift 2
                ;;
            --gui)
                GUI_FLAG=true
                shift
                ;;
            --dry-run)
                DRY_RUN=true
                shift
                if [[ "${1:-}" == "--json" ]]; then
                    DRY_RUN_JSON=true
                    shift
                fi
                ;;
            -h|--help)
                usage
                exit 0
                ;;
            --)
                shift
                COMMAND=("$@")
                return 0
                ;;
            --*)
                echo "Error: unknown option '$1'. Put the command after -- if it starts with a dash: sbx [options] -- <command>" >&2
                exit 2
                ;;
            *)
                COMMAND=("$@")
                return 0
                ;;
        esac
    done
}

# ---------------------------------------------------------------------------
# The launch, phase by phase.
# ---------------------------------------------------------------------------

# Everything after this may exec a core tool, so they are checked first,
# with the user-namespace and capability probes. A dry run needs only the
# tools this script itself calls before the report; anything else missing
# belongs in the report's Needs, as a reason the launch would stop.
preflight_core() {
    local tool
    local -a missing=()
    if [[ "$DRY_RUN" != "true" ]]; then
        sbx_deps_require core || exit 1
        return 0
    fi
    for tool in jq realpath envsubst; do
        command -v "$tool" >/dev/null 2>&1 || missing+=("$tool")
    done
    if [[ ${#missing[@]} -gt 0 ]]; then
        sbx_deps_report_missing "${missing[@]}" >&2
        exit 1
    fi
}

# Every decision about profiles is made here, without touching the disk
# (lib/resolve.sh). Everything after this reads the plan, never a profile.
resolve_plan() {
    local profile spec
    local -a args=(--launch-dir "$PWD" --config-dir "$CONFIG_DIR" --global-dir "$SCRIPT_DIR/profiles")
    for profile in "${FS_PROFILES[@]}" "${LAST_PROFILES[@]}"; do
        args+=(--fs "$profile")
    done
    for profile in "${NET_PROFILES[@]}"; do
        args+=(--net "$profile")
    done
    for spec in "${HOST_PORT_SPECS[@]}"; do
        args+=(--host-port "$spec")
    done
    if [[ -n "$WORKDIR" ]]; then
        args+=(--wd "$WORKDIR")
    fi
    if [[ "$GUI_FLAG" == "true" ]]; then
        args+=(--gui)
    fi
    if [[ -n "$WORKSPACE" ]]; then
        args+=(--workspace "$WORKSPACE")
    fi
    if [[ -n "$SECCOMP_FILE" ]]; then
        args+=(--seccomp "$SECCOMP_FILE")
    fi
    PLAN=$(sbx_resolve "${args[@]}")

    # The name this launch would claim and the widest socket path it could
    # need: the dry run's "stops" and the launch's own check read the same.
    SESSION_BASE=$(sbx_state_session_base "$PWD")
    SOCK_PROBE=$(sbx_state_socket_probe "$STATE_DIR" "$SESSION_BASE")
}

plan_get() {
    jq -r "$1" <<< "$PLAN"
}

# The plan, the host locations the launch would write, and the dependency
# check in report-only form. Exits 0 if the launch would proceed.
dry_run_report() {
    local needs writes doc var problem
    local -a checks groups stops=() passthrough passthrough_set=()
    mapfile -t checks < <(plan_get '.checks[] | "--" + .')
    mapfile -t groups < <(plan_get '.deps[]')
    needs=$(sbx_deps_status "${checks[@]}" "${groups[@]}")
    writes=$(sbx_state_writes "$PLAN" "$STATE_DIR" "$PWD" "${XAUTHORITY:-$HOME/.Xauthority}")

    # Launch-time gates that are not about the profiles.
    problem=$(sbx_state_socket_problem "$SOCK_PROBE")
    if [[ -n "$problem" ]]; then
        stops+=("$problem")
    fi

    # Passthrough names set in this environment — never their values.
    mapfile -t passthrough < <(plan_get '.passthrough[]')
    for var in "${passthrough[@]}"; do
        if [[ -n "$var" && -n "${!var-}" ]]; then
            passthrough_set+=("$var")
        fi
    done

    doc=$(jq -c --argjson needs "$needs" --argjson writes "$writes" \
        --argjson stops "$(sbx_resolve_strings "${stops[@]}")" \
        --argjson passthrough_set "$(sbx_resolve_strings "${passthrough_set[@]}")" \
        --arg session_name "$SESSION_BASE" --arg session_dir "$STATE_DIR/sessions/$SESSION_BASE/" \
        '. + {needs: $needs, writes: $writes, stops: $stops, passthrough_set: $passthrough_set,
              session: {name: $session_name, dir: $session_dir}}
             | .proceed = (((.errors | length) == 0) and .needs.ok and ((.stops | length) == 0))
             | .env |= map(del(.value))
             | del(.path)' \
        <<< "$PLAN")
    if [[ "$DRY_RUN_JSON" == "true" ]]; then
        jq -a . <<< "$doc"
    else
        sbx_render_plan "$doc" "$HOME"
    fi
    if [[ "$(jq -r '.proceed' <<< "$doc")" == "true" ]]; then
        exit 0
    fi
    exit 1
}

# Prompts for a profile lib/resolve.sh put in plan.confirm (project origin,
# git-tracked, trust not granted). It only prompts; the trust decision is
# the plan's. A cloned repository can ship profiles that mount anything, so
# using one is a decision made outside the repository.
prompt_project_profile() {   # <path> [<kind: profile|workspace>] [<user workspace it shadows>]
    local profile="$1" kind="${2:-profile}" shadows="${3:-}" remote="" rname="" answer=""
    rname=$(git -C "$PWD" remote 2>/dev/null | head -n1)
    if [[ -n "$rname" ]]; then
        remote=$(git -C "$PWD" remote get-url "$rname" 2>/dev/null || true)
    fi

    {
        echo ""
        echo "This launch would use a $kind tracked by the project's git repository:"
        echo "  $profile"
        if [[ -n "$shadows" ]]; then
            echo "  It shadows your workspace $shadows"
        fi
        if [[ -n "$remote" ]]; then
            echo ""
            echo "  The repo has remote $remote — this $kind was authored by"
            echo "  whoever wrote that repository, not by you."
        fi
        echo ""
        sed 's/^/  | /' "$profile"
        echo ""
    } >&2

    if [[ ! -t 0 ]]; then
        echo "Error: refusing to use a project $kind non-interactively." >&2
        echo "  Set SBX_TRUST_PROJECT_PROFILES=1 to allow it." >&2
        exit 1
    fi

    printf "Use this project %s? [y/N] " "$kind" >&2
    read -r answer < /dev/tty
    if [[ "$answer" != "y" && "$answer" != "Y" ]]; then
        echo "Aborted." >&2
        exit 1
    fi
}

# Errors first — a rejected profile must never prompt — then the trust
# prompts, then warnings: profile-authored warning text must not get the
# chance to repaint or crowd out the prompt.
check_plan() {
    local msg profile ws_path
    local -a confirm
    if [[ "$(plan_get '.errors | length')" != "0" ]]; then
        while IFS= read -r msg; do
            echo "Error: $msg" >&2
        done < <(plan_get '.errors[]')
        exit 1
    fi

    # mapfile, then a plain for: a `while read` loop would point fd 0 at
    # the process substitution, and the prompt tests fd 0 for a terminal.
    mapfile -t confirm < <(plan_get '.confirm[]')
    ws_path=$(plan_get '.workspace.path // ""')
    for profile in "${confirm[@]}"; do
        if [[ -n "$profile" && "$profile" == "$ws_path" ]]; then
            prompt_project_profile "$profile" workspace "$(plan_get '.workspace.shadows')"
        elif [[ -n "$profile" ]]; then
            prompt_project_profile "$profile"
        fi
    done

    while IFS= read -r msg; do
        if [[ -n "$msg" ]]; then
            echo "Warning: $(sbx_sanitize_message "$msg")" >&2
        fi
    done < <(plan_get '.warnings[]')
}

read_plan_settings() {
    # @sh quotes every string, so the eval sees only assignments whatever a
    # profile path contains.
    eval "$(jq -r '@sh "USERNS_FULL=\(.security.userns_full) USERNS_PROFILE=\(.security.userns_profile)
        CAPS_KEEP=\(.security.caps_keep) CAPS_PROFILE=\(.security.caps_profile)
        DOCKER_API=\(.security.docker_api) SBX_NETNS=\(.netns) NET_ENABLED=\(.net.enabled)
        TEST_DOMAIN=\(.net.test_domain // "") SANDBOX_PATH=\(.path) GUI=\(.gui)
        NEED_SUBIDS=\(.checks | index("subids") != null)"' <<< "$PLAN")"
    mapfile -t HOST_PORTS_TCP < <(plan_get '.host_ports.tcp[]')
    mapfile -t HOST_PORTS_UDP < <(plan_get '.host_ports.udp[]')
    NEST_TCP=$(IFS=,; echo "${HOST_PORTS_TCP[*]}")
    NEST_UDP=$(IFS=,; echo "${HOST_PORTS_UDP[*]}")
}

# The optional dependency groups and host checks this session's shape
# needs (see .deps and .checks in lib/resolve.sh), then the socket-length
# check, all before anything is claimed.
preflight_session() {
    local problem
    local -a groups
    mapfile -t groups < <(plan_get '(.deps[] | select(. != "core")), (.checks[] | select(. == "nsunshare"))')
    if [[ ${#groups[@]} -gt 0 ]]; then
        sbx_deps_require "${groups[@]}" || exit 1
    fi
    if [[ "$NEED_SUBIDS" == "true" ]] && ! sbx_deps_subids_ok; then
        echo "Error: profile '$USERNS_PROFILE' sets \"userns\": \"full\", which needs a subordinate UID and GID range for $(id -un)." >&2
        echo "  Add one:  sudo usermod --add-subuids 100000-165535 --add-subgids 100000-165535 $(id -un)" >&2
        echo "  (choose a range not already used by another user in /etc/subuid)" >&2
        exit 1
    fi

    if [[ "$CAPS_KEEP" == "true" ]]; then
        echo "Note: profile '$(basename "$CAPS_PROFILE" .json)' retains capabilities inside the payload's own namespace." >&2
        echo "  ro mounts and the egress firewall are still enforced from outside it; the payload can" >&2
        echo "  create further namespaces and hide paths from itself." >&2
    fi

    problem=$(sbx_state_socket_problem "$SOCK_PROBE")
    if [[ -n "$problem" ]]; then
        echo "Error: $problem" >&2
        exit 1
    fi
}

# Claiming a name is two steps that must look like one: mkdir takes it and
# the pid record proves the taker alive. Without the lock, a competitor in
# the gap between them would see a live session with no liveness record,
# call it crash residue and delete it.
claim_session() {
    local n=1
    mkdir -p "$STATE_DIR/sessions" "$STATE_DIR/join"
    sbx_claim_lock "a concurrent launch may race for this name."

    SESSION_ID="$SESSION_BASE"
    while ! mkdir "$STATE_DIR/sessions/$SESSION_ID" 2>/dev/null; do
        # A dead name is reclaimed with every sidecar: a predecessor's
        # join/<name>.json would otherwise describe this session to a
        # concurrent --reseed until ours is written.
        if ! sbx_session_alive "$STATE_DIR" "$SESSION_ID"; then
            sbx_session_remove "$STATE_DIR" "$SESSION_ID"
            continue
        fi
        n=$((n + 1))
        if [[ $n -gt 99 ]]; then
            echo "Error: too many live sessions named '$SESSION_BASE'." >&2
            exit 1
        fi
        SESSION_ID="$SESSION_BASE-$n"
    done
    printf '%s\n' "$$" > "$STATE_DIR/join/$SESSION_ID.pid"
    exec 8>&-

    SESSION_DIR="$STATE_DIR/sessions/$SESSION_ID"
    mkdir -p "$SESSION_DIR/tmp"
}

# The fixed part of the sandbox: namespaces, the base filesystem, the
# environment policy and the capability set.
build_base_args() {
    local var
    BWRAP_ARGS=(
        --unshare-ipc
        --unshare-pid
        --unshare-uts
        --unshare-cgroup
        --new-session
        --proc /proc
        --dev /dev
        --tmpfs /tmp
        --tmpfs /run
        --ro-bind /usr /usr
        --ro-bind /opt /opt
        --ro-bind /etc /etc
        --symlink usr/bin /bin
        --symlink usr/lib /lib
        --symlink usr/lib64 /lib64
    )

    # Clear everything, then reintroduce by name: the host environment
    # routinely carries API keys, tokens and SSH_AUTH_SOCK. No opt-out.
    BWRAP_ARGS+=(--clearenv)
    for var in HOME USER LOGNAME TERM COLORTERM LANG TZ SHELL ${!LC_@}; do
        if [[ -n "${!var-}" ]]; then
            BWRAP_ARGS+=(--setenv "$var" "${!var}")
        fi
    done
    # Profile passthrough, before the profile env blocks so those win.
    while IFS= read -r var; do
        if [[ -n "$var" && -n "${!var-}" ]]; then
            BWRAP_ARGS+=(--setenv "$var" "${!var}")
        fi
    done < <(plan_get '.passthrough[]')

    # "caps": "keep" with a single-id map: podman takes euid 0 for real
    # root and fails its devpts mount, so these documented overrides put it
    # back on the rootless path. Wrong under userns: full, where podman must
    # run rootful over a real multi-id map.
    if [[ "$SBX_NETNS" == "true" && "$CAPS_KEEP" == "true" && "$USERNS_FULL" != "true" ]]; then
        BWRAP_ARGS+=(
            --setenv _CONTAINERS_USERNS_CONFIGURED "done"
            --setenv _CONTAINERS_ROOTLESS_UID "$(id -u)"
            --setenv _CONTAINERS_ROOTLESS_GID "$(id -g)"
        )
    fi

    # bwrap joins B (--userns2) holding B's full capability set, so these
    # decide what the payload keeps. CAP_SETPCAP is the one exception to
    # the drop: launch.sh's setpriv spends it emptying the bounding set,
    # one exec before session.sh, so nothing in the session ever holds it.
    if [[ "$CAPS_KEEP" == "true" ]]; then
        BWRAP_ARGS+=(--cap-add ALL)
    else
        BWRAP_ARGS+=(--cap-drop ALL --cap-add CAP_SETPCAP)
    fi

    # No sandbox outlives sbx.
    BWRAP_ARGS+=(--die-with-parent)
}

# podman/qemu plumbing, in every session so network profiles behave the
# same whichever fs profile is loaded. It adds no reach: the device access
# (/dev/kvm, /dev/net/tun) stays opt-in through the fs profiles.
setup_virt() {
    VIRT_DIR="$SESSION_DIR/virt"
    mkdir -p "$VIRT_DIR"

    if [[ "$USERNS_FULL" == "true" ]]; then
        # Rootful-in-namespace podman reads graphroot. Real ownership (a full
        # subordinate range), so a store of its own, incompatible with the
        # single-id one.
        cat > "$VIRT_DIR/storage.conf" <<CONFEOF
[storage]
driver = "overlay"
graphroot = "$HOME/.local/state/sbx/virt/containers-full"
CONFEOF
    else
        # Written literally: podman expands $HOME itself, to the same value.
        cat > "$VIRT_DIR/storage.conf" <<'CONFEOF'
[storage]
driver = "overlay"
rootless_storage_path = "$HOME/.local/state/sbx/virt/containers"

[storage.options.overlay]
ignore_chown_errors = "true"
CONFEOF
    fi

    # The systemd cgroup manager needs a user systemd over dbus, which
    # cannot exist here (--unshare-ipc, /run is tmpfs).
    cat > "$VIRT_DIR/containers.conf" <<'CONFEOF'
[containers]
cgroups = "disabled"

[engine]
cgroup_manager = "cgroupfs"
events_logger = "file"
CONFEOF

    if [[ "$USERNS_FULL" == "true" ]]; then
        # Containers resolve through the sandbox's dnsmasq only on a network
        # with DNS enabled, which podman's default is not; so sbx0 becomes
        # the default. podman creates whatever the config names as default
        # itself, with DNS off, so lib/wrapper.sh creates sbx0 first under
        # this copy, taken before the [network] section exists (podman 6.1.1).
        cp "$VIRT_DIR/containers.conf" "$VIRT_DIR/containers-bootstrap.conf"
        cat >> "$VIRT_DIR/containers.conf" <<'CONFEOF2'

[network]
default_network = "sbx0"
CONFEOF2
    fi

    : > "$VIRT_DIR/empty"
    BWRAP_ARGS+=(
        --tmpfs /var
        --dir /var/tmp
        --dir "/run/user/$(id -u)"
        --ro-bind /sys /sys
        --ro-bind "$VIRT_DIR/empty" /etc/subuid
        --ro-bind "$VIRT_DIR/empty" /etc/subgid
        --setenv XDG_RUNTIME_DIR "/run/user/$(id -u)"
        --setenv CONTAINERS_STORAGE_CONF "$VIRT_DIR/storage.conf"
        --setenv CONTAINERS_CONF "$VIRT_DIR/containers.conf"
    )

    # A docker CLI shim and DOCKER_HOST, always: the socket behind it exists
    # only with "docker_api": true (lib/wrapper.sh). Pinned to the computed
    # /run/user/<uid>, not $XDG_RUNTIME_DIR, which a profile may override.
    PODMAN_SOCK="/run/user/$(id -u)/podman/podman.sock"
    mkdir -p "$SESSION_DIR/bin"
    cat > "$SESSION_DIR/bin/docker" <<'SHIMEOF'
#!/bin/sh
exec podman "$@"
SHIMEOF
    chmod +x "$SESSION_DIR/bin/docker"
    BWRAP_ARGS+=(--setenv DOCKER_HOST "unix://$PODMAN_SOCK")
}

# Profile mounts. ro/rw/dev bind directly; forked and record are collected
# for their own phases. sbx_state_writes (--dry-run) mirrors what each perm
# writes on the host.
add_profile_mounts() {
    local profile_name source dest perm parent part curr
    local -a parts writable=()
    FORKED_MOUNTS=()   # "profile<TAB>source<TAB>dest"
    RECORD_MOUNTS=()   # "source<TAB>dest"
    while IFS= read -r -d '' profile_name && IFS= read -r -d '' source &&
          IFS= read -r -d '' dest && IFS= read -r -d '' perm; do
        # An rw source may be a persistent directory not created yet.
        if [[ "$perm" == "rw" && ! -e "$source" ]]; then
            mkdir -p "$source"
        fi

        parent=$(dirname "$dest")
        if [[ "$parent" != "/" ]]; then
            IFS='/' read -ra parts <<< "$parent"
            curr=""
            for part in "${parts[@]}"; do
                if [[ -n "$part" ]]; then
                    curr="$curr/$part"
                    BWRAP_ARGS+=(--dir "$curr")
                fi
            done
        fi

        # -try: profile sources are optional on any given host, and one
        # absent toolchain must not take down the whole sandbox. The base
        # binds stay strict.
        case "$perm" in
            ro)     BWRAP_ARGS+=(--ro-bind-try "$source" "$dest") ;;
            rw)     BWRAP_ARGS+=(--bind-try "$source" "$dest")
                    writable+=("$source"$'\t'"$dest") ;;
            dev)    BWRAP_ARGS+=(--dev-bind-try "$source" "$dest")
                    writable+=("$source"$'\t'"$dest") ;;
            forked) FORKED_MOUNTS+=("$profile_name"$'\t'"$source"$'\t'"$dest") ;;
            record) RECORD_MOUNTS+=("$source"$'\t'"$dest") ;;
            *)
                # Unreachable while profile validation holds; fail closed.
                echo "Error: unknown perm '$perm' for mount $dest" >&2
                exit 1
                ;;
        esac
    done < <(jq -j 'def nul: [0] | implode; .mounts[] | .profile, nul, .source, nul, .dest, nul, .perm, nul' <<< "$PLAN")
    mask_project_sbx "${writable[@]}"
}

# The launch directory's .sbx is never visible inside a session.
#
# ./.sbx/profiles configures the NEXT launch, and an untracked profile there
# is trusted without a prompt (README, Threat model). So a session that can
# write it can hand itself any mount set — any host path, caps, host ports —
# on the next launch from that directory, and simply wait. An empty tmpfs
# goes over every writable mount that exposes it, whether that is the
# launch directory itself or an ancestor like $HOME.
#
# ro mounts are left alone: reading a project's own profiles is not the
# vector, writing them is. bwrap creates the mountpoint, so an empty .sbx
# may appear in a project that had none — git ignores empty directories, and
# writes inside the mask land on the tmpfs, never on the host.
mask_project_sbx() {   # <source<TAB>dest>...
    local pair src dest rel project_sbx
    project_sbx=$(sbx_copy_path_normalise "$PWD/.sbx")
    for pair in "$@"; do
        IFS=$'\t' read -r src dest <<< "$pair"
        src=$(sbx_copy_path_normalise "$src")
        dest=$(sbx_copy_path_normalise "$dest")
        if [[ "$project_sbx" == "$src" ]]; then
            BWRAP_ARGS+=(--tmpfs "$dest")
        elif [[ "$project_sbx" == "$src"/* ]]; then
            rel="${project_sbx#"$src"/}"
            BWRAP_ARGS+=(--tmpfs "$dest/$rel")
        fi
    done
}

forked_store() {   # <profile> <dest>
    sbx_state_forked_store "$STATE_DIR" "$PWD" "$1" "$2"
}

# Deletes this directory's forked stores after confirmation, and exits.
# Runs from the plan alone, before any session is claimed.
reseed() {
    local f_prof f_src f_dest f_store f_size spid sname lstore rt blocker="" reply i
    local -a sources=() dests=() targets=()

    while IFS= read -r -d '' f_prof && IFS= read -r -d '' f_src && IFS= read -r -d '' f_dest; do
        sources+=("$f_src")
        dests+=("$f_dest")
        targets+=("$(forked_store "$f_prof" "$f_dest")")
    done < <(jq -j 'def nul: [0] | implode;
        .mounts[] | select(.perm == "forked") | .profile, nul, .source, nul, .dest, nul' <<< "$PLAN")
    if [[ ${#targets[@]} -eq 0 ]]; then
        echo "No forked mounts in the selected profiles; nothing to reseed." >&2
        exit 1
    fi

    # A store is bound rw into every session using it; deleting it under a
    # live one destroys the state it is using. Which stores a session holds
    # is recorded in its host-written sidecar. A live session with no
    # sidecar yet is still starting: unknown means refuse.
    for spid in "$STATE_DIR"/join/*.pid; do
        [[ -f "$spid" ]] || continue
        sname=$(basename "$spid" .pid)
        sbx_session_alive "$STATE_DIR" "$sname" || continue
        if [[ ! -f "$STATE_DIR/join/$sname.json" ]]; then
            blocker="$sname (still starting up — its mounts are not recorded yet)"
            break
        fi
        while IFS= read -r lstore; do
            [[ -n "$lstore" ]] || continue
            for rt in "${targets[@]}"; do
                if [[ "$lstore" == "$rt" ]]; then
                    blocker="$sname"
                fi
            done
        done < <(jq -r '.forked_stores[]?' "$STATE_DIR/join/$sname.json" 2>/dev/null || true)
        if [[ -n "$blocker" ]]; then
            break
        fi
    done
    if [[ -n "$blocker" ]]; then
        echo "Error: session '$blocker' is live and may have these stores mounted." >&2
        echo "Refusing to reseed: deleting a store under a running session destroys the state it is using." >&2
        echo "End that session and try again." >&2
        exit 1
    fi

    echo "This will delete the sandbox-owned copies of:"
    for i in "${!targets[@]}"; do
        f_src="${sources[$i]}"
        f_dest="${dests[$i]}"
        f_store="${targets[$i]}"
        if [[ -d "$f_store" ]]; then
            f_size=$(du -sh "$f_store" 2>/dev/null | cut -f1)
        else
            f_size="not yet created"
        fi
        echo "  $f_dest  (re-seeded from $f_src)"
        echo "    $f_store  [$f_size]"
    done
    if [[ "$ASSUME_YES" != "true" ]]; then
        # read fails on EOF; under set -e that would skip "Aborted."
        read -r -p "Proceed? [y/N] " reply || true
        [[ "$reply" == [yY]* ]] || { echo "Aborted." >&2; exit 1; }
    fi
    for f_store in "${targets[@]}"; do
        rm -rf "${f_store:?}"
    done
    echo "Reseeded. The next launch will read from the host."
    exit 0
}

# Binds a seeded tree at <dest>: a file source was copied in under its own
# name; a directory's contents are the tree.
bind_seeded() {   # <tree> <source> <dest>
    if [[ -f "$2" ]]; then
        BWRAP_ARGS+=(--bind "$1/$(basename "$2")" "$3")
    else
        BWRAP_ARGS+=(--tmpfs "$3")
        BWRAP_ARGS+=(--bind "$1" "$3")
    fi
}

# forked: seeded from the host once, when the store does not exist; from
# then on the store IS the tree. An absent source is skipped, not seeded
# empty — an empty store would exist forever after, even once the host
# file appears.
seed_forked_mounts() {
    local fm f_prof f_src f_dest f_store
    FORKED_STORES=()   # recorded in the join sidecar for --reseed
    for fm in "${FORKED_MOUNTS[@]}"; do
        IFS=$'\t' read -r f_prof f_src f_dest <<< "$fm"
        if [[ ! -e "$f_src" ]]; then
            continue
        fi
        f_store=$(forked_store "$f_prof" "$f_dest")
        FORKED_STORES+=("$f_store")
        if [[ ! -e "$f_store" ]]; then
            mkdir -p "$f_store"
            sbx_copy_seed_progress "$f_src" "$f_store" "Seeding $f_dest"
        fi
        bind_seeded "$f_store" "$f_src" "$f_dest"
    done
}

# record: a private working copy seeded fresh every launch and hashed into a
# manifest; teardown diffs against that manifest, not the live host source,
# so a host edit during the session is never blamed on the sandbox. The old
# tree is removed first: cp merges into a stranded one from a killed
# session, and its ghost files would join the baseline.
seed_record_mounts() {
    local rm_ r_src r_dest r_id r_work
    RECORD_WORK_DIR="$STATE_DIR/work/$SESSION_ID"
    rm -rf "${RECORD_WORK_DIR:?}"
    for rm_ in "${RECORD_MOUNTS[@]}"; do
        IFS=$'\t' read -r r_src r_dest <<< "$rm_"
        r_id=$(sbx_copy_mount_id "$r_dest")
        r_work="$RECORD_WORK_DIR/$r_id"
        mkdir -p "$r_work"
        sbx_copy_seed_progress "$r_src" "$r_work" "Seeding $r_dest"
        sbx_manifest_build "$r_work" "$RECORD_WORK_DIR/$r_id.manifest"
        bind_seeded "$r_work" "$r_src" "$r_dest"
    done
}

add_env_and_path() {
    local key val
    # In profile order; bwrap keeps the last --setenv, so later profiles win.
    while IFS= read -r -d '' key && IFS= read -r -d '' val; do
        BWRAP_ARGS+=(--setenv "$key" "$val")
    done < <(jq -j 'def nul: [0] | implode; .env[] | .name, nul, .value, nul' <<< "$PLAN")

    if [[ -n "$WORKDIR" ]]; then
        BWRAP_ARGS+=(--chdir "$WORKDIR")
    fi

    # The docker shim first, so `docker` never resolves elsewhere.
    BWRAP_ARGS+=(--setenv PATH "$SESSION_DIR/bin:$SANDBOX_PATH")
}

setup_network() {
    local dns_dir="$SESSION_DIR/dns"
    SBX_DNS_ADDR=""
    RESOLV_DEST=""
    if [[ "$SBX_NETNS" != "true" ]]; then
        return 0
    fi

    # pasta mirrors the host's default-route interface and address.
    HOST_IFACE=$(ip route show default | awk '{print $5}' | head -n 1)
    if [[ -z "$HOST_IFACE" ]]; then
        echo "Error: networking needs a default route on the host, and there is none." >&2
        exit 1
    fi
    HOST_IP=$(ip addr show "$HOST_IFACE" | grep "inet " | awk '{print $2}' | cut -d/ -f1 | head -n 1)
    HOST_GW=$(ip route show default | awk '{print $3}' | head -n 1)
    HOST_MASK=$(ip addr show "$HOST_IFACE" | grep "inet " | awk '{print $2}' | cut -d/ -f2 | head -n 1)

    mkdir -p "$dns_dir"

    # Not 127.0.0.1: pasta binds 127.0.0.1:53 in its namespace whenever the
    # host listens on 53 (systemd-resolved, WSL2's proxy), and dnsmasq would
    # lose that race. The rest of 127/8 is untouched and local.
    SBX_DNS_ADDR="127.0.0.2"
    if [[ "$NET_ENABLED" == "true" ]]; then
        printf 'nameserver %s\n' "$SBX_DNS_ADDR" > "$dns_dir/resolv.conf"
    else
        # Host ports only: no resolver, so lookups fail at once instead of
        # hanging. "localhost" still resolves, from /etc/hosts.
        : > "$dns_dir/resolv.conf"
    fi

    # /etc/resolv.conf is often a symlink out of /etc (systemd-resolved,
    # WSL2), and a bind follows it to a target that does not exist in the
    # sandbox. Binding at the resolved target lets the inherited symlink
    # point at our file.
    RESOLV_DEST=/etc/resolv.conf
    if [[ -L /etc/resolv.conf ]]; then
        RESOLV_DEST=$(readlink -f /etc/resolv.conf 2>/dev/null) || RESOLV_DEST=""
        [[ -n "$RESOLV_DEST" ]] || RESOLV_DEST=/etc/resolv.conf
    fi
    BWRAP_ARGS+=(--ro-bind "$dns_dir/resolv.conf" "$RESOLV_DEST")

    sbx_egress_rules "$(plan_get '.net')" "$SBX_DNS_ADDR" "$NEST_TCP" "$NEST_UDP" > "$dns_dir/rules.nft"
}

# session.json is for display (--list-sessions), inside the sandbox's rw
# session directory. The join sidecar is outside it, in the masked join/
# area, because --join and --reseed act on it:
#   path          the session PATH, which --join re-imposes over tmux's
#   workdir       where a join starts (the launch dir when --wd is empty)
#   caps_keep     informational; the drop happens once, in launch.sh
#   forked_stores the stores bound rw, which --reseed must not delete. Not
#                 derivable later: the key includes the launch directory,
#                 whose only other record is the forgeable session.json.
write_session_records() {
    # The filter checked is the filter loaded: a private copy, outside
    # anything the sandbox can see (join/ is masked), taken before it starts.
    if [[ -n "$SECCOMP_FILE" ]]; then
        SECCOMP_COPY="$STATE_DIR/join/$SESSION_ID.seccomp"
        install -m 0400 -- "$SECCOMP_FILE" "$SECCOMP_COPY"
    fi
    jq -n --indent 4 --arg id "$SESSION_ID" --arg cwd "$PWD" --argjson pid "$$" \
        --argjson fs "$(sbx_resolve_strings "${FS_PROFILES[@]}" "${LAST_PROFILES[@]}")" \
        --argjson net "$(sbx_resolve_strings "${NET_PROFILES[@]}")" \
        '{id: $id, cwd: $cwd, pid: $pid, fs_profiles: $fs, net_profiles: $net}' \
        > "$SESSION_DIR/session.json"

    jq -n --indent 4 --arg path "$SESSION_DIR/bin:$SANDBOX_PATH" --arg workdir "${WORKDIR:-$PWD}" \
        --argjson caps_keep "$CAPS_KEEP" \
        --argjson forked_stores "$(sbx_resolve_strings "${FORKED_STORES[@]}")" \
        '{path: $path, workdir: $workdir, caps_keep: $caps_keep, forked_stores: $forked_stores}' \
        > "$STATE_DIR/join/$SESSION_ID.json"
}

# An xpra virtual display, bound into the sandbox with its own cookie.
setup_gui() {
    local display_num=100 xpra_log x11_sock ready=false host_xauth sbx_xauth
    # --gui or any profile's "gui": true; one display however many asked.
    if [[ "$GUI" != "true" ]]; then
        return 0
    fi
    while [[ -S "/tmp/.X11-unix/X$display_num" ]]; do
        display_num=$((display_num + 1))
    done
    XPRA_DISPLAY=":$display_num"
    xpra_log="$SESSION_DIR/xpra.log"

    echo "Starting xpra on display $XPRA_DISPLAY..."
    xpra start "$XPRA_DISPLAY" \
        --daemon=yes \
        --log-file="$xpra_log" \
        --mdns=no \
        --clipboard=no \
        --notifications=no \
        --bell=no \
        --speaker=disabled \
        --microphone=disabled \
        > /dev/null 2>&1

    x11_sock="/tmp/.X11-unix/X$display_num"
    echo -n "Waiting for display"
    for _ in {1..40}; do
        if [[ -S "$x11_sock" ]]; then
            ready=true
            break
        fi
        sleep 0.25
        echo -n "."
    done
    echo
    if [[ "$ready" != "true" ]]; then
        echo "Error: xpra display $XPRA_DISPLAY failed to start. Check $xpra_log" >&2
        xpra stop "$XPRA_DISPLAY" >/dev/null 2>&1 || true
        exit 1
    fi

    # xpra keys its cookie to the host's hostname, which the sandbox does
    # not share; FamilyWild (ffff) matches from any hostname. The cookie may
    # lag the socket slightly.
    host_xauth="${XAUTHORITY:-$HOME/.Xauthority}"
    sbx_xauth="$SESSION_DIR/Xauthority"
    rm -f "$sbx_xauth"
    for _ in {1..20}; do
        if xauth -f "$host_xauth" nlist "$XPRA_DISPLAY" 2>/dev/null | grep -q .; then
            break
        fi
        sleep 0.25
    done
    if ! xauth -f "$host_xauth" nlist "$XPRA_DISPLAY" 2>/dev/null \
        | sed -e 's/^..../ffff/' \
        | xauth -f "$sbx_xauth" nmerge - 2>/dev/null; then
        echo "Warning: could not build X11 auth cookie; GUI apps may fail with auth errors." >&2
    fi

    BWRAP_ARGS+=(--dir /tmp/.X11-unix)
    BWRAP_ARGS+=(--bind "$x11_sock" "/tmp/.X11-unix/X$display_num")
    BWRAP_ARGS+=(--setenv DISPLAY "$XPRA_DISPLAY")
    if [[ -f "$sbx_xauth" ]]; then
        BWRAP_ARGS+=(--ro-bind "$sbx_xauth" /tmp/.sbx-Xauthority)
        BWRAP_ARGS+=(--setenv XAUTHORITY /tmp/.sbx-Xauthority)
    fi
    # IPC is unshared, so MIT-SHM cannot work.
    BWRAP_ARGS+=(--setenv LIBGL_ALWAYS_INDIRECT 1)

    echo "GUI display $XPRA_DISPLAY is ready."
    echo "  Attach viewer : xpra attach $XPRA_DISPLAY"
    echo "  Stop display  : xpra stop $XPRA_DISPLAY"
}

# Last, because bwrap applies mounts in order and a profile mounting $HOME
# would otherwise re-expose these: the sandbox sees its own session
# directory and nothing else of sbx's state or config.
add_masks() {
    BWRAP_ARGS+=(--tmpfs "$STATE_DIR")
    BWRAP_ARGS+=(--bind "$SESSION_DIR" "$SESSION_DIR")
    BWRAP_ARGS+=(--tmpfs "$CONFIG_DIR")
}

# The EXIT trap of a launch: archive record-mount changes, then remove the
# session.
teardown() {
    # First: $? here is the launch's own status (bwrap's), which is how a
    # caller tells "never came up" from "ran". The payload's does not
    # reach it.
    local exit_status=$?
    local join_lock arch_dir rm_ r_src r_dest r_id r_work r_base r_cur rel

    # A seed interrupted mid-progress leaves a partial line on the terminal.
    if [[ -t 2 ]]; then
        printf '\r\033[K' >&2
    fi
    echo "Tearing down session $SESSION_ID..."

    # A join holds this lock shared for its whole life. It matters when
    # teardown runs as the EXIT trap of a signal (Ctrl-C, a CI timeout)
    # while the sandbox is still up; when the sandbox ends itself, its pid
    # namespace goes with it and no join is left to write (tests/join.bats,
    # "writeback waits on the host lock..."). Host-side, invisible to the
    # sandbox, and bounded so a stale lock cannot hang teardown.
    join_lock="$STATE_DIR/join/$SESSION_ID.lock"
    if exec 9>>"$join_lock"; then
        if ! flock -w 30 -x 9; then
            echo "Warning: a --join still holds the session lock after 30s; archiving record-mount changes anyway." >&2
        fi
    fi

    if [[ ${#RECORD_MOUNTS[@]} -gt 0 ]]; then
        arch_dir="$STATE_DIR/changes/$(sbx_copy_path_slug "$PWD")/$(date +%Y%m%d-%H%M%S)-$SESSION_ID"
        for rm_ in "${RECORD_MOUNTS[@]}"; do
            IFS=$'\t' read -r r_src r_dest <<< "$rm_"
            r_id=$(sbx_copy_mount_id "$r_dest")
            r_work="$RECORD_WORK_DIR/$r_id"
            r_base="$RECORD_WORK_DIR/$r_id.manifest"
            [[ -d "$r_work" ]] || continue

            r_cur="$RECORD_WORK_DIR/$r_id.manifest.now"
            sbx_manifest_build "$r_work" "$r_cur"

            mkdir -p "$arch_dir/$r_id"
            while IFS= read -r rel; do
                [[ -z "$rel" ]] && continue
                mkdir -p "$arch_dir/$r_id/$(dirname "$rel")"
                cp -a "$r_work/$rel" "$arch_dir/$r_id/$rel"
            done < <(sbx_manifest_changed "$r_base" "$r_cur")

            sbx_manifest_deleted "$r_base" "$r_cur" > "$arch_dir/$r_id.deleted"
            echo "Changes from this session: $arch_dir/$r_id"
        done
        sbx_prune_changes "$STATE_DIR/changes/$(sbx_copy_path_slug "$PWD")" "$(sbx_keep_changes)"
    fi
    rm -rf "$RECORD_WORK_DIR"

    sbx_session_remove "$STATE_DIR" "$SESSION_ID"

    if [[ -n "$XPRA_DISPLAY" ]]; then
        echo "Stopping xpra display $XPRA_DISPLAY..."
        xpra stop "$XPRA_DISPLAY" >/dev/null 2>&1 || true
    fi

    if [[ "$exit_status" -ne 0 ]]; then
        echo "Session $SESSION_ID ended with status $exit_status; the payload may never have run." >&2
    else
        echo "Session $SESSION_ID finished."
    fi
}

# The scripts that run the session are fixed files in lib/: launch.sh runs
# in the control namespace A; session.sh and wrapper.sh run inside the
# sandbox, so they are copied into the session directory, the one host path
# every sandbox has. What differs per session is written beside them.
write_session_files() {
    # The -f that loads this keeps the server off a mounted ~/.tmux.conf.
    #   update-environment  SECURITY: by default a client's DISPLAY,
    #                  SSH_AUTH_SOCK and friends reach new sessions, straight
    #                  through --clearenv. (PATH is copied regardless, which
    #                  is why --join re-imposes it.)
    #   exit-empty     the server exits with its last session, which is what
    #                  lets session.sh stop waiting.
    #   prefix C-\     a host tmux keeps C-b.
    #   window-size    per-client, so one join cannot resize another.
    cat > "$SESSION_DIR/tmux.conf" <<EOF
set -g update-environment ''
set -g exit-empty on
set -g escape-time 0
set -g window-size latest
unbind C-b
set -g prefix C-\\\\
bind C-\\\\ send-prefix
set -g status on
set -g status-left ' sbx:$SESSION_ID '
set -g status-left-length 40
EOF

    install -m 0755 "$SCRIPT_DIR/lib/session.sh" "$SESSION_DIR/session.sh"
    install -m 0755 "$SCRIPT_DIR/lib/wrapper.sh" "$SESSION_DIR/wrapper.sh"
    printf '%s\0' "${COMMAND[@]}" > "$SESSION_DIR/command"
    printf '%s\0' "${BWRAP_ARGS[@]}" > "$SESSION_DIR/bwrap.args"
    declare -p CAPS_KEEP USERNS_FULL DOCKER_API PODMAN_SOCK VIRT_DIR > "$SESSION_DIR/wrapper.env"

    #   NET_MODE  none      no network namespace beyond B's loopback
    #             loopback  host ports only: A's ruleset, no resolver
    #             dns       a net profile: ruleset, dnsmasq, readiness probe
    NET_MODE=none
    DNSMASQ_BIN=""
    DNSMASQ_ARGS=()
    if [[ "$SBX_NETNS" == "true" ]]; then
        NET_MODE=loopback
        if [[ "$NET_ENABLED" == "true" ]]; then
            NET_MODE=dns
            DNSMASQ_BIN=$(command -v dnsmasq)
            mapfile -t DNSMASQ_ARGS < <(sbx_egress_dnsmasq_args "$(plan_get '.net')")
        fi
    fi
    declare -p NET_MODE CAPS_KEEP NEST_TCP NEST_UDP SBX_DNS_ADDR DNSMASQ_BIN DNSMASQ_ARGS \
        TEST_DOMAIN RESOLV_DEST SECCOMP_COPY > "$SESSION_DIR/launch.env"
}

port_list() {   # <port>...: comma-joined, or "none"
    local joined
    if [[ $# -eq 0 ]]; then
        echo none
    else
        joined=$(printf '%s,' "$@")
        echo "${joined%,}"
    fi
}

run_session() {
    local tcp udp desc
    local -a launch pasta
    tcp=$(port_list "${HOST_PORTS_TCP[@]}")
    udp=$(port_list "${HOST_PORTS_UDP[@]}")

    # "/bin/bash <script>", not the script: Ubuntu's AppArmor profile for
    # pasta allows exec only under /bin and /usr/bin, and Ux there still
    # runs the script unconfined (Ubuntu 26.04, 2026-09-23).
    launch=(/bin/bash "$SCRIPT_DIR/lib/launch.sh" "$SESSION_DIR/launch.env")

    # setpriv --pdeathsig KILL on every shape: launch.sh outlives bwrap, so
    # the process between sbx and bwrap needs its own parent-death signal.
    # Under pasta, which forks its child, a SIGKILLed sbx still orphans
    # launch.sh — networkless once pasta is gone, and --gc judges the
    # session by sbx's pid.
    if [[ "$SBX_NETNS" != "true" ]]; then
        echo "Starting session $SESSION_ID..."
        # A: this user as 0 in a new user namespace, with an empty network.
        setpriv --pdeathsig KILL -- unshare --user --map-root-user --net -- "${launch[@]}"
        return
    fi

    # -T / -U are the whole host-access allow-list: pasta binds exactly
    # these ports and splices them to the host's loopback; "none" replaces
    # its default of forwarding every bound host port, and separate lists
    # stop a TCP grant from carrying its UDP twin. --no-map-gw: otherwise
    # the gateway address reaches every host-local service.
    pasta=(pasta -f --config-net --no-map-gw -T "$tcp" -U "$udp"
           --interface "$HOST_IFACE" --no-ndp --no-dhcpv6 --no-ra
           -a "$HOST_IP" -g "$HOST_GW" -n "$HOST_MASK")
    if [[ "$USERNS_FULL" == "true" ]]; then
        echo "Starting session $SESSION_ID with networking (full userns)..."
        # unshare claims the subordinate range through the setuid newuidmap;
        # pasta must not make a user namespace of its own (--netns-only).
        setpriv --pdeathsig KILL -- unshare --map-auto --map-root-user -- \
            "${pasta[@]}" --netns-only -- "${launch[@]}"
        return
    fi
    if [[ "$NET_ENABLED" == "true" ]]; then
        echo "Starting session $SESSION_ID with networking..."
    else
        desc=""
        if [[ "$tcp" != "none" ]]; then
            desc="tcp $tcp"
        fi
        if [[ "$udp" != "none" ]]; then
            desc+="${desc:+, }udp $udp"
        fi
        echo "Starting session $SESSION_ID with host ports $desc (no internet)..."
    fi
    setpriv --pdeathsig KILL -- "${pasta[@]}" -- "${launch[@]}"
}

main() {
    parse_args "$@"
    if [[ -z "$WORKDIR" ]]; then
        WORKDIR="$WS_WORKDIR"
    fi

    if [[ "$RESEED" == "true" && "$DRY_RUN" == "true" ]]; then
        echo "Error: --dry-run applies only to a launch; it cannot be combined with --reseed." >&2
        exit 2
    fi
    if [[ "$DRY_RUN" != "true" ]]; then
        sbx_state_init
    fi
    if [[ ${#COMMAND[@]} -eq 0 ]]; then
        COMMAND=(/bin/bash)
    fi

    preflight_core
    resolve_plan
    if [[ "$DRY_RUN" == "true" ]]; then
        dry_run_report
    fi
    check_plan
    if [[ "$RESEED" == "true" ]]; then
        reseed
    fi
    read_plan_settings
    preflight_session

    claim_session
    build_base_args
    setup_virt
    add_profile_mounts
    seed_forked_mounts
    seed_record_mounts
    add_env_and_path
    setup_network
    write_session_records
    setup_gui
    add_masks

    trap teardown EXIT
    write_session_files
    run_session
}

main "$@"
