#!/bin/bash

# sbx - Portable Unprivileged Sandbox Orchestrator

set -e

STATE_DIR="$HOME/.local/state/sbx"
CONFIG_DIR="$HOME/.config/sbx"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# shellcheck source=lib/copy-mounts.sh
source "$SCRIPT_DIR/lib/copy-mounts.sh"
# shellcheck source=lib/state-paths.sh
source "$SCRIPT_DIR/lib/state-paths.sh"
# shellcheck source=lib/render.sh
source "$SCRIPT_DIR/lib/render.sh"
# shellcheck source=lib/deps.sh
source "$SCRIPT_DIR/lib/deps.sh"
# shellcheck source=lib/profiles.sh
source "$SCRIPT_DIR/lib/profiles.sh"
# shellcheck source=lib/profile-check.sh
source "$SCRIPT_DIR/lib/profile-check.sh"
# shellcheck source=lib/net-merge.sh
source "$SCRIPT_DIR/lib/net-merge.sh"
# shellcheck source=lib/resolve.sh
source "$SCRIPT_DIR/lib/resolve.sh"
# shellcheck source=lib/sessions.sh
source "$SCRIPT_DIR/lib/sessions.sh"
# A's extra chains and the A/B addresses (nested payload networking).
# shellcheck source=lib/nestnet.sh
source "$SCRIPT_DIR/lib/nestnet.sh"
# shellcheck source=lib/egress.sh
source "$SCRIPT_DIR/lib/egress.sh"

GUI_MODE=false
XPRA_DISPLAY=""

# Serializes every observation of the two-step session claim (see the claim
# loop below for what the two steps are and why the gap between them must
# never be seen). Defined here rather than beside the claim loop because
# --gc, which runs during argument parsing, has to take the same lock: it is
# exactly the observer the claim loop is protecting against.
#
# It lives directly under $STATE_DIR rather than in join/ because session
# names may begin with "." — a session named ".claim" would collide with
# join/.claim.lock. It is covered by the same --tmpfs mask as join/, and
# --list-sessions ignores it because that requires a directory.
CLAIM_LOCK="$STATE_DIR/claim.lock"

# Creates the state directory. Every path runs this before touching state —
# except --dry-run, which must create nothing.
sbx_state_init() {
    mkdir -p "$STATE_DIR"
}

# --dry-run applies only to a launch. Each command that acts on state calls
# this with its own remaining arguments, so the combination is refused in
# either order: "--dry-run --gc" is caught through DRY_RUN, "--gc --dry-run"
# through the scan (which stops at --, where the payload's arguments begin).
sbx_refuse_dry_run() {   # <this command> <remaining args...>
    local cmd="$1" arg
    shift
    if [[ "$DRY_RUN" != "true" ]]; then
        for arg in "$@"; do
            if [[ "$arg" == "--" ]]; then
                break
            fi
            if [[ "$arg" == "--dry-run" ]]; then
                DRY_RUN=true
                break
            fi
        done
    fi
    if [[ "$DRY_RUN" == "true" ]]; then
        echo "Error: --dry-run applies only to a launch; it cannot be combined with $cmd." >&2
        exit 2
    fi
}

usage() {
    cat <<EOF
Usage: $(basename "$0") [options] [command]

Options:
  --list-profiles        Show available profiles
                         (sbx-profile ls / check / new manage profile files)
  --list-sessions        Show active sessions
  --doctor [--json]      Check dependencies and host setup, with install commands
  --changes [<id>]       Show what a record mount changed (default: latest)
  --join <session>       Open a new shell inside a running session
                         (--join <session> -- <cmd> runs <cmd> instead)
  --attach <session>     Reattach to a session's original terminal
  --fs <profile>         Apply a filesystem profile (multiple allowed)
  --net <profile>        Apply a network profile (multiple allowed)
  --cli <profile>        Apply a CLI/environment profile
  --host-port <spec>     Reach a host service on 127.0.0.1:<port> from inside.
                         <spec> is <port>[/tcp|/udp]; bare means tcp.
                         (repeatable; implies a network namespace)
  --wd <path>            Start in this directory inside the sandbox
                         (default: launch dir if present, else \$HOME, else /)
  --gui                  Enable isolated GUI via xpra (attach with: xpra attach :<N>)
  --dry-run [--json]     Show what this launch would do, without doing it
                         (exits 1 if the launch would stop)
  --reseed               Discard this directory's forked stores, so the next
                         launch re-seeds them from the host (asks first)
  --gc                   Remove crash residue and old change archives
  --yes                  Do not prompt for confirmation
  -h, --help             Show this help message

Profiles are searched in:
  1. ./.sbx/profiles/
  2. \$HOME/.config/sbx/profiles/
  3. $SCRIPT_DIR/profiles/
EOF
}

resolve_profile() {   # <type> <name>
    sbx_profile_resolve "$1" "$2" "$CONFIG_DIR" "$SCRIPT_DIR/profiles"
}

list_profiles() {
    sbx_profile_list "$CONFIG_DIR" "$SCRIPT_DIR/profiles"
}

# Main Argument Parsing
FS_PROFILES=()
NET_PROFILES=()
CLI_PROFILE=""
WORKDIR=""
HOST_PORT_SPECS=()   # as typed; lib/resolve.sh validates and buckets them
COMMAND=()

GUI_FLAG=false
DRY_RUN=false
DRY_RUN_JSON=false
CAPS_KEEP=false
RESEED=false
ASSUME_YES=false

while [[ $# -gt 0 ]]; do
    case "$1" in
        --doctor)
            sbx_refuse_dry_run --doctor "${@:2}"
            sbx_state_init
            if [[ -n "${2:-}" && "${2:-}" != "--json" ]]; then
                echo "Error: --doctor takes only --json." >&2
                exit 2
            fi
            doctor_rc=0
            sbx_deps_doctor "${2:-}" || doctor_rc=$?
            exit "$doctor_rc"
            ;;
        --list-profiles)
            sbx_refuse_dry_run --list-profiles "${@:2}"
            sbx_state_init
            list_profiles
            exit 0
            ;;
        --gc)
            sbx_refuse_dry_run --gc "${@:2}"
            sbx_state_init
            # Both sweeps below judge a session dead by the absence of a
            # liveness record, which is exactly the intermediate state the
            # claim loop hides behind this lock: between its mkdir and its
            # pid write, a LIVE session looks like crash residue. Held
            # across both sweeps rather than per entry — the per-entry work
            # is a stat, a kill -0 and an rm -rf, and the claim loop already
            # rm -rf's residue under this same lock, so the worst stall a
            # launch can see here is the one the design already accepts.
            #
            # fd 8 is free: the claim loop uses 8 and teardown's join lock
            # uses 9, and --gc exits before either runs.
            #
            # Warn and continue on failure, on both the open and the acquire
            # path, exactly as the claim loop does: refusing to collect
            # anything on a filesystem without working flock would be worse
            # than collecting it unlocked, but a lock whose failure is
            # invisible is not a lock.
            if exec 8>>"$CLAIM_LOCK"; then
                flock -x 8 || echo "Warning: could not lock $CLAIM_LOCK; a concurrent launch's session may be collected mid-claim." >&2
            else
                echo "Warning: could not open $CLAIM_LOCK; a concurrent launch's session may be collected mid-claim." >&2
            fi

            for sdir in "$STATE_DIR"/sessions/*; do
                [[ -d "$sdir" ]] || continue
                sname=$(basename "$sdir")
                sbx_session_alive "$STATE_DIR" "$sname" && continue
                echo "Removing crash residue: $sname"
                sbx_session_remove "$STATE_DIR" "$sname"
            done

            # Sidecars whose session directory does not exist at all — a
            # crash between the claim mkdir and session start, or leftovers
            # from an interrupted GC — can never belong to a live session,
            # since a live session always has its directory. This glob is
            # confined to join/, so it can never reach claim.lock, which
            # lives directly under $STATE_DIR.
            for sc in "$STATE_DIR"/join/*; do
                [[ -f "$sc" ]] || continue
                scbase=$(basename "$sc")
                scname="${scbase%.pid}"
                scname="${scname%.json}"
                scname="${scname%.lock}"
                [[ -d "$STATE_DIR/sessions/$scname" ]] && continue
                rm -f "${sc:?}"
            done

            # Record-mount working copies. Only teardown removed these, so a
            # session killed by SIGKILL, OOM or power loss strands one — and
            # a stranded tree is not merely wasted space: the next session of
            # the same name seeds INTO it (cp -a merges) and folds its ghost
            # files into the baseline. Launches clear their own work tree
            # before seeding, which fixes the corruption going forward; this
            # sweep is what reclaims what is already on disk. Same liveness
            # rule and same lock as the sweeps above — a live session's work
            # tree is bound into a running sandbox.
            for wdir in "$STATE_DIR"/work/*; do
                [[ -d "$wdir" ]] || continue
                wname=$(basename "$wdir")
                sbx_session_alive "$STATE_DIR" "$wname" && continue
                echo "Removing stranded work tree: $wname"
                rm -rf "${wdir:?}"
            done

            exec 8>&-

            keep=$(sbx_keep_changes)
            for cdir in "$STATE_DIR"/changes/*; do
                [[ -d "$cdir" ]] || continue
                sbx_prune_changes "$cdir" "$keep"
            done

            # Never removed automatically: a forked store is the user's
            # accumulated tool state, and deleting it on a heuristic is not
            # recoverable. Reported so the space is at least visible; use
            # --reseed to actually discard one.
            # The header is worth nothing without rows under it: forked/
            # exists as soon as any store ever has, including after the last
            # one is reseeded away, so "-d forked" alone announces a list
            # that is empty. Collect first, print only if there is something
            # to print.
            forked_report=$(du -sh "$STATE_DIR"/forked/*/*/* 2>/dev/null | sed 's/^/  /')
            if [[ -n "$forked_report" ]]; then
                echo "Forked stores (not removed; use --reseed):"
                echo "$forked_report"
            fi

            exit 0
            ;;
        --reseed)
            RESEED=true
            shift
            ;;
        --yes)
            ASSUME_YES=true
            shift
            ;;
        --list-sessions)
            sbx_refuse_dry_run --list-sessions "${@:2}"
            sbx_state_init
            echo "Active Sessions (this directory):"
            for sdir in "$STATE_DIR"/sessions/*; do
                [[ -d "$sdir" && -f "$sdir/session.json" ]] || continue
                # session.json lives inside a directory bound rw into the
                # sandbox — every field is attacker-authored. Strip control
                # characters before echoing them to a terminal.
                scwd=$(jq -r '.cwd' "$sdir/session.json" 2>/dev/null | tr -d '\000-\037')
                [[ "$scwd" == "$PWD" ]] || continue
                sid=$(jq -r '.id' "$sdir/session.json" 2>/dev/null | tr -d '\000-\037')
                # Only display fields come from session.json; liveness does
                # not (see lib/sessions.sh).
                if pid=$(sbx_session_live_pid "$STATE_DIR" "$(basename "$sdir")"); then
                    echo "  $sid (PID: $pid)"
                fi
            done
            exit 0
            ;;
        --changes)
            sbx_refuse_dry_run --changes "${@:2}"
            sbx_state_init
            CHANGES_DIR="$STATE_DIR/changes/$(sbx_copy_path_slug "$PWD")"
            if [[ -n "${2-}" && "$2" != -* ]]; then
                target="$CHANGES_DIR/$2"; shift 2
            else
                target=$(find "$CHANGES_DIR" -mindepth 1 -maxdepth 1 -type d 2>/dev/null |
                         LC_ALL=C sort | tail -n1)
                shift
            fi
            if [[ -z "$target" || ! -d "$target" ]]; then
                echo "No recorded changes for this directory." >&2
                exit 1
            fi
            echo "$target"
            # Paths are attacker-authored (a record mount's contents come
            # from inside the sandbox), so strip control characters before
            # echoing them to a terminal — same reasoning as --list-sessions.
            find "$target" -mindepth 2 -type f -printf '  + %P\n' | tr -d '\000-\037'
            for d in "$target"/*.deleted; do
                [[ -f "$d" ]] || continue
                sed 's/^/  - /' "$d" | tr -d '\000-\037'
            done
            exit 0
            ;;
        --join)
            sbx_refuse_dry_run --join "${@:2}"
            sbx_state_init
            JOIN_SESSION="$2"
            shift 2
            # A trailing `-- cmd` has to be consumed here: this branch exits
            # before the main loop ever reaches the `--` case.
            JOIN_CMD=()
            if [[ "${1-}" == "--" ]]; then
                shift
                JOIN_CMD=("$@")
            fi
            if ! sbx_session_name_valid "$JOIN_SESSION"; then
                echo "Error: Invalid session name '$JOIN_SESSION'." >&2
                exit 1
            fi
            SDIR="$STATE_DIR/sessions/$JOIN_SESSION"
            # -S, not -f: the server's rendezvous point is a unix socket,
            # which is never a regular file.
            if [[ ! -d "$SDIR" || ! -S "$SDIR/tmux.sock" ]]; then
                echo "Error: Session '$JOIN_SESSION' not found or no socket available." >&2
                exit 1
            fi
            # Inline check, not sbx_deps_require: --join needs only tmux,
            # and the preflight runs later, after argument parsing.
            if ! command -v tmux >/dev/null 2>&1; then
                echo "Error: sbx requires tmux, which is not on PATH." >&2
                exit 1
            fi
            # No command means an interactive shell, matching the default
            # sbx runs when launched with no command at all.
            if [[ ${#JOIN_CMD[@]} -eq 0 ]]; then
                JOIN_CMD=("/bin/bash")
            fi
            # Everything --join needs to know about the session comes from
            # this sidecar. It deliberately does NOT live in $SESSION_DIR:
            # that directory is bound rw into the sandbox, so session.json
            # and any generated script in it are attacker-authored as far as
            # the host is concerned. $STATE_DIR itself is masked by a
            # --tmpfs inside the sandbox with only $SESSION_DIR bound back
            # in, so a file at this path is unreachable from inside.
            # Absent means the session was not launched by this sbx: fail
            # closed rather than guess at its capability policy.
            JOIN_META="$STATE_DIR/join/$JOIN_SESSION.json"
            if [[ ! -f "$JOIN_META" ]]; then
                echo "Error: Session '$JOIN_SESSION' has no join metadata; it was not started by this version of sbx." >&2
                exit 1
            fi
            JOIN_PATH=$(jq -r '.path' "$JOIN_META")
            JOIN_WD=$(jq -r '.workdir' "$JOIN_META")
            # Held for the whole life of the join, and released by the kernel
            # when this process finally exits. teardown() takes the same lock
            # exclusively before archiving record-mount changes, and that
            # pairing is what protects a teardown that runs while the
            # sandbox is still fully alive: teardown() is an EXIT trap, and
            # a SIGTERM to sbx (Ctrl-C on the launching terminal, a CI
            # timeout) fires it before bwrap has any reason to exit, so the
            # payload, the tmux server and this join can all still be
            # writing when the archive would otherwise start. The
            # in-sandbox PID-1 waiter (see session.sh's tmux conf and the
            # comment above the session script) is not in that exit path at
            # all — it only runs teardown once bwrap itself has already
            # returned — so it cannot cover for this lock; see
            # tests/join.bats "writeback waits on the host lock when
            # teardown is not gated by the sandbox". The fd survives the
            # exec below on purpose.
            JOIN_LOCK="$STATE_DIR/join/$JOIN_SESSION.lock"
            if exec 9>>"$JOIN_LOCK"; then
                flock -s 9 || echo "Warning: could not lock $JOIN_LOCK; teardown may not wait for this join." >&2
            fi
            # new-session, NOT attach: a second client on the SAME session
            # would mirror the payload's terminal, which is exactly the
            # behaviour this flag exists to stop doing. A new session in the
            # same server is an independent client with its own pty and its
            # own size, and the server forks it.
            #
            # No capability drop here, and no on-disk wrapper to hold one:
            # the drop happens once, at the top, where launch.sh starts
            # session.sh under setpriv (see the comment there). The tmux
            # server is therefore already capless and everything it forks —
            # this join, and equally new-window/split-window/run-shell —
            # inherits an empty bounding set by construction. Re-applying
            # setpriv here would in fact fail with EPERM, since emptying a
            # bounding set needs the CAP_SETPCAP that is already gone.
            #
            # env PATH: tmux copies the *client's* PATH into a spawned pane
            # regardless of `update-environment ''`, so the host's PATH would
            # otherwise reach every join. /usr/bin/env by absolute path for
            # the same reason — it must not be resolved through that PATH.
            # -c: without it tmux uses the host client's cwd, so a join would
            # ignore the session's --wd. A directory that does not exist
            # inside the sandbox makes tmux fall back to $HOME, which is the
            # same default the payload gets.
            exec tmux -S "$SDIR/tmux.sock" new-session -c "$JOIN_WD" -- \
                /usr/bin/env "PATH=$JOIN_PATH" "${JOIN_CMD[@]}"
            ;;
        --attach)
            sbx_refuse_dry_run --attach "${@:2}"
            sbx_state_init
            ATTACH_SESSION="$2"
            shift 2
            if ! sbx_session_name_valid "$ATTACH_SESSION"; then
                echo "Error: Invalid session name '$ATTACH_SESSION'." >&2
                exit 1
            fi
            SDIR="$STATE_DIR/sessions/$ATTACH_SESSION"
            if [[ ! -d "$SDIR" || ! -S "$SDIR/tmux.sock" ]]; then
                echo "Error: Session '$ATTACH_SESSION' not found or no socket available." >&2
                exit 1
            fi
            if ! command -v tmux >/dev/null 2>&1; then
                echo "Error: sbx requires tmux, which is not on PATH." >&2
                exit 1
            fi
            # This one really is mirroring, deliberately and by name: it is
            # the way back to a payload you detached from. --join is the
            # non-mirroring door; without this, detaching the main session
            # would lock you out of a still-running payload for good.
            exec tmux -S "$SDIR/tmux.sock" attach -t main
            ;;
        --fs)
            FS_PROFILES+=("$(resolve_profile fs "$2")")
            shift 2
            ;;
        --net)
            NET_PROFILES+=("$(resolve_profile net "$2")")
            shift 2
            ;;
        --cli)
            CLI_PROFILE="$(resolve_profile cli "$2")"
            shift 2
            ;;
        --host-port)
            HOST_PORT_SPECS+=("$2")
            shift 2
            ;;
        --wd)
            # envsubst for parity with every other path sbx accepts
            # (mounts, env, path), so '$HOME/src' works whether it reaches
            # us quoted from a script or expanded by the caller's shell.
            WORKDIR="$(echo "$2" | envsubst)"
            shift 2
            ;;
        --)
            shift
            COMMAND=("$@")
            break
            ;;
        --gui)
            GUI_FLAG=true
            shift
            ;;
        --dry-run)
            DRY_RUN=true
            shift
            if [[ "${1:-}" == "--json" ]]; then
                DRY_RUN_JSON=true
                shift
            fi
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        --*)
            echo "Error: unknown option '$1'. Put the command after -- if it starts with a dash: sbx [options] -- <command>" >&2
            exit 2
            ;;
        *)
            if [[ ${#COMMAND[@]} -eq 0 ]]; then
                COMMAND=("$@")
                break
            else
                break
            fi
            ;;
    esac
done

if [[ "$RESEED" == "true" && "$DRY_RUN" == "true" ]]; then
    echo "Error: --dry-run applies only to a launch; it cannot be combined with --reseed." >&2
    exit 2
fi
if [[ "$DRY_RUN" != "true" ]]; then
    sbx_state_init
fi

if [[ ${#COMMAND[@]} -eq 0 ]]; then
    COMMAND=("/bin/bash")
fi

# Prompts for a profile that lib/resolve.sh has already decided needs
# confirmation (plan.confirm: project origin, git-tracked, trust not
# granted — see the comment by "confirm+=" in lib/resolve.sh). This
# function only performs the prompt; it does not recompute the trust
# decision, so it and the plan it is driven from can never disagree about
# which profiles land here (that used to be two independent
# implementations — see the "trust decision is computed twice" finding).
#
# A version-controlled project directory is untrusted input: it can ship
# .sbx/profiles that mount anything anywhere, authored by whoever wrote the
# repository. Using one is a decision the user makes explicitly, outside the
# repository.
prompt_project_profile() {
    local profile="$1"
    local remote="" rname=""
    rname=$(git -C "$PWD" remote 2>/dev/null | head -n1)
    if [[ -n "$rname" ]]; then
        remote=$(git -C "$PWD" remote get-url "$rname" 2>/dev/null || true)
    fi

    {
        echo ""
        echo "This launch would use a profile tracked by the project's git repository:"
        echo "  $profile"
        if [[ -n "$remote" ]]; then
            echo ""
            echo "  The repo has remote $remote — this profile was authored by"
            echo "  whoever wrote that repository, not by you."
        fi
        echo ""
        sed 's/^/  | /' "$profile"
        echo ""
    } >&2

    if [[ ! -t 0 ]]; then
        echo "Error: refusing to use a project profile non-interactively." >&2
        echo "  Set SBX_TRUST_PROJECT_PROFILES=1 to allow it." >&2
        exit 1
    fi

    local answer=""
    printf "Use this project profile? [y/N] " >&2
    read -r answer < /dev/tty
    if [[ "$answer" != "y" && "$answer" != "Y" ]]; then
        echo "Aborted." >&2
        exit 1
    fi
}

# --- Dependency preflight: core ---
# Everything below this point may exec a core tool — the confirmation uses
# realpath and the feature scan uses jq — so the core group is checked
# first, along with whether bwrap can create a user namespace at all.
# bwrap used to be discovered only when launch.sh tried to exec it, which
# reported nothing but "bwrap: not found" after a session directory, an
# xpra display and a pasta namespace had already been built.
if [[ "$DRY_RUN" == "true" ]]; then
    # Resolving needs only jq, realpath and envsubst to exist at all — those
    # are the tools this script itself calls between here and the report.
    # A missing bwrap, tmux or other core tool is not a reason to stop
    # before the report: it belongs in the report's Needs, as a reason
    # .proceed is false, same as a missing net/gui/podman tool.
    DRY_RUN_CORE_MISSING=()
    for dry_tool in jq realpath envsubst; do
        command -v "$dry_tool" >/dev/null 2>&1 || DRY_RUN_CORE_MISSING+=("$dry_tool")
    done
    if [[ ${#DRY_RUN_CORE_MISSING[@]} -gt 0 ]]; then
        sbx_deps_report_missing "${DRY_RUN_CORE_MISSING[@]}" >&2
        exit 1
    fi
else
    sbx_deps_require core || exit 1
fi

# --- Resolve ---
# Every decision about profiles is made here, from the flags and the profile
# files, without touching the disk (see lib/resolve.sh). Everything after
# this point reads the plan, never a profile file.
RESOLVE_ARGS=(--launch-dir "$PWD" --config-dir "$CONFIG_DIR" --global-dir "$SCRIPT_DIR/profiles")
for profile in "${FS_PROFILES[@]}"; do
    RESOLVE_ARGS+=(--fs "$profile")
done
if [[ -n "$CLI_PROFILE" ]]; then
    RESOLVE_ARGS+=(--cli "$CLI_PROFILE")
fi
for profile in "${NET_PROFILES[@]}"; do
    RESOLVE_ARGS+=(--net "$profile")
done
for spec in "${HOST_PORT_SPECS[@]}"; do
    RESOLVE_ARGS+=(--host-port "$spec")
done
if [[ -n "$WORKDIR" ]]; then
    RESOLVE_ARGS+=(--wd "$WORKDIR")
fi
if [[ "$GUI_FLAG" == "true" ]]; then
    RESOLVE_ARGS+=(--gui)
fi
PLAN=$(sbx_resolve "${RESOLVE_ARGS[@]}")

plan_get() {
    jq -r "$1" <<< "$PLAN"
}

# The session name a launch of this directory would claim, and the widest
# tmux.sock path that name could still need (see sbx_state_socket_probe in
# lib/state-paths.sh). Computed here — before the "Dry run" branch below —
# because both the dry run's "stops" check and the real launch's own
# too-long-socket check (further down) read the same two values and must
# never disagree about them.
SESSION_BASE=$(sbx_state_session_base "$PWD")
SOCK_PROBE=$(sbx_state_socket_probe "$STATE_DIR" "$SESSION_BASE")

# --- Dry run ---
# Everything below this point acts: prompts, creates state, launches. A dry
# run stops here with the plan, the host locations it would write, and the
# dependency check in report-only form.
if [[ "$DRY_RUN" == "true" ]]; then
    mapfile -t DRY_DEPS_ARGS < <(plan_get '.checks[] | "--" + .')
    mapfile -t DRY_GROUPS < <(plan_get '.deps[]')
    DRY_NEEDS=$(sbx_deps_status "${DRY_DEPS_ARGS[@]}" "${DRY_GROUPS[@]}")
    DRY_WRITES=$(sbx_state_writes "$PLAN" "$STATE_DIR" "$PWD" "${XAUTHORITY:-$HOME/.Xauthority}")

    # Launch-time gates that are not profile errors: today, only the
    # session-socket-path length check the real launch does further down
    # (see SOCK_PROBE above). Kept separate from .errors because these are
    # not about the profiles at all — a stop here would follow no matter
    # which profiles were chosen.
    DRY_STOPS=()
    SOCK_PROBLEM=$(sbx_state_socket_problem "$SOCK_PROBE")
    if [[ -n "$SOCK_PROBLEM" ]]; then
        DRY_STOPS+=("$SOCK_PROBLEM")
    fi

    # Passthrough names that are actually set in this environment — never
    # their values (see the "passthrough values never appear" test).
    mapfile -t DRY_PASSTHROUGH < <(plan_get '.passthrough[]')
    DRY_PASSTHROUGH_SET=()
    for dry_var in "${DRY_PASSTHROUGH[@]}"; do
        if [[ -n "$dry_var" && -n "${!dry_var-}" ]]; then
            DRY_PASSTHROUGH_SET+=("$dry_var")
        fi
    done

    DRY_DOC=$(jq -c --argjson needs "$DRY_NEEDS" --argjson writes "$DRY_WRITES" \
        --argjson stops "$(sbx_resolve_strings "${DRY_STOPS[@]}")" \
        --argjson passthrough_set "$(sbx_resolve_strings "${DRY_PASSTHROUGH_SET[@]}")" \
        --arg session_name "$SESSION_BASE" --arg session_dir "$STATE_DIR/sessions/$SESSION_BASE/" \
        '. + {needs: $needs, writes: $writes, stops: $stops, passthrough_set: $passthrough_set,
              session: {name: $session_name, dir: $session_dir}}
             | .proceed = (((.errors | length) == 0) and .needs.ok and ((.stops | length) == 0))
             | .env |= map(del(.value))
             | del(.path)' \
        <<< "$PLAN")
    if [[ "$DRY_RUN_JSON" == "true" ]]; then
        jq -a . <<< "$DRY_DOC"
    else
        sbx_render_plan "$DRY_DOC" "$HOME"
    fi
    if [[ "$(jq -r '.proceed' <<< "$DRY_DOC")" == "true" ]]; then
        exit 0
    fi
    exit 1
fi

# Errors are never profile-authored trust decisions — they gate the whole
# launch — so they print and exit before anything else, including the
# confirmation prompt: a rejected profile must never prompt.
if [[ "$(plan_get '.errors | length')" != "0" ]]; then
    while IFS= read -r msg; do
        echo "Error: $msg" >&2
    done < <(plan_get '.errors[]')
    exit 1
fi

# Drive the confirmation loop from the plan's own list, not a
# reimplementation of the trust decision beside it (see prompt_project_profile).
# mapfile first, then a plain `for`: a `while read ... done < <(...)` loop
# would redirect fd 0 to the process substitution for the loop body,
# which is exactly the fd prompt_project_profile's `[[ ! -t 0 ]]` tests —
# a real interactive launch would misreport itself as non-interactive.
mapfile -t CONFIRM_PROFILES < <(plan_get '.confirm[]')
for profile in "${CONFIRM_PROFILES[@]}"; do
    [[ -n "$profile" ]] && prompt_project_profile "$profile"
done

# Warnings print only after the confirmation prompt above has run: before
# Phase 2, nothing was echoed before that prompt, and profile-authored
# warning text (see sbx_sanitize_message) must not be given the chance to
# repaint or crowd out the one prompt standing between a cloned repository
# and an arbitrary mount set.
while IFS= read -r msg; do
    if [[ -n "$msg" ]]; then
        echo "Warning: $(sbx_sanitize_message "$msg")" >&2
    fi
done < <(plan_get '.warnings[]')

# The plan's scalar settings in one read. @sh quotes every string, so the
# eval sees only assignments whatever a profile path contains.
eval "$(jq -r '@sh "USERNS_FULL=\(.security.userns_full) USERNS_PROFILE=\(.security.userns_profile)
    CAPS_KEEP=\(.security.caps_keep) CAPS_PROFILE=\(.security.caps_profile)
    DOCKER_API=\(.security.docker_api) SBX_NETNS=\(.netns) NET_ENABLED=\(.net.enabled)
    TEST_DOMAIN=\(.net.test_domain // "") SANDBOX_PATH=\(.path)
    NEED_SUBIDS=\(.checks | index("subids") != null)"' <<< "$PLAN")"
mapfile -t HOST_PORTS_TCP < <(plan_get '.host_ports.tcp[]')
mapfile -t HOST_PORTS_UDP < <(plan_get '.host_ports.udp[]')

# The payload runs in a user namespace B nested in the session's control
# namespace A (lib/userns.sh, lib/nestnet.sh): mounts made in A are locked
# in B, and A's ruleset is out of B's reach.
NEST_TCP=$(IFS=,; echo "${HOST_PORTS_TCP[*]}")
NEST_UDP=$(IFS=,; echo "${HOST_PORTS_UDP[*]}")

# --- Dependency preflight: optional groups ---
# "nsunshare" is not a tool group: it asks sbx_deps_require to prove that
# unshare may create a user + network namespace (see .checks in
# lib/resolve.sh for which sessions need it).
mapfile -t DEP_GROUPS < <(plan_get '(.deps[] | select(. != "core")), (.checks[] | select(. == "nsunshare"))')
if [[ ${#DEP_GROUPS[@]} -gt 0 ]]; then
    sbx_deps_require "${DEP_GROUPS[@]}" || exit 1
fi
if [[ "$NEED_SUBIDS" == "true" ]] && ! sbx_deps_subids_ok; then
    echo "Error: profile '$USERNS_PROFILE' sets \"userns\": \"full\", which needs a subordinate UID and GID range for $(id -un)." >&2
    echo "  Add one:  sudo usermod --add-subuids 100000-165535 --add-subgids 100000-165535 $(id -un)" >&2
    echo "  (choose a range not already used by another user in /etc/subuid)" >&2
    exit 1
fi

if [[ "$CAPS_KEEP" == "true" ]]; then
    echo "Note: profile '$(basename "$CAPS_PROFILE" .json)' retains capabilities inside the payload's own namespace." >&2
    echo "  ro mounts and the egress firewall are still enforced from outside it; the payload can" >&2
    echo "  create further namespaces and hide paths from itself." >&2
fi

# Session Initialization
#
# The socket check uses the widest name the claim loop can produce, before
# anything is claimed; --dry-run's "stops" entry reads the same values.
SOCK_PROBLEM=$(sbx_state_socket_problem "$SOCK_PROBE")
if [[ -n "$SOCK_PROBLEM" ]]; then
    echo "Error: $SOCK_PROBLEM" >&2
    exit 1
fi

mkdir -p "$STATE_DIR/sessions" "$STATE_DIR/join"

# Claiming a name is two steps that must look like one: mkdir takes the
# name, and the pid record proves the taker is alive. Everything between
# here and session.json — profile parsing, xpra setup, the whole copy-mount
# seeding, which on a large record tree is minutes — happens after the
# mkdir, so without serialization a competitor entering this loop in that
# window sees a directory with no liveness record, calls a LIVE session
# crash residue, and rm -rf's it. The lock is held across both steps so that
# intermediate state is never observable. $CLAIM_LOCK is defined at the top
# of the script because --gc has to take the same lock.
#
# Both branches below must warn, and warn with the same specific
# consequence, on failure. Failing to open the lock file is not a smaller
# problem than failing to acquire it: either way the loop below runs
# unlocked, silently reintroducing the exact race described above. A lock
# whose open failure is invisible is not a lock.
#
# We still proceed rather than exit in either case. The race requires two
# concurrent launches from the same directory, which is uncommon; refusing
# to launch at all would instead break every single-launch user on a
# filesystem whose flock is unsupported or whose state dir can't be opened
# for append — common, and far worse than a warning. Making the degraded
# state visible on stderr is the fix; declining to launch is not.
if exec 8>>"$CLAIM_LOCK"; then
    flock -x 8 || echo "Warning: could not lock $CLAIM_LOCK; a concurrent launch may race for this name." >&2
else
    echo "Warning: could not open $CLAIM_LOCK; a concurrent launch may race for this name." >&2
fi

SESSION_NAME="$SESSION_BASE"
session_n=1
while ! mkdir "$STATE_DIR/sessions/$SESSION_NAME" 2>/dev/null; do
    # A dead name is reclaimed with every sidecar, not only its directory:
    # a predecessor's join/<name>.json would otherwise describe this session
    # to a concurrent --reseed until ours is written.
    if ! sbx_session_alive "$STATE_DIR" "$SESSION_NAME"; then
        sbx_session_remove "$STATE_DIR" "$SESSION_NAME"
        continue
    fi
    session_n=$((session_n + 1))
    if [[ $session_n -gt 99 ]]; then
        echo "Error: too many live sessions named '$SESSION_BASE'." >&2
        exit 1
    fi
    SESSION_NAME="$SESSION_BASE-$session_n"
done

# Still under the lock: the claim is not complete until the name has a
# liveness record to go with it.
printf '%s\n' "$$" > "$STATE_DIR/join/$SESSION_NAME.pid"
exec 8>&-

SESSION_ID="$SESSION_NAME"   # retained: session.json's .id field
SESSION_DIR="$STATE_DIR/sessions/$SESSION_NAME"
SESSION_PID_FILE="$STATE_DIR/join/$SESSION_NAME.pid"
mkdir -p "$SESSION_DIR/tmp"

# Bwrap Arguments
BWRAP_ARGS=(
    --unshare-ipc
    --unshare-pid
    --unshare-uts
    --unshare-cgroup
    --new-session
    --proc /proc
    --dev /dev
    --tmpfs /tmp
    --tmpfs /run
    --ro-bind /usr /usr
    --ro-bind /opt /opt
    --ro-bind /etc /etc
    --symlink usr/bin /bin
    --symlink usr/lib /lib
    --symlink usr/lib64 /lib64
)

# Environment policy: clear everything, then reintroduce by name.
# --clearenv is unconditional and has no opt-out — the host environment
# routinely carries API keys, tokens and SSH_AUTH_SOCK, none of which a
# sandbox should see unless a profile asks for them by name.
BWRAP_ARGS+=(--clearenv)

# Base set: what a shell needs to behave like a shell.
SBX_BASE_ENV=(HOME USER LOGNAME TERM COLORTERM LANG TZ SHELL)
for var in "${SBX_BASE_ENV[@]}"; do
    # Explicit if, not `[[ ]] &&`: under `set -e` a trailing false test on
    # the final iteration would exit the script.
    if [[ -n "${!var-}" ]]; then
        BWRAP_ARGS+=(--setenv "$var" "${!var}")
    fi
done

# Locale variables travel as a family; ${!LC_@} lists the set ones by name.
for var in ${!LC_@}; do
    if [[ -n "${!var-}" ]]; then
        BWRAP_ARGS+=(--setenv "$var" "${!var}")
    fi
done

# Profile-declared passthrough: forwards named host variables. Applied
# before the profile `env` block below, so an explicit `env` value wins.
while IFS= read -r var; do
    if [[ -n "$var" && -n "${!var-}" ]]; then
        BWRAP_ARGS+=(--setenv "$var" "${!var}")
    fi
done < <(plan_get '.passthrough[]')

# Every session's user and network namespaces now come from A: pasta's,
# below, or `unshare`'s for a session without networking. bwrap joins A
# without creating a user namespace of its own, in either case.
if [[ "$SBX_NETNS" == "true" ]]; then
    # pasta maps the host uid to 0 inside the namespace. bwrap does NOT drop
    # inherited capabilities when it is not the namespace's creator, so
    # without an explicit --cap-drop ALL (added below) the payload would run
    # as uid 0 with a full ambient set — able to remount every ro bind rw and
    # to flush the nftables ruleset. nft and dnsmasq now run in launch.sh,
    # outside the sandbox, so nothing in here needs privilege.
    if [[ "$CAPS_KEEP" == "true" ]]; then
        # podman/crun decide rootless-vs-rootful by checking geteuid()==0, not
        # actual privilege. --cap-add ALL above makes the sandboxed process look
        # like real root (uid 0, full capability bits) to podman, so it skips its
        # normal single-UID-mapping fallback and assumes a genuine system gid=5
        # exists for its default devpts mount — which fails with EINVAL, since
        # this is still a single-identity-mapped namespace underneath. These
        # containers/common env vars are the documented override for exactly
        # this case (a process nested in a constrained namespace where EUID==0
        # doesn't mean real privilege): they force podman back onto the correct
        # rootless code path regardless of what geteuid() reports. Confirmed
        # this doesn't touch networking — container egress is still fully
        # gated by this session's own nftables allow-list either way.
        # In userns-full mode these overrides are exactly wrong: there podman
        # MUST run rootful-in-namespace (euid 0 backed by a real multi-UID
        # mapping), and forcing the rootless code path would resurrect the
        # single-UID limitation the outer userns exists to remove.
        if [[ "$USERNS_FULL" != "true" ]]; then
            BWRAP_ARGS+=(
                --setenv _CONTAINERS_USERNS_CONFIGURED done
                --setenv _CONTAINERS_ROOTLESS_UID "$(id -u)"
                --setenv _CONTAINERS_ROOTLESS_GID "$(id -g)"
            )
        fi
    fi
fi

# The payload never needs capabilities. Session setup does, but all of it
# now runs outside the sandbox: nft and dnsmasq in launch.sh, inside
# pasta's namespaces and before bwrap starts. So the drop applies to both
# modes.
#
# CAP_SETPCAP is retained deliberately and is the ONLY capability kept.
# It is the privilege setpriv needs to empty the bounding set, which bwrap
# leaves full on every path now: bwrap always joins an existing user
# namespace (B, via --userns2) instead of creating one. Dropping it here
# makes setpriv fail with "apply bounding set: Operation not permitted" and
# every session exit 127.
#
# Why that is not an escape surface: the setpriv that spends it is
# launch.sh's, above session.sh (see the comment there), so CAP_SETPCAP is
# held across one exec by one process and is gone before the tmux server,
# the payload, or any join exists. This ordering is load-bearing and was
# not always so — while the drop lived in wrapper.sh, the server ran
# holding CAP_SETPCAP for the life of the sandbox and handed it to every
# pane it forked, which is a long-lived RPC-reachable service parked on a
# capability, not a single exec. CAP_SETPCAP cannot mount, configure
# networking, or change ownership in any case.
#
# bwrap no longer creates the user namespace on any path — it always joins
# B with --userns2, entering it holding B's full capability set. --cap-add
# ALL / --cap-drop ALL are what then decide what the payload keeps (measured
# 2026-09-21). Omitting them here would leave the payload holding
# everything B has regardless of the "caps" profile field.
if [[ "$CAPS_KEEP" == "true" ]]; then
    BWRAP_ARGS+=(--cap-add ALL)
else
    BWRAP_ARGS+=(--cap-drop ALL --cap-add CAP_SETPCAP)
fi

# Reap the sandbox if sbx itself dies, rather than leaking a detached
# session with no supervisor.
BWRAP_ARGS+=(--die-with-parent)

# --- Virt (podman/qemu) base plumbing ---
# Always applied: adds no attack surface (nested single-UID userns was
# already reachable; masking subuid/subgid only reduces surface). The
# actual device access (/dev/kvm, /dev/net/tun) stays opt-in via the
# podman/qemu fs profiles.
VIRT_DIR="$SESSION_DIR/virt"
mkdir -p "$VIRT_DIR"

if [[ "$USERNS_FULL" == "true" ]]; then
    # userns-full sessions run podman rootful-in-namespace: rootful podman
    # reads graphroot, not rootless_storage_path. Expanded at write time
    # (HOME inside the sandbox equals host HOME). No ignore_chown_errors:
    # ownership is real in this mode (full subordinate-UID range). This
    # store is separate from the single-UID one by design — the ownership
    # layouts are incompatible.
    cat > "$VIRT_DIR/storage.conf" <<CONFEOF
[storage]
driver = "overlay"
graphroot = "$HOME/.local/state/sbx/virt/containers-full"
CONFEOF
else
    # rootless_storage_path expands $HOME using podman's own runtime env (sbx
    # doesn't clear or override HOME, so it resolves to the same value inside
    # the sandbox as outside). Written literally — do not let bash expand it.
    cat > "$VIRT_DIR/storage.conf" <<'CONFEOF'
[storage]
driver = "overlay"
rootless_storage_path = "$HOME/.local/state/sbx/virt/containers"

[storage.options.overlay]
ignore_chown_errors = "true"
CONFEOF
fi

# cgroupfs/disabled are the only values that can work inside bwrap: the
# systemd cgroup manager needs a user systemd instance over dbus, which
# can't exist here (--unshare-ipc, /run is tmpfs).
cat > "$VIRT_DIR/containers.conf" <<'CONFEOF'
[containers]
cgroups = "disabled"

[engine]
cgroup_manager = "cgroupfs"
events_logger = "file"
CONFEOF

if [[ "$USERNS_FULL" == "true" ]]; then
    # podman materialises whatever containers.conf names as default_network
    # itself, with dns_enabled=false, and then refuses to create it
    # ("netavark: network already exists") — so creating sbx0 under the
    # session's own config (which is about to gain a [network] section
    # below) would yield a network with no DNS, and containers on it
    # could not resolve anything (their resolv.conf names 127.0.0.2, which
    # in a container's network namespace is its own loopback). This copy
    # is taken now, before the [network] section is appended, so it holds
    # only the settings above and cannot inherit that section no matter
    # how large it later grows. It is used for exactly one command: the
    # network create in lib/wrapper.sh. Created under this config, sbx0
    # keeps dns_enabled=true even once the real config below names it as
    # the default. Measured on podman 6.1.1.
    cp "$VIRT_DIR/containers.conf" "$VIRT_DIR/containers-bootstrap.conf"

    # Podman's implicit default "podman" bridge network ships with
    # dns_enabled=false; only explicitly-created custom networks default
    # to DNS-enabled (verified empirically — podman network inspect
    # shows dns_enabled:true only for a network made via `podman network
    # create`). aardvark-dns for containers on this network inherits the
    # sandbox's own /etc/resolv.conf (127.0.0.1 -> sbx's dnsmasq) as its
    # upstream, so routing containers through it is what lets
    # hostname-based `allow` entries populate the forward chain's
    # allowed4 set (see lib/wrapper.sh, which creates this
    # network). Without this, container DNS goes straight to public
    # resolvers, which the forward chain correctly drops (no egress
    # leak) but which also means hostname-based allow entries never
    # resolve for containers — only CIDR-based allow entries work.
    cat >> "$VIRT_DIR/containers.conf" <<'CONFEOF2'

[network]
default_network = "sbx0"
CONFEOF2
fi

: > "$VIRT_DIR/empty"

BWRAP_ARGS+=(
    --tmpfs /var
    --dir /var/tmp
    --dir "/run/user/$(id -u)"
    --ro-bind /sys /sys
    --ro-bind "$VIRT_DIR/empty" /etc/subuid
    --ro-bind "$VIRT_DIR/empty" /etc/subgid
    --setenv XDG_RUNTIME_DIR "/run/user/$(id -u)"
    --setenv CONTAINERS_STORAGE_CONF "$VIRT_DIR/storage.conf"
    --setenv CONTAINERS_CONF "$VIRT_DIR/containers.conf"
)

# Docker compat: a `docker` CLI shim (execs podman) and DOCKER_HOST are
# always on — both are free (no processes; $SESSION_DIR is already bound
# into every sandbox). The socket DOCKER_HOST points at only exists when
# a profile sets "docker_api": true (see wrapper generation). The path is
# pinned to the sbx-computed /run/user/<uid> — deliberately NOT
# $XDG_RUNTIME_DIR, which a profile may override and silently diverge
# from DOCKER_HOST.
PODMAN_SOCK="/run/user/$(id -u)/podman/podman.sock"
mkdir -p "$SESSION_DIR/bin"
cat > "$SESSION_DIR/bin/docker" <<'SHIMEOF'
#!/bin/sh
exec podman "$@"
SHIMEOF
chmod +x "$SESSION_DIR/bin/docker"
BWRAP_ARGS+=(--setenv DOCKER_HOST "unix://$PODMAN_SOCK")

FORKED_MOUNTS=()   # "profile<TAB>source<TAB>dest" — sandbox-owned, seeded once
FORKED_STORES=()   # host store path per forked mount, filled by the seeding loop
RECORD_MOUNTS=()   # "source<TAB>dest" — host-owned, reseeded, changes archived

while IFS= read -r -d '' profile_name && IFS= read -r -d '' source &&
      IFS= read -r -d '' dest && IFS= read -r -d '' perm; do
    # rw mounts may point at a persistent host directory that doesn't
    # exist yet (e.g. first-ever use of a profile's storage dir).
    if [[ "$perm" == "rw" && ! -e "$source" ]]; then
        mkdir -p "$source"
    fi

    # Ensure parent directories exist in the sandbox
    parent=$(dirname "$dest")
    if [[ "$parent" != "/" ]]; then
        IFS='/' read -ra ADDR <<< "$parent"
        curr=""
        for i in "${ADDR[@]}"; do
            if [[ -n "$i" ]]; then
                curr="$curr/$i"
                BWRAP_ARGS+=(--dir "$curr")
            fi
        done
    fi

    # The -try variants: a profile names paths that are optional on any
    # given host ($HOME/.nvm, $HOME/.npm-global, /dev/kvm), and a plain
    # --ro-bind on a missing source aborts the whole launch with
    # "No such file or directory" — one absent toolchain takes down a
    # sandbox that had no need of it. -try skips the mount instead.
    # Only profile-declared mounts are made tolerant; the base binds
    # (/usr, /etc, the session dir) stay strict, because a sandbox
    # missing those is broken rather than merely reduced.
    #
    # This perm switch is mirrored, read-only, by sbx_state_writes in
    # lib/state-paths.sh (--dry-run's report of what a launch would write):
    # a change to what a perm does here belongs there too.
    case "$perm" in
        ro)     BWRAP_ARGS+=(--ro-bind-try "$source" "$dest") ;;
        rw)     BWRAP_ARGS+=(--bind-try "$source" "$dest") ;;
        dev)    BWRAP_ARGS+=(--dev-bind-try "$source" "$dest") ;;
        forked) FORKED_MOUNTS+=("$profile_name"$'\t'"$source"$'\t'"$dest") ;;
        record) RECORD_MOUNTS+=("$source"$'\t'"$dest") ;;
        *)
            # Unreachable while sbx_profile_check rejects any other perm,
            # but this must fail closed, not open: a mount that falls
            # through here silently would launch with less isolation than
            # the profile asked for, and nobody would know.
            echo "Error: unknown perm '$perm' for mount $dest" >&2
            exit 1
            ;;
    esac
done < <(jq -j 'def nul: [0] | implode; .mounts[] | .profile, nul, .source, nul, .dest, nul, .perm, nul' <<< "$PLAN")

# Where a forked mount's store lives on the host: lib/state-paths.sh, shared
# with --dry-run.
sbx_forked_store() {   # <profile> <dest>
    sbx_state_forked_store "$STATE_DIR" "$PWD" "$1" "$2"
}

if [[ "$RESEED" == "true" ]]; then
    # Give the session name back before anything else. --reseed never
    # launches, and the EXIT trap that would release the claim is installed
    # much further down, so every exit below would otherwise strand
    # sessions/<name> and its pid record — residue that a later --gc or claim
    # reclaim has to clean up. Releasing here also keeps our own pid record
    # out of the liveness scan below, which would otherwise see a live
    # session with no sidecar yet — us — and refuse.
    rm -rf "${SESSION_DIR:?}"
    rm -f "${SESSION_PID_FILE:?}"

    if [[ ${#FORKED_MOUNTS[@]} -eq 0 ]]; then
        echo "No forked mounts in the selected profiles; nothing to reseed." >&2
        exit 1
    fi

    RESEED_TARGETS=()
    for fm in "${FORKED_MOUNTS[@]}"; do
        IFS=$'\t' read -r f_prof f_src f_dest <<< "$fm"
        RESEED_TARGETS+=("$(sbx_forked_store "$f_prof" "$f_dest")")
    done

    # A store is bind-mounted rw into its session for as long as that session
    # runs. rm -rf here would empty the tree underneath a live sandbox,
    # destroying the auth tokens and history it is using at that moment — the
    # exact state `forked` exists to accumulate. There is no way to derive
    # which store a session holds after the fact (the key includes the launch
    # directory, and session.json is sandbox-writable and so forgeable), so
    # the mapping is read back from the host-written join sidecar, which
    # lives in the tmpfs-masked join/ area and records it at launch.
    RESEED_BLOCKER=""
    for spid in "$STATE_DIR"/join/*.pid; do
        [[ -f "$spid" ]] || continue
        sname=$(basename "$spid" .pid)
        sbx_session_alive "$STATE_DIR" "$sname" || continue
        # The sidecar is written long after the pid claim, so a session
        # caught in between is live with nothing recorded. Unknown means
        # refuse, not "no conflict": a refusal is recoverable, deleting a
        # live session's auth store is not.
        if [[ ! -f "$STATE_DIR/join/$sname.json" ]]; then
            RESEED_BLOCKER="$sname (still starting up — its mounts are not recorded yet)"
            break
        fi
        while IFS= read -r lstore; do
            [[ -n "$lstore" ]] || continue
            for rt in "${RESEED_TARGETS[@]}"; do
                if [[ "$lstore" == "$rt" ]]; then
                    RESEED_BLOCKER="$sname"
                fi
            done
        done < <(jq -r '.forked_stores[]?' "$STATE_DIR/join/$sname.json" 2>/dev/null || true)
        if [[ -n "$RESEED_BLOCKER" ]]; then
            break
        fi
    done
    if [[ -n "$RESEED_BLOCKER" ]]; then
        echo "Error: session '$RESEED_BLOCKER' is live and may have these stores mounted." >&2
        echo "Refusing to reseed: deleting a store under a running session destroys the state it is using." >&2
        echo "End that session and try again." >&2
        exit 1
    fi

    # Name the store, not just the mount: the store is the thing being
    # deleted, and its size is the only hint of how much accumulated state
    # goes with it.
    echo "This will delete the sandbox-owned copies of:"
    for i in "${!FORKED_MOUNTS[@]}"; do
        IFS=$'\t' read -r f_prof f_src f_dest <<< "${FORKED_MOUNTS[$i]}"
        f_store="${RESEED_TARGETS[$i]}"
        if [[ -d "$f_store" ]]; then
            f_size=$(du -sh "$f_store" 2>/dev/null | cut -f1)
        else
            f_size="not yet created"
        fi
        echo "  $f_dest  (re-seeded from $f_src)"
        echo "    $f_store  [$f_size]"
    done
    if [[ "$ASSUME_YES" != "true" ]]; then
        # `|| true`: read exits non-zero on EOF (e.g. a non-interactive
        # invocation with no stdin), and under `set -e` that would exit the
        # script right here, skipping the "Aborted." message below.
        read -r -p "Proceed? [y/N] " reply || true
        [[ "$reply" == [yY]* ]] || { echo "Aborted." >&2; exit 1; }
    fi
    for f_store in "${RESEED_TARGETS[@]}"; do
        rm -rf "${f_store:?}"
    done
    echo "Reseeded. The next launch will read from the host."
    exit 0
fi

# Sandbox-owned mounts. Seeded from the host only when the store does not
# yet exist; from then on the store IS the tree and the host source is
# never consulted again. That is the defining property of `forked`, not an
# optimization — see the design spec. Bound rw directly, so there is no
# write-back at teardown and nothing to diff.
for fm in "${FORKED_MOUNTS[@]}"; do
    IFS=$'\t' read -r f_prof f_src f_dest <<< "$fm"
    # An absent source is skipped outright, not seeded into an empty store.
    # Creating the store here would be permanent damage: the store would
    # exist, so `[[ ! -e "$f_store" ]]` below never fires again, and the
    # empty DIRECTORY would be bound at a destination that wants a FILE —
    # for every launch from now on, including after the host file finally
    # appears. Under the old `copy` perm this self-healed because the host
    # was re-read every time; `forked` reads it once, so getting it wrong
    # once is getting it wrong forever. The trigger is ordinary: `sbx --cli
    # claude` before Claude Code has ever written ~/.claude.json. Skipping
    # also makes the mount match what the plan's warnings already told the
    # user (a source-not-present mount is skipped, per lib/resolve.sh).
    if [[ ! -e "$f_src" ]]; then
        continue
    fi
    f_store=$(sbx_forked_store "$f_prof" "$f_dest")
    # Recorded for the join sidecar, which is what tells a later --reseed
    # that this store belongs to a running session.
    FORKED_STORES+=("$f_store")

    if [[ ! -e "$f_store" ]]; then
        mkdir -p "$f_store"
        sbx_copy_seed_progress "$f_src" "$f_store" "Seeding $f_dest"
    fi

    if [[ -f "$f_src" ]]; then
        BWRAP_ARGS+=(--bind "$f_store/$(basename "$f_src")" "$f_dest")
    else
        BWRAP_ARGS+=(--tmpfs "$f_dest")
        BWRAP_ARGS+=(--bind "$f_store" "$f_dest")
    fi
done

# Host-owned mounts with change detection. A private working copy is seeded
# fresh every launch and hashed into a manifest; teardown diffs the working
# copy against THAT manifest rather than against the live host source, so a
# host edit made while the session runs cannot be misattributed to the
# sandbox.
RECORD_WORK_DIR="$STATE_DIR/work/$SESSION_ID"

# Removed, not merely created. teardown() clears this at the end of a normal
# session, but a session killed by SIGKILL, OOM or power loss never runs it,
# and the next launch from the same directory reclaims the same name and so
# lands on the same path. sbx_copy_seed_progress's `cp -a "$src/." "$tmp/"` MERGES
# into a non-empty destination rather than replacing it, and the manifest is
# built afterwards over the merged tree — so a ghost file from the dead
# session is folded into the BASELINE, reads as unchanged host state, never
# appears in --changes, and is visible to the sandbox although the host does
# not have it. That contradicts what `record` promises: a fresh copy from
# the host source, every launch. This one line is also what covers an exit
# between here and the EXIT trap installed further down.
rm -rf "${RECORD_WORK_DIR:?}"

for rm_ in "${RECORD_MOUNTS[@]}"; do
    IFS=$'\t' read -r r_src r_dest <<< "$rm_"
    r_id=$(sbx_copy_mount_id "$r_dest")
    r_work="$RECORD_WORK_DIR/$r_id"

    mkdir -p "$r_work"
    sbx_copy_seed_progress "$r_src" "$r_work" "Seeding $r_dest"
    sbx_manifest_build "$r_work" "$RECORD_WORK_DIR/$r_id.manifest"

    if [[ -f "$r_src" ]]; then
        BWRAP_ARGS+=(--bind "$r_work/$(basename "$r_src")" "$r_dest")
    else
        BWRAP_ARGS+=(--tmpfs "$r_dest")
        BWRAP_ARGS+=(--bind "$r_work" "$r_dest")
    fi
done

# Environment from profiles: every assignment, in profile order. bwrap keeps
# the last --setenv for a name, which is what makes a later profile win.
while IFS= read -r -d '' key && IFS= read -r -d '' val; do
    BWRAP_ARGS+=(--setenv "$key" "$val")
done < <(jq -j 'def nul: [0] | implode; .env[] | .name, nul, .value, nul' <<< "$PLAN")

if [[ -n "$WORKDIR" ]]; then
    BWRAP_ARGS+=(--chdir "$WORKDIR")
fi

# $SESSION_DIR/bin holds the docker shim; first on PATH so `docker` always
# resolves to it (the host docker socket is never reachable in a sandbox).
BWRAP_ARGS+=(--setenv PATH "$SESSION_DIR/bin:$SANDBOX_PATH")

# Network Setup
if [[ "$SBX_NETNS" == "true" ]]; then
    # The host's default-route interface and address, handed to pasta
    # explicitly (--interface, -a, -g, -n) so the namespace mirrors it.
    HOST_IFACE=$(ip route show default | awk '{print $5}' | head -n 1)
    if [[ -z "$HOST_IFACE" ]]; then
        echo "Error: networking needs a default route on the host, and there is none." >&2
        exit 1
    fi
    HOST_IP=$(ip addr show "$HOST_IFACE" | grep "inet " | awk '{print $2}' | cut -d/ -f1 | head -n 1)
    HOST_GW=$(ip route show default | awk '{print $3}' | head -n 1)
    HOST_MASK=$(ip addr show "$HOST_IFACE" | grep "inet " | awk '{print $2}' | cut -d/ -f2 | head -n 1)

    DNS_DIR="$SESSION_DIR/dns"
    mkdir -p "$DNS_DIR"

    # Loopback address for this session's dnsmasq. Deliberately NOT
    # 127.0.0.1: pasta's UDP handler binds 127.0.0.1:53 inside the network
    # namespace it creates whenever the host has anything listening on port
    # 53 (systemd-resolved's 127.0.0.53/127.0.0.54 stubs, and under WSL2 the
    # 10.255.255.254 DNS proxy). dnsmasq then loses the race and dies with
    # "failed to create listening socket for 127.0.0.1: Address already in
    # use", taking the whole session with it. Neither -u none nor -t none
    # suppresses that bind; only --no-udp does, and that would break
    # dnsmasq's own upstream queries. Any other 127.0.0.0/8 address is
    # untouched by pasta and is local via lo's 127.0.0.1/8.
    SBX_DNS_ADDR="127.0.0.2"

    if [[ "$NET_ENABLED" == "true" ]]; then
        printf 'nameserver %s\n' "$SBX_DNS_ADDR" > "$DNS_DIR/resolv.conf"
    else
        # Host ports only: no resolver runs and nothing outside loopback is
        # reachable, so lookups fail at once instead of hanging on a
        # nameserver the ruleset drops. "localhost" still resolves, from
        # /etc/hosts.
        : > "$DNS_DIR/resolv.conf"
    fi

    # /etc is bound read-only above, so whatever /etc/resolv.conf is on the
    # host appears in the sandbox — and on many hosts it is a symlink out of
    # /etc entirely (/mnt/wsl/resolv.conf under WSL2, /run/systemd/resolve/
    # stub-resolv.conf under systemd-resolved). The kernel resolves a bind
    # mount's destination through symlinks, and neither target exists in the
    # sandbox's fresh root, so binding at the /etc path fails outright with
    # "mount point is a symbolic link to nowhere". Bind at the resolved
    # target instead: bwrap creates the missing parents on the root tmpfs,
    # and the inherited symlink then points at our file.
    RESOLV_DEST=/etc/resolv.conf
    if [[ -L /etc/resolv.conf ]]; then
        RESOLV_DEST=$(readlink -f /etc/resolv.conf 2>/dev/null) || RESOLV_DEST=""
        [[ -n "$RESOLV_DEST" ]] || RESOLV_DEST=/etc/resolv.conf
    fi
    BWRAP_ARGS+=(--ro-bind "$DNS_DIR/resolv.conf" "$RESOLV_DEST")

    sbx_egress_rules "$(plan_get '.net')" "$SBX_DNS_ADDR" "$NEST_TCP" "$NEST_UDP" > "$DNS_DIR/rules.nft"
fi

# Session State Persistence
jq -n --indent 4 --arg id "$SESSION_ID" --arg cwd "$PWD" --argjson pid "$$" \
    --argjson fs "$(sbx_resolve_strings "${FS_PROFILES[@]}")" \
    --argjson net "$(sbx_resolve_strings "${NET_PROFILES[@]}")" \
    --arg cli "$CLI_PROFILE" \
    '{id: $id, cwd: $cwd, pid: $pid, fs_profiles: $fs, net_profiles: $net,
      cli_profile: (if $cli == "" then null else $cli end)}' \
    > "$SESSION_DIR/session.json"

# The join sidecar. Same information session.json would have carried, but
# kept OUTSIDE $SESSION_DIR on purpose: that directory is bound rw into the
# sandbox, so anything in it is attacker-authored, and --join must not take
# security-relevant input from the sandbox it is about to enter. $STATE_DIR
# is masked by a --tmpfs inside with only $SESSION_DIR bound back in, so
# this path does not exist from the sandbox's point of view.
#   path      the session's own PATH, which --join re-imposes because tmux
#             otherwise hands the pane the host client's PATH.
#   workdir   what `tmux new-session -c` should use, so a join starts where
#             the payload did rather than in the host's cwd. Empty --wd means
#             "wherever bwrap would have landed", which is the launch dir.
#   caps_keep informational: the drop is applied (or not) once at launch, in
#             launch.sh, so --join does not consult this. Recorded so a
#             capful join is explainable without re-deriving the profiles.
#   forked_stores
#             the host paths this session has bind-mounted rw, so --reseed
#             can refuse to rm -rf a store out from under a running sandbox.
#             Recorded rather than derived because it cannot be recovered
#             later: the store key is (profile, slug of the LAUNCH dir,
#             mount id), and the only host-side record of a session's launch
#             dir is session.json, which lives inside the sandbox and is
#             therefore forgeable. workdir above is not a substitute — --wd
#             makes it a different directory entirely.
jq -n --indent 4 --arg path "$SESSION_DIR/bin:$SANDBOX_PATH" --arg workdir "${WORKDIR:-$PWD}" \
    --argjson caps_keep "$CAPS_KEEP" \
    --argjson forked_stores "$(sbx_resolve_strings "${FORKED_STORES[@]}")" \
    '{path: $path, workdir: $workdir, caps_keep: $caps_keep, forked_stores: $forked_stores}' \
    > "$STATE_DIR/join/$SESSION_ID.json"

# GUI Setup (xpra virtual display)
if [[ "$GUI_FLAG" == "true" ]]; then
    # Find a free X11 display slot
    DISPLAY_NUM=100
    while [[ -S "/tmp/.X11-unix/X$DISPLAY_NUM" ]]; do
        DISPLAY_NUM=$((DISPLAY_NUM + 1))
    done
    XPRA_DISPLAY=":$DISPLAY_NUM"
    XPRA_LOG="$SESSION_DIR/xpra.log"

    echo "Starting xpra on display $XPRA_DISPLAY..."
    xpra start "$XPRA_DISPLAY" \
        --daemon=yes \
        --log-file="$XPRA_LOG" \
        --mdns=no \
        --notifications=no \
        --bell=no \
        --speaker=disabled \
        --microphone=disabled \
        > /dev/null 2>&1

    # Wait for the virtual X11 socket to appear
    X11_SOCK="/tmp/.X11-unix/X$DISPLAY_NUM"
    echo -n "Waiting for display"
    XPRA_READY=false
    for i in {1..40}; do
        if [[ -S "$X11_SOCK" ]]; then
            XPRA_READY=true
            break
        fi
        sleep 0.25
        echo -n "."
    done
    echo

    if [[ "$XPRA_READY" != "true" ]]; then
        echo "Error: xpra display $XPRA_DISPLAY failed to start. Check $XPRA_LOG" >&2
        xpra stop "$XPRA_DISPLAY" >/dev/null 2>&1 || true
        exit 1
    fi

    # Build a session Xauthority cookie for the display.
    # xpra writes its cookie to the host Xauthority keyed to the host hostname,
    # but the sandbox runs under a different hostname (e.g. pasta-<host> when
    # networking is on, or no UTS name otherwise). We rewrite the cookie's
    # address family to FamilyWild (ffff) so it matches from any hostname.
    HOST_XAUTH="${XAUTHORITY:-$HOME/.Xauthority}"
    SBX_XAUTH="$SESSION_DIR/Xauthority"
    rm -f "$SBX_XAUTH"

    # The cookie may lag slightly behind the socket; retry briefly.
    for i in {1..20}; do
        if xauth -f "$HOST_XAUTH" nlist "$XPRA_DISPLAY" 2>/dev/null | grep -q .; then
            break
        fi
        sleep 0.25
    done

    if xauth -f "$HOST_XAUTH" nlist "$XPRA_DISPLAY" 2>/dev/null \
        | sed -e 's/^..../ffff/' \
        | xauth -f "$SBX_XAUTH" nmerge - 2>/dev/null; then
        : # cookie installed
    else
        echo "Warning: could not build X11 auth cookie; GUI apps may fail with auth errors." >&2
    fi

    # Expose the X11 socket and auth cookie inside the sandbox
    BWRAP_ARGS+=(--dir /tmp/.X11-unix)
    BWRAP_ARGS+=(--bind "$X11_SOCK" "/tmp/.X11-unix/X$DISPLAY_NUM")
    BWRAP_ARGS+=(--setenv DISPLAY "$XPRA_DISPLAY")
    if [[ -f "$SBX_XAUTH" ]]; then
        BWRAP_ARGS+=(--ro-bind "$SBX_XAUTH" /tmp/.sbx-Xauthority)
        BWRAP_ARGS+=(--setenv XAUTHORITY /tmp/.sbx-Xauthority)
    fi
    # Prevent MIT-SHM errors (IPC is unshared, so SHM won't work)
    BWRAP_ARGS+=(--setenv LIBGL_ALWAYS_INDIRECT 1)

    GUI_MODE=true
    echo "GUI display $XPRA_DISPLAY is ready."
    echo "  Attach viewer : xpra attach $XPRA_DISPLAY"
    echo "  Stop display  : xpra stop $XPRA_DISPLAY"
fi

# Masks, appended after every profile mount because bwrap applies mount
# arguments in order: a profile mounting $HOME or $HOME/.local would
# otherwise re-expose these. The sandbox gets its own session directory
# and nothing else — no sibling sessions, no persistent cli stores, and
# no ability to author the profiles that configure the next launch.
BWRAP_ARGS+=(--tmpfs "$STATE_DIR")
BWRAP_ARGS+=(--bind "$SESSION_DIR" "$SESSION_DIR")
BWRAP_ARGS+=(--tmpfs "$CONFIG_DIR")

# Teardown Logic
teardown() {
    # Must be the first line: in an EXIT trap $? is the status the script is
    # dying with, i.e. bwrap's. That is NOT the payload's exit code (a tmux
    # session's status does not reach its client, and dropping it is
    # deliberate) — it is the launch's own, and a caller has to be able to
    # tell "the sandbox never came up" apart from "the session ran".
    local exit_status=$?

    # A seed interrupted mid-progress leaves a partial line on the terminal.
    [[ -t 2 ]] && printf '\r\033[K' >&2

    echo "Tearing down session $SESSION_ID..."

    # This is the lock that actually keeps writeback off a live join. The
    # case it's for is teardown running as an EXIT trap on a fatal signal —
    # Ctrl-C on the launching terminal, a CI timeout killing sbx — while the
    # sandbox is still fully up: bwrap only dies with its parent once sbx
    # has already exited, i.e. after this trap has run, so the in-sandbox
    # PID-1 waiter (see session.sh) plays no part in that path and cannot
    # order anything here. The tampering case the waiter genuinely is
    # vulnerable to (`rm tmux.sock`, `tmux kill-server`) turns out not to
    # need this lock at all: killing the waiter is what makes bwrap return,
    # and bwrap returning tears down the pid namespace that the join's pane
    # lives in, so the join has nothing left to write with by the time
    # teardown runs — measured in tests/join.bats "writeback waits on the
    # host lock when teardown is not gated by the sandbox". This lock is on
    # the host side and on a path the sandbox cannot see (see the --join
    # branch), so it holds regardless of what happens inside. Bounded,
    # never an unbounded block: a stale lock must not be able to hang
    # teardown forever.
    JOIN_LOCK="$STATE_DIR/join/$SESSION_ID.lock"
    if exec 9>>"$JOIN_LOCK"; then
        if ! flock -w 30 -x 9; then
            echo "Warning: a --join still holds the session lock after 30s; archiving record-mount changes anyway." >&2
        fi
    fi

    # Change archive for record mounts. The baseline is the launch-time
    # manifest, not the host source, so this reports what the SANDBOX did.
    if [[ ${#RECORD_MOUNTS[@]} -gt 0 ]]; then
        arch_dir="$STATE_DIR/changes/$(sbx_copy_path_slug "$PWD")/$(date +%Y%m%d-%H%M%S)-$SESSION_ID"
        for rm_ in "${RECORD_MOUNTS[@]}"; do
            IFS=$'\t' read -r r_src r_dest <<< "$rm_"
            r_id=$(sbx_copy_mount_id "$r_dest")
            r_work="$RECORD_WORK_DIR/$r_id"
            r_base="$RECORD_WORK_DIR/$r_id.manifest"
            [[ -d "$r_work" ]] || continue

            r_cur="$RECORD_WORK_DIR/$r_id.manifest.now"
            sbx_manifest_build "$r_work" "$r_cur"

            mkdir -p "$arch_dir/$r_id"
            while IFS= read -r rel; do
                [[ -z "$rel" ]] && continue
                mkdir -p "$arch_dir/$r_id/$(dirname "$rel")"
                cp -a "$r_work/$rel" "$arch_dir/$r_id/$rel"
            done < <(sbx_manifest_changed "$r_base" "$r_cur")

            sbx_manifest_deleted "$r_base" "$r_cur" > "$arch_dir/$r_id.deleted"
            echo "Changes from this session: $arch_dir/$r_id"
        done

        # Prune old archives here too, not only on an explicit --gc, so
        # they never accumulate unbounded just because nobody remembered to
        # run it.
        sbx_prune_changes "$STATE_DIR/changes/$(sbx_copy_path_slug "$PWD")" "$(sbx_keep_changes)"
    fi
    rm -rf "$RECORD_WORK_DIR"

    # Nothing durable lives here: forked stores, change archives and the
    # join sidecar are all outside. Removing the directory outright is the
    # whole fix for --list-sessions accumulating dead entries.
    sbx_session_remove "$STATE_DIR" "$SESSION_ID"

    if [[ -n "$XPRA_DISPLAY" ]]; then
        echo "Stopping xpra display $XPRA_DISPLAY..."
        xpra stop "$XPRA_DISPLAY" >/dev/null 2>&1 || true
    fi

    if [[ "$exit_status" -ne 0 ]]; then
        # Saying "changes saved" here would be a lie a CI job cannot see
        # through: the sandbox may never have got as far as running anything.
        echo "Session $SESSION_ID ended with status $exit_status; the payload may never have run." >&2
    else
        echo "Session $SESSION_ID finished."
    fi
}

trap teardown EXIT

# Execution
#
# The scripts that run the session are fixed files in lib/: launch.sh runs
# in the control namespace A, and session.sh and wrapper.sh inside the
# sandbox, so those two are copied into the session directory (the one host
# path every sandbox has). What differs per session is written beside them
# as data: bwrap.args, launch.env, wrapper.env and command.

# Per-session tmux config. The -f that loads it keeps the server off the
# user's ~/.tmux.conf, which a mounted $HOME would otherwise supply.
#   update-environment  SECURITY. A client ships its environment to the
#                  server, and by default DISPLAY, SSH_AUTH_SOCK and friends
#                  are applied to new sessions — a hole straight through
#                  --clearenv. Not sufficient alone: tmux copies the client's
#                  PATH into a pane regardless, which is why --join
#                  re-imposes the session's PATH itself.
#   exit-empty     the server exits with its last session, which is what
#                  lets session.sh stop waiting.
#   prefix C-\     a host tmux keeps C-b, so nesting needs no doubled prefix.
#   window-size    per-client sizing, so one join cannot resize another.
#   status-left    makes "you are inside a sandbox" visible at a glance.
cat > "$SESSION_DIR/tmux.conf" <<EOF
set -g update-environment ''
set -g exit-empty on
set -g escape-time 0
set -g window-size latest
unbind C-b
set -g prefix C-\\\\
bind C-\\\\ send-prefix
set -g status on
set -g status-left ' sbx:$SESSION_ID '
set -g status-left-length 40
EOF

install -m 0755 "$SCRIPT_DIR/lib/session.sh" "$SESSION_DIR/session.sh"
install -m 0755 "$SCRIPT_DIR/lib/wrapper.sh" "$SESSION_DIR/wrapper.sh"
printf '%s\0' "${COMMAND[@]}" > "$SESSION_DIR/command"
printf '%s\0' "${BWRAP_ARGS[@]}" > "$SESSION_DIR/bwrap.args"

# wrapper.sh's settings. The podman ones matter only to a "caps": "keep"
# session; the socket path is pinned to the sbx-computed /run/user/<uid>,
# not $XDG_RUNTIME_DIR, which a profile may override away from DOCKER_HOST.
declare -p CAPS_KEEP USERNS_FULL DOCKER_API PODMAN_SOCK VIRT_DIR > "$SESSION_DIR/wrapper.env"

# launch.sh's settings.
#   NET_MODE  none      no network namespace beyond B's loopback
#             loopback  host ports only: A's ruleset, no resolver
#             dns       a net profile: ruleset, dnsmasq, readiness probe
NET_MODE=none
DNSMASQ_BIN=""
DNSMASQ_ARGS=()
if [[ "$SBX_NETNS" == "true" ]]; then
    NET_MODE=loopback
    if [[ "$NET_ENABLED" == "true" ]]; then
        NET_MODE=dns
        DNSMASQ_BIN=$(command -v dnsmasq)
        mapfile -t DNSMASQ_ARGS < <(sbx_egress_dnsmasq_args "$(plan_get '.net')")
    fi
else
    SBX_DNS_ADDR=""
    RESOLV_DEST=""
fi
declare -p NET_MODE CAPS_KEEP NEST_TCP NEST_UDP SBX_DNS_ADDR DNSMASQ_BIN DNSMASQ_ARGS \
    TEST_DOMAIN RESOLV_DEST > "$SESSION_DIR/launch.env"

# pasta's -T / -U are the whole host-access allow-list: pasta binds exactly
# these ports inside the namespace and splices them to the host's loopback.
# "none" replaces pasta's default of forwarding every port bound on the
# host, and keeping the lists separate stops a TCP grant from carrying its
# UDP twin. --no-map-gw: otherwise the gateway address reaches every
# host-local service without a rule naming it.
join_ports() {
    if [[ $# -eq 0 ]]; then
        echo none
    else
        local joined; joined=$(printf '%s,' "$@"); echo "${joined%,}"
    fi
}
PASTA_FWD_TCP=$(join_ports "${HOST_PORTS_TCP[@]}")
PASTA_FWD_UDP=$(join_ports "${HOST_PORTS_UDP[@]}")

# pasta is handed "/bin/bash <script>", not the script: Ubuntu's AppArmor
# profile for pasta allows exec only under /bin and /usr/bin (measured on
# Ubuntu 26.04, 2026-09-23), and Ux there still runs the script unconfined.
LAUNCH=(/bin/bash "$SCRIPT_DIR/lib/launch.sh" "$SESSION_DIR/launch.env")

# setpriv --pdeathsig KILL on every shape: launch.sh outlives bwrap, so the
# process between sbx and bwrap needs its own parent-death signal. Under
# pasta, which forks its child, a SIGKILLed sbx still orphans launch.sh —
# networkless once pasta is gone, and --gc judges the session by sbx's pid.
if [[ "$SBX_NETNS" == "true" ]]; then
    PASTA=(pasta -f --config-net --no-map-gw -T "$PASTA_FWD_TCP" -U "$PASTA_FWD_UDP"
           --interface "$HOST_IFACE" --no-ndp --no-dhcpv6 --no-ra
           -a "$HOST_IP" -g "$HOST_GW" -n "$HOST_MASK")
    if [[ "$USERNS_FULL" == "true" ]]; then
        echo "Starting session $SESSION_ID with networking (full userns)..."
        # unshare claims the user's /etc/subuid range through the setuid
        # newuidmap, so pasta must not create a user namespace of its own,
        # which would discard the multi-UID mapping: --netns-only.
        setpriv --pdeathsig KILL -- unshare --map-auto --map-root-user -- \
            "${PASTA[@]}" --netns-only -- "${LAUNCH[@]}"
    else
        if [[ "$NET_MODE" == "dns" ]]; then
            echo "Starting session $SESSION_ID with networking..."
        else
            HOST_PORT_DESC=""
            [[ "$PASTA_FWD_TCP" != "none" ]] && HOST_PORT_DESC="tcp $PASTA_FWD_TCP"
            if [[ "$PASTA_FWD_UDP" != "none" ]]; then
                [[ -n "$HOST_PORT_DESC" ]] && HOST_PORT_DESC+=", "
                HOST_PORT_DESC+="udp $PASTA_FWD_UDP"
            fi
            echo "Starting session $SESSION_ID with host ports $HOST_PORT_DESC (no internet)..."
        fi
        setpriv --pdeathsig KILL -- "${PASTA[@]}" -- "${LAUNCH[@]}"
    fi
else
    echo "Starting session $SESSION_ID..."
    # The control namespace A for a session without networking: this user
    # mapped to 0 in a new user namespace, and an empty network namespace.
    setpriv --pdeathsig KILL -- unshare --user --map-root-user --net -- "${LAUNCH[@]}"
fi
