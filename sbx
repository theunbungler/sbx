#!/bin/bash

# sbx - Portable Unprivileged Sandbox Orchestrator

set -e

STATE_DIR="$HOME/.local/state/sbx"
CONFIG_DIR="$HOME/.config/sbx"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# shellcheck source=lib/copy-mounts.sh
source "$SCRIPT_DIR/lib/copy-mounts.sh"

GUI_MODE=false
XPRA_DISPLAY=""

# Session multiplexer. abduco is preferred; dtach (its ancestor) is the
# fallback, because distros carry one or the other — abduco is missing from
# Ubuntu/Debian, dtach from the Arch repos. They are command-line compatible
# for the only two things sbx asks of them: `-c <socket> <cmd>` to create a
# session and attach to it, and `-a <socket>` to reattach. Resolved to an
# absolute path because the launch script runs it inside bwrap, where /usr
# is bound read-only at the same path as on the host.
SESSION_MUX=""
find_session_mux() {
    [[ -n "$SESSION_MUX" ]] && return 0
    local candidate
    for candidate in abduco dtach; do
        if SESSION_MUX=$(command -v "$candidate" 2>/dev/null); then
            return 0
        fi
    done
    SESSION_MUX=""
    echo "Error: neither 'abduco' nor 'dtach' was found on PATH; sbx needs one of them to run a session." >&2
    exit 1
}

# Ensure state directory exists
mkdir -p "$STATE_DIR"

usage() {
    cat <<EOF
Usage: $(basename "$0") [options] [command]

Options:
  --list-profiles        Show available profiles
  --list-sessions        Show active sessions
  --join <session>       Attach to an existing session
  --fs <profile>         Apply a filesystem profile (multiple allowed)
  --net <profile>        Apply a network profile
  --cli <profile>        Apply a CLI/environment profile
  --gui                  Enable isolated GUI via xpra (attach with: xpra attach :<N>)
  -h, --help             Show this help message

Profiles are searched in:
  1. ./.sbx/profiles/
  2. \$HOME/.config/sbx/profiles/
  3. $SCRIPT_DIR/profiles/
EOF
}

resolve_profile() {
    local type="$1"
    local name="$2"

    # If it's a direct path to a file, use it
    if [[ -f "$name" ]]; then
        realpath "$name"
        return 0
    fi
    if [[ -f "$name.json" ]]; then
        realpath "$name.json"
        return 0
    fi

    # Strip the type prefix if it was included (e.g., "cli/dev" -> "dev")
    if [[ "$name" == "$type/"* ]]; then
        name="${name#$type/}"
    fi

    local paths=(
        "./.sbx/profiles/$type/$name.json"
        "$CONFIG_DIR/profiles/$type/$name.json"
        "$SCRIPT_DIR/profiles/$type/$name.json"
    )

    for p in "${paths[@]}"; do
        if [[ -f "$p" ]]; then
            echo "$p"
            return 0
        fi
    done

    echo "Error: Profile '$name' of type '$type' not found." >&2
    exit 1
}

list_profiles() {
    local types=("cli" "fs" "net")
    local sources=(
        "Project:./.sbx/profiles"
        "User:$CONFIG_DIR/profiles"
        "Global:$SCRIPT_DIR/profiles"
    )

    echo "Available Profiles:"
    for type in "${types[@]}"; do
        echo ""
        echo "${type^^} Profiles:"
        local found=0
        for src in "${sources[@]}"; do
            local label="${src%%:*}"
            local path="${src#*:}"
            if [[ -d "$path/$type" ]]; then
                # Use a temporary variable to capture find output to avoid empty lines
                local files
                files=$(find "$path/$type" -name "*.json" | sed "s|$path/$type/||" | sed 's/\.json$//' | sort)
                if [[ -n "$files" ]]; then
                    while IFS= read -r profile; do
                        echo "  $profile ($label)"
                        found=1
                    done <<< "$files"
                fi
            fi
        done
        if [[ $found -eq 0 ]]; then
            echo "  (none)"
        fi
    done
}

# Main Argument Parsing
FS_PROFILES=()
NET_PROFILE=""
CLI_PROFILE=""
COMMAND=()
GUI_FLAG=false
CAPS_KEEP=false

while [[ $# -gt 0 ]]; do
    case "$1" in
        --list-profiles)
            list_profiles
            exit 0
            ;;
        --list-sessions)
            echo "Active Sessions (this directory):"
            for sdir in "$STATE_DIR"/*; do
                if [[ -d "$sdir" && -f "$sdir/session.json" ]]; then
                    scwd=$(jq -r '.cwd' "$sdir/session.json")
                    if [[ "$scwd" == "$PWD" ]]; then
                        sid=$(jq -r '.id' "$sdir/session.json")
                        pid=$(jq -r '.pid // empty' "$sdir/session.json")
                        if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
                            echo "  $sid (active, PID: $pid)"
                        else
                            echo "  $sid (inactive)"
                        fi
                    fi
                fi
            done
            exit 0
            ;;
        --join)
            JOIN_SESSION="$2"
            shift 2
            SDIR="$STATE_DIR/$JOIN_SESSION"
            # -S, not -f: the multiplexer's rendezvous point is a unix
            # socket, which is never a regular file.
            if [[ -d "$SDIR" && -S "$SDIR/session.sock" ]]; then
                find_session_mux
                "$SESSION_MUX" -a "$SDIR/session.sock"
            else
                echo "Error: Session '$JOIN_SESSION' not found or no socket available." >&2
                exit 1
            fi
            exit 0
            ;;
        --fs)
            FS_PROFILES+=("$(resolve_profile fs "$2")")
            shift 2
            ;;
        --net)
            NET_PROFILE="$(resolve_profile net "$2")"
            shift 2
            ;;
        --cli)
            CLI_PROFILE="$(resolve_profile cli "$2")"
            shift 2
            ;;
        --)
            shift
            COMMAND=("$@")
            break
            ;;
        --gui)
            GUI_FLAG=true
            shift
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            if [[ ${#COMMAND[@]} -eq 0 ]]; then
                COMMAND=("$@")
                break
            else
                break
            fi
            ;;
    esac
done

if [[ ${#COMMAND[@]} -eq 0 ]]; then
    COMMAND=("/bin/bash")
fi

# Resolved here, not at launch-script generation time, so a host missing
# both multiplexers fails before any session state or xpra display exists.
find_session_mux

# True when a resolved profile path lies inside the launch directory's
# .sbx tree — i.e. it was supplied by the project rather than by the user.
profile_is_project() {
    local abs proj
    abs=$(realpath -m "$1")
    proj=$(realpath -m "$PWD/.sbx")
    [[ "$abs" == "$proj/"* ]]
}

# --- Profile feature-field scan (phase 2 virt) ---
# Optional fields honored in any applied fs/cli profile:
#   "userns": "full"    -> run the whole session inside an outer user
#                          namespace carrying the user's full subordinate-
#                          UID range (multi-UID podman). Requires --net.
#                          Implies "caps": "keep".
#   "caps": "keep"      -> retain capabilities inside the sandbox. Needed
#                          for nested user namespaces (podman), and it
#                          costs the ro-mount and firewall guarantees.
#   "docker_api": true  -> start a podman docker-API socket for the session.
#
# None of these are honored from a project-supplied profile: a repository
# must never be able to talk its way back to the pre-hardening boundary,
# with or without the interactive confirmation added elsewhere.
USERNS_FULL=false
DOCKER_API=false
USERNS_PROFILE=""
CAPS_PROFILE=""
for profile in "${FS_PROFILES[@]}" "$CLI_PROFILE"; do
    [[ -z "$profile" ]] && continue

    p_userns=$(jq -r '.userns // empty' "$profile")
    p_caps=$(jq -r '.caps // empty' "$profile")
    p_docker=$(jq -r '.docker_api // false' "$profile")

    if profile_is_project "$profile"; then
        if [[ -n "$p_userns" || -n "$p_caps" || "$p_docker" == "true" ]]; then
            echo "Error: project profile '$profile' may not set 'userns', 'caps' or 'docker_api'." >&2
            echo "  Move it to $CONFIG_DIR/profiles/ if you intend to grant it." >&2
            exit 1
        fi
        continue
    fi

    if [[ "$p_userns" == "full" ]]; then
        USERNS_FULL=true
        USERNS_PROFILE="$profile"
        CAPS_KEEP=true
        CAPS_PROFILE="$profile"
    fi
    if [[ "$p_caps" == "keep" ]]; then
        CAPS_KEEP=true
        CAPS_PROFILE="$profile"
    fi
    if [[ "$p_docker" == "true" ]]; then
        DOCKER_API=true
    fi
done

if [[ "$USERNS_FULL" == "true" && -z "$NET_PROFILE" ]]; then
    echo "Error: profile '$USERNS_PROFILE' sets \"userns\": \"full\", which requires networking. Add --net <profile>." >&2
    exit 1
fi

if [[ "$CAPS_KEEP" == "true" ]]; then
    echo "Warning: profile '$(basename "$CAPS_PROFILE" .json)' retains capabilities — this session's" >&2
    echo "  ro mounts and egress firewall are NOT enforceable against code running inside it." >&2
fi

# Session Initialization
SESSION_ID=$(date +%Y%m%d-%H%M%S)-$(printf "%04x" $RANDOM)
SESSION_DIR="$STATE_DIR/$SESSION_ID"
mkdir -p "$SESSION_DIR/fs"
mkdir -p "$SESSION_DIR/tmp"

# Persistent store for cli-profile copy mounts, keyed by profile name AND
# the external invoking directory. `--cli claude` in ~/projA and in
# ~/projB get separate stores, because the fs profiles normalize every
# project to a fixed in-sandbox cwd (/workspace, /home/user/src), which
# would otherwise pile all projects' sessions into one bucket. The profile
# name comes from the resolved path, so `--cli claude`, `--cli cli/claude`
# and `--cli ./claude.json` share the name component. The cwd slug is $PWD
# (the value recorded as "cwd" in session.json) with slashes dashed.
# Safe to live under STATE_DIR: --list-sessions only considers directories
# with a session.json, which this never has.
CLI_PROFILE_NAME=""
CLI_STORE_DIR=""
if [[ -n "$CLI_PROFILE" ]]; then
    CLI_PROFILE_NAME=$(basename "$CLI_PROFILE" .json)
    CLI_STORE_DIR="$STATE_DIR/profiles/cli/$CLI_PROFILE_NAME/$(sbx_copy_path_slug "$PWD")"
fi

# Bwrap Arguments
BWRAP_ARGS=(
    --unshare-ipc
    --unshare-pid
    --unshare-uts
    --unshare-cgroup
    --new-session
    --proc /proc
    --dev /dev
    --tmpfs /tmp
    --tmpfs /run
    --ro-bind /usr /usr
    --ro-bind /opt /opt
    --ro-bind /etc /etc
    --symlink usr/bin /bin
    --symlink usr/lib /lib
    --symlink usr/lib64 /lib64
    --bind "$SESSION_DIR" "$SESSION_DIR"
)

if [[ -n "$NET_PROFILE" ]]; then
    # When networking is enabled, pasta creates the user and net namespaces.
    # bwrap joins them and provides filesystem isolation.
    #
    # pasta maps the host uid to 0 inside the namespace. bwrap does NOT drop
    # inherited capabilities when it is not the namespace's creator, so
    # without an explicit --cap-drop ALL (added below) the payload would run
    # as uid 0 with a full ambient set — able to remount every ro bind rw and
    # to flush the nftables ruleset. nft and dnsmasq now run in launch.sh,
    # outside the sandbox, so nothing in here needs privilege.
    if [[ "$CAPS_KEEP" == "true" ]]; then
        # podman/crun decide rootless-vs-rootful by checking geteuid()==0, not
        # actual privilege. --cap-add ALL above makes the sandboxed process look
        # like real root (uid 0, full capability bits) to podman, so it skips its
        # normal single-UID-mapping fallback and assumes a genuine system gid=5
        # exists for its default devpts mount — which fails with EINVAL, since
        # this is still a single-identity-mapped namespace underneath. These
        # containers/common env vars are the documented override for exactly
        # this case (a process nested in a constrained namespace where EUID==0
        # doesn't mean real privilege): they force podman back onto the correct
        # rootless code path regardless of what geteuid() reports. Confirmed
        # this doesn't touch networking — container egress is still fully
        # gated by this session's own nftables allow-list either way.
        # In userns-full mode these overrides are exactly wrong: there podman
        # MUST run rootful-in-namespace (euid 0 backed by a real multi-UID
        # mapping), and forcing the rootless code path would resurrect the
        # single-UID limitation the outer userns exists to remove.
        if [[ "$USERNS_FULL" != "true" ]]; then
            BWRAP_ARGS+=(
                --setenv _CONTAINERS_USERNS_CONFIGURED done
                --setenv _CONTAINERS_ROOTLESS_UID "$(id -u)"
                --setenv _CONTAINERS_ROOTLESS_GID "$(id -g)"
            )
        fi
    fi
else
    # Without networking, bwrap creates its own namespaces.
    # No --uid/--gid: bwrap defaults to mapping the real UID/GID into the
    # new user namespace, so the sandbox sees the same user/HOME identity
    # as the host (matches what the --net branch already does via pasta).
    BWRAP_ARGS+=(--unshare-user --unshare-net)
fi

# The payload never needs capabilities. Session setup does, but all of it
# now runs outside the sandbox: nft and dnsmasq in launch.sh, inside
# pasta's namespaces and before bwrap starts. So the drop applies to both
# modes.
#
# CAP_SETPCAP is retained deliberately and is the ONLY capability kept.
# It is the privilege the wrapper's setpriv needs to empty the bounding
# set, which bwrap leaves full whenever it JOINS an existing user
# namespace instead of creating one — i.e. the --net path. Dropping it
# here makes setpriv fail with "apply bounding set: Operation not
# permitted" and every session exit 127. CAP_SETPCAP cannot mount,
# configure networking, or change ownership, so holding it across the
# single exec into setpriv is not an escape surface.
#
# The "caps": "keep" opt-out needs --cap-add ALL in BOTH modes, not just
# --net. Where bwrap creates the user namespace itself (the no-net path) it
# hands the payload an empty effective AND bounding set unless told
# otherwise, so omitting the flag here would silently ignore the profile
# field rather than honour it.
if [[ "$CAPS_KEEP" == "true" ]]; then
    BWRAP_ARGS+=(--cap-add ALL)
else
    BWRAP_ARGS+=(--cap-drop ALL --cap-add CAP_SETPCAP)
fi

# Reap the sandbox if sbx itself dies, rather than leaking a detached
# session with no supervisor.
BWRAP_ARGS+=(--die-with-parent)

# --- Virt (podman/qemu) base plumbing ---
# Always applied: adds no attack surface (nested single-UID userns was
# already reachable; masking subuid/subgid only reduces surface). The
# actual device access (/dev/kvm, /dev/net/tun) stays opt-in via the
# podman/qemu fs profiles.
VIRT_DIR="$SESSION_DIR/virt"
mkdir -p "$VIRT_DIR"

if [[ "$USERNS_FULL" == "true" ]]; then
    # userns-full sessions run podman rootful-in-namespace: rootful podman
    # reads graphroot, not rootless_storage_path. Expanded at write time
    # (HOME inside the sandbox equals host HOME). No ignore_chown_errors:
    # ownership is real in this mode (full subordinate-UID range). This
    # store is separate from the single-UID one by design — the ownership
    # layouts are incompatible.
    cat > "$VIRT_DIR/storage.conf" <<CONFEOF
[storage]
driver = "overlay"
graphroot = "$HOME/.local/state/sbx/virt/containers-full"
CONFEOF
else
    # rootless_storage_path expands $HOME using podman's own runtime env (sbx
    # doesn't clear or override HOME, so it resolves to the same value inside
    # the sandbox as outside). Written literally — do not let bash expand it.
    cat > "$VIRT_DIR/storage.conf" <<'CONFEOF'
[storage]
driver = "overlay"
rootless_storage_path = "$HOME/.local/state/sbx/virt/containers"

[storage.options.overlay]
ignore_chown_errors = "true"
CONFEOF
fi

# cgroupfs/disabled are the only values that can work inside bwrap: the
# systemd cgroup manager needs a user systemd instance over dbus, which
# can't exist here (--unshare-ipc, /run is tmpfs).
cat > "$VIRT_DIR/containers.conf" <<'CONFEOF'
[containers]
cgroups = "disabled"

[engine]
cgroup_manager = "cgroupfs"
events_logger = "file"
CONFEOF

if [[ "$USERNS_FULL" == "true" ]]; then
    # Podman's implicit default "podman" bridge network ships with
    # dns_enabled=false; only explicitly-created custom networks default
    # to DNS-enabled (verified empirically — podman network inspect
    # shows dns_enabled:true only for a network made via `podman network
    # create`). aardvark-dns for containers on this network inherits the
    # sandbox's own /etc/resolv.conf (127.0.0.1 -> sbx's dnsmasq) as its
    # upstream, so routing containers through it is what lets
    # hostname-based `allow` entries populate the forward chain's
    # allowed4 set (see USERNS_NET_SETUP below, which creates this
    # network). Without this, container DNS goes straight to public
    # resolvers, which the forward chain correctly drops (no egress
    # leak) but which also means hostname-based allow entries never
    # resolve for containers — only CIDR-based allow entries work.
    cat >> "$VIRT_DIR/containers.conf" <<'CONFEOF2'

[network]
default_network = "sbx0"
CONFEOF2
fi

: > "$VIRT_DIR/empty"

BWRAP_ARGS+=(
    --tmpfs /var
    --dir /var/tmp
    --dir "/run/user/$(id -u)"
    --ro-bind /sys /sys
    --ro-bind "$VIRT_DIR/empty" /etc/subuid
    --ro-bind "$VIRT_DIR/empty" /etc/subgid
    --setenv XDG_RUNTIME_DIR "/run/user/$(id -u)"
    --setenv CONTAINERS_STORAGE_CONF "$VIRT_DIR/storage.conf"
    --setenv CONTAINERS_CONF "$VIRT_DIR/containers.conf"
)

# Docker compat: a `docker` CLI shim (execs podman) and DOCKER_HOST are
# always on — both are free (no processes; $SESSION_DIR is already bound
# into every sandbox). The socket DOCKER_HOST points at only exists when
# a profile sets "docker_api": true (see wrapper generation). The path is
# pinned to the sbx-computed /run/user/<uid> — deliberately NOT
# $XDG_RUNTIME_DIR, which a profile may override and silently diverge
# from DOCKER_HOST.
PODMAN_SOCK="/run/user/$(id -u)/podman/podman.sock"
mkdir -p "$SESSION_DIR/bin"
cat > "$SESSION_DIR/bin/docker" <<'SHIMEOF'
#!/bin/sh
exec podman "$@"
SHIMEOF
chmod +x "$SESSION_DIR/bin/docker"
BWRAP_ARGS+=(--setenv DOCKER_HOST "unix://$PODMAN_SOCK")

COPY_MOUNTS=()     # fs-profile copy mounts,  "source:dest" — ephemeral
CLI_COPY_MOUNTS=() # cli-profile copy mounts, "source:dest" — persistent

apply_mounts() {
    local profile="$1" kind="${2:-fs}"
    # Use jq to extract mounts
    mounts=$(jq -c '.mounts[]?' "$profile")
    [[ -z "$mounts" ]] && return

    while IFS= read -r m; do
        [[ -z "$m" ]] && continue
        source=$(echo "$m" | jq -r '.source' | envsubst)
        source=$(realpath -m "$source")
        dest=$(echo "$m" | jq -r '.dest' | envsubst)
        perm=$(echo "$m" | jq -r '.perm')

        # rw mounts may point at a persistent host directory that doesn't
        # exist yet (e.g. first-ever use of a profile's storage dir).
        if [[ "$perm" == "rw" && ! -e "$source" ]]; then
            mkdir -p "$source"
        fi

        # Ensure parent directories exist in the sandbox
        parent=$(dirname "$dest")
        if [[ "$parent" != "/" ]]; then
            IFS='/' read -ra ADDR <<< "$parent"
            curr=""
            for i in "${ADDR[@]}"; do
                if [[ -n "$i" ]]; then
                    curr="$curr/$i"
                    BWRAP_ARGS+=(--dir "$curr")
                fi
            done
        fi

        case "$perm" in
            ro)
                BWRAP_ARGS+=(--ro-bind "$source" "$dest")
                ;;
            rw)
                BWRAP_ARGS+=(--bind "$source" "$dest")
                ;;
            dev)
                BWRAP_ARGS+=(--dev-bind "$source" "$dest")
                ;;
            copy)
                # `copy` means different things by profile type: ephemeral
                # snapshot in an fs profile, persistent overlay in a cli
                # profile. See docs/superpowers/specs/2026-07-23-persistent-cli-profiles-design.md
                if [[ "$kind" == "cli" ]]; then
                    CLI_COPY_MOUNTS+=("$source:$dest")
                else
                    COPY_MOUNTS+=("$source:$dest")
                fi
                ;;
        esac
    done <<< "$mounts"
}

for profile in "${FS_PROFILES[@]}"; do
    apply_mounts "$profile" fs
done

if [[ -n "$CLI_PROFILE" ]]; then
    apply_mounts "$CLI_PROFILE" cli
fi

# Pre-population for copy mounts. fs-profile mounts are seeded from the
# host alone; cli-profile mounts additionally overlay the profile's
# persistent store, so the previous session's changes come back.
mkdir -p "$SESSION_DIR/tmp_mounts"

seed_copy_mount() {
    local src="$1" dst="$2" store="$3"
    local mount_id tmp_src
    mount_id=$(sbx_copy_mount_id "$dst")
    tmp_src="$SESSION_DIR/tmp_mounts/$mount_id"

    sbx_copy_seed "$src" "$tmp_src" "$store"

    if [[ -d "$src" ]]; then
        BWRAP_ARGS+=(--tmpfs "$dst")
        BWRAP_ARGS+=(--bind "$tmp_src" "$dst")
    elif [[ -f "$src" ]]; then
        BWRAP_ARGS+=(--bind "$tmp_src/$(basename "$src")" "$dst")
    fi
}

for cm in "${COPY_MOUNTS[@]}"; do
    seed_copy_mount "${cm%%:*}" "${cm#*:}" ""
done

for cm in "${CLI_COPY_MOUNTS[@]}"; do
    dst="${cm#*:}"
    seed_copy_mount "${cm%%:*}" "$dst" "$CLI_STORE_DIR/$(sbx_copy_mount_id "$dst")"
done

# Parse Environment and Working Directory from all profiles
WORKDIR=""
SANDBOX_PATH=""
for profile in "${FS_PROFILES[@]}" "$CLI_PROFILE"; do
    [[ -z "$profile" ]] && continue
    
    # Working Directory (last one wins)
    WDIR=$(jq -r '.workingDirectory // empty' "$profile" | envsubst)
    [[ -n "$WDIR" ]] && WORKDIR="$WDIR"

    # Environment Variables
    while IFS='=' read -r key value; do
        if [[ -n "$key" ]]; then
            val=$(echo "$value" | envsubst)
            [[ "$key" == "PATH" ]] && SANDBOX_PATH="$val"
            BWRAP_ARGS+=(--setenv "$key" "$val")
        fi
    done < <(jq -r '.env // {} | to_entries[]? | "\(.key)=\(.value)"' "$profile")
done

if [[ -n "$WORKDIR" ]]; then
    BWRAP_ARGS+=(--chdir "$WORKDIR")
fi

# Handle CLI-specific 'path' prepending
DEFAULT_PATH="/usr/local/bin:/usr/bin:/bin"
if [[ -n "$CLI_PROFILE" ]]; then
    EXTRA_PATHS=$(jq -r '.path[]?' "$CLI_PROFILE" | envsubst | paste -sd: -)
    if [[ -n "$EXTRA_PATHS" ]]; then
        if [[ -n "$SANDBOX_PATH" ]]; then
            SANDBOX_PATH="$EXTRA_PATHS:$SANDBOX_PATH:$DEFAULT_PATH"
        else
            SANDBOX_PATH="$EXTRA_PATHS:$DEFAULT_PATH"
        fi
    else
        [[ -z "$SANDBOX_PATH" ]] && SANDBOX_PATH="$DEFAULT_PATH"
    fi
else
    [[ -z "$SANDBOX_PATH" ]] && SANDBOX_PATH="$DEFAULT_PATH"
fi
# $SESSION_DIR/bin holds the docker shim; first on PATH so `docker` always
# resolves to it (the host docker socket is never reachable in a sandbox).
BWRAP_ARGS+=(--setenv PATH "$SESSION_DIR/bin:$SANDBOX_PATH")

# Network Setup
if [[ -n "$NET_PROFILE" ]]; then
    # Detect host network settings for manual injection if pasta auto-config fails
    HOST_IFACE=$(ip route show default | awk '{print $5}' | head -n 1)
    HOST_IP=$(ip addr show "$HOST_IFACE" | grep "inet " | awk '{print $2}' | cut -d/ -f1 | head -n 1)
    HOST_GW=$(ip route show default | awk '{print $3}' | head -n 1)
    HOST_MASK=$(ip addr show "$HOST_IFACE" | grep "inet " | awk '{print $2}' | cut -d/ -f2 | head -n 1)
    
    export HOST_IFACE HOST_IP HOST_GW HOST_MASK

    DNS_DIR="$SESSION_DIR/dns"
    mkdir -p "$DNS_DIR"

    # DNS upstream must be a plain IP — dnsmasq does not speak DoH stamps.
    # If the profile supplies a stamp or leaves dns empty, fall back to Cloudflare.
    DNS_UPSTREAM=$(jq -r '.dns // empty' "$NET_PROFILE")
    if ! [[ "$DNS_UPSTREAM" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
        DNS_UPSTREAM="1.1.1.1"
    fi

    # Build per-domain dnsmasq CLI flags from the hostname entries in allow[].
    # Strips leading '*.' — dnsmasq --server=/domain/up matches the apex + all subs.
    # --nftset auto-populates the nftables set from every A-record answer,
    # replacing the old bespoke Python sniffer with zero custom code.
    ALLOW_ALL=false
    DNSMASQ_DOMAIN_ARGS=()
    while IFS= read -r entry; do
        [[ -z "$entry" ]] && continue
        if [[ "$entry" == "*" ]]; then
            ALLOW_ALL=true
            break
        fi
        domain="${entry#\*.}"
        DNSMASQ_DOMAIN_ARGS+=("--server=/$domain/$DNS_UPSTREAM")
        DNSMASQ_DOMAIN_ARGS+=("--nftset=/$domain/inet#sbx_filter#allowed4")
    done < <(jq -r '.allow[]? | select(type == "string" and test("^[a-zA-Z*]"))' "$NET_PROFILE")

    # First non-CIDR hostname for the readiness probe.
    TEST_DOMAIN=$(jq -r '.allow[]? | select(type=="string" and test("^[a-zA-Z]"))' "$NET_PROFILE" | head -n1)

    # resolv.conf points into the sandbox at our dnsmasq instance.
    printf 'nameserver 127.0.0.1\n' > "$DNS_DIR/resolv.conf"
    BWRAP_ARGS+=(--ro-bind "$DNS_DIR/resolv.conf" /etc/resolv.conf)

    # nftables egress rules — default-drop, permit only:
    #   lo / established / DNS to 127.0.0.1 / upstream DNS on port 53
    #   explicit CIDRs from profile / @allowed4 (auto-populated by dnsmasq --nftset)
    # Raw IP connections and all IPv6 egress are dropped.
    # Shared egress accept rules, emitted into both the output chain
    # (process-originated traffic) and the forward chain. The forward
    # chain exists because rootful podman under userns:full uses the
    # netavark bridge backend: bridge-forwarded container traffic
    # traverses the kernel forward hook, never output, so an output-only
    # table would leave podman-full container egress completely ungated.
    emit_egress_allow_rules() {
        # Explicit CIDRs from the profile (any port).
        jq -r '.allow[]? | select(test("^[0-9]"))' "$NET_PROFILE" | while read -r cidr; do
            [[ -z "$cidr" ]] && continue
            echo "        ip daddr $cidr accept"
        done

        # Destinations resolved for allowed domains, gated by the port list.
        if [[ "$ALLOW_ALL" == "true" ]] || jq -e '.ports[]? | select(. == "*")' "$NET_PROFILE" >/dev/null 2>&1; then
            echo "        ip daddr @allowed4 accept"
        else
            ports=$(jq -r '.ports[]?' "$NET_PROFILE" | paste -sd, -)
            if [[ -n "$ports" ]]; then
                echo "        ip daddr @allowed4 tcp dport { $ports } accept"
                echo "        ip daddr @allowed4 udp dport { $ports } accept"
            else
                # Hostnames allowed but no ports specified -> default to web.
                echo "        ip daddr @allowed4 tcp dport { 80, 443 } accept"
            fi
        fi
    }

    NFT_RULES="$DNS_DIR/rules.nft"
    {
        echo "table inet sbx_filter {"
        echo "    set allowed4 {"
        echo "        type ipv4_addr"
        echo "        flags timeout"
        echo "    }"
        echo "    chain output {"
        echo "        type filter hook output priority 0; policy drop;"
        echo "        oif \"lo\" accept"
        echo "        ct state established,related accept"
        echo "        ip daddr 127.0.0.1 udp dport 53 accept"
        echo "        ip daddr 127.0.0.1 tcp dport 53 accept"
        echo "        ip daddr $DNS_UPSTREAM udp dport 53 accept"
        echo "        ip daddr $DNS_UPSTREAM tcp dport 53 accept"

        emit_egress_allow_rules

        echo "        meta nfproto ipv6 drop"
        echo "    }"

        # Forward chain: gates bridge-forwarded container egress (netavark,
        # used by rootful podman under userns:full). Deliberately omits the
        # lo/DNS-to-127.0.0.1/DNS-to-upstream accepts above: container->
        # aardvark DNS is delivered via the input hook, and aardvark's own
        # upstream queries originate from a session process and hit output.
        echo "    chain forward {"
        echo "        type filter hook forward priority 0; policy drop;"
        echo "        ct state established,related accept"
        emit_egress_allow_rules
        echo "        meta nfproto ipv6 drop"
        echo "    }"

        echo "}"
    } > "$NFT_RULES"
fi

# Session State Persistence
cat > "$SESSION_DIR/session.json" <<EOF
{
    "id": "$SESSION_ID",
    "cwd": "$PWD",
    "fs_profiles": $(printf '%s\n' "${FS_PROFILES[@]}" | jq -R . | jq -s .),
    "net_profile": $([[ -n "$NET_PROFILE" ]] && jq -R . <<< "$NET_PROFILE" || echo "null"),
    "cli_profile": $([[ -n "$CLI_PROFILE" ]] && jq -R . <<< "$CLI_PROFILE" || echo "null")
}
EOF

# GUI Setup (xpra virtual display)
if [[ "$GUI_FLAG" == "true" ]]; then
    if ! command -v xpra >/dev/null 2>&1; then
        echo "Error: xpra is not installed. Cannot use --gui mode." >&2
        exit 1
    fi

    # Find a free X11 display slot
    DISPLAY_NUM=100
    while [[ -S "/tmp/.X11-unix/X$DISPLAY_NUM" ]]; do
        DISPLAY_NUM=$((DISPLAY_NUM + 1))
    done
    XPRA_DISPLAY=":$DISPLAY_NUM"
    XPRA_LOG="$SESSION_DIR/xpra.log"

    echo "Starting xpra on display $XPRA_DISPLAY..."
    xpra start "$XPRA_DISPLAY" \
        --daemon=yes \
        --log-file="$XPRA_LOG" \
        --mdns=no \
        --notifications=no \
        --bell=no \
        --speaker=disabled \
        --microphone=disabled \
        > /dev/null 2>&1

    # Wait for the virtual X11 socket to appear
    X11_SOCK="/tmp/.X11-unix/X$DISPLAY_NUM"
    echo -n "Waiting for display"
    XPRA_READY=false
    for i in {1..40}; do
        if [[ -S "$X11_SOCK" ]]; then
            XPRA_READY=true
            break
        fi
        sleep 0.25
        echo -n "."
    done
    echo

    if [[ "$XPRA_READY" != "true" ]]; then
        echo "Error: xpra display $XPRA_DISPLAY failed to start. Check $XPRA_LOG" >&2
        xpra stop "$XPRA_DISPLAY" >/dev/null 2>&1 || true
        exit 1
    fi

    # Build a session Xauthority cookie for the display.
    # xpra writes its cookie to the host Xauthority keyed to the host hostname,
    # but the sandbox runs under a different hostname (e.g. pasta-<host> when
    # networking is on, or no UTS name otherwise). We rewrite the cookie's
    # address family to FamilyWild (ffff) so it matches from any hostname.
    HOST_XAUTH="${XAUTHORITY:-$HOME/.Xauthority}"
    SBX_XAUTH="$SESSION_DIR/Xauthority"
    rm -f "$SBX_XAUTH"

    # The cookie may lag slightly behind the socket; retry briefly.
    for i in {1..20}; do
        if xauth -f "$HOST_XAUTH" nlist "$XPRA_DISPLAY" 2>/dev/null | grep -q .; then
            break
        fi
        sleep 0.25
    done

    if xauth -f "$HOST_XAUTH" nlist "$XPRA_DISPLAY" 2>/dev/null \
        | sed -e 's/^..../ffff/' \
        | xauth -f "$SBX_XAUTH" nmerge - 2>/dev/null; then
        : # cookie installed
    else
        echo "Warning: could not build X11 auth cookie; GUI apps may fail with auth errors." >&2
    fi

    # Expose the X11 socket and auth cookie inside the sandbox
    BWRAP_ARGS+=(--dir /tmp/.X11-unix)
    BWRAP_ARGS+=(--bind "$X11_SOCK" "/tmp/.X11-unix/X$DISPLAY_NUM")
    BWRAP_ARGS+=(--setenv DISPLAY "$XPRA_DISPLAY")
    if [[ -f "$SBX_XAUTH" ]]; then
        BWRAP_ARGS+=(--ro-bind "$SBX_XAUTH" /tmp/.sbx-Xauthority)
        BWRAP_ARGS+=(--setenv XAUTHORITY /tmp/.sbx-Xauthority)
    fi
    # Prevent MIT-SHM errors (IPC is unshared, so SHM won't work)
    BWRAP_ARGS+=(--setenv LIBGL_ALWAYS_INDIRECT 1)

    GUI_MODE=true
    echo "GUI display $XPRA_DISPLAY is ready."
    echo "  Attach viewer : xpra attach $XPRA_DISPLAY"
    echo "  Stop display  : xpra stop $XPRA_DISPLAY"
fi

# Teardown Logic
teardown() {
    echo "Tearing down session $SESSION_ID..."
    
    # Egress for copy mounts. fs-profile mounts land in this session's
    # fs/ directory; cli-profile mounts land in the profile's persistent
    # store (keyed by profile + launch dir), where the next --cli session
    # from the same directory picks them up. The diff baseline is the host
    # source in BOTH cases — not for survival (write-back never prunes the
    # store, so a file written in an earlier session persists regardless of
    # baseline) but so the store stays a minimal delta from the user's real
    # config rather than a full mirror of it.
    for cm in "${COPY_MOUNTS[@]}"; do
        src="${cm%%:*}"
        dst="${cm#*:}"
        mount_id=$(sbx_copy_mount_id "$dst")
        sbx_copy_writeback "$src" "$SESSION_DIR/tmp_mounts/$mount_id" "$SESSION_DIR/fs/$mount_id"
    done

    for cm in "${CLI_COPY_MOUNTS[@]}"; do
        src="${cm%%:*}"
        dst="${cm#*:}"
        mount_id=$(sbx_copy_mount_id "$dst")
        sbx_copy_writeback "$src" "$SESSION_DIR/tmp_mounts/$mount_id" "$CLI_STORE_DIR/$mount_id"
    done

    rm -rf "$SESSION_DIR/tmp_mounts"
    rm -f "$SESSION_DIR/session.sock" "$SESSION_DIR/wrapper.sh"

    if [[ -n "$XPRA_DISPLAY" ]]; then
        echo "Stopping xpra display $XPRA_DISPLAY..."
        xpra stop "$XPRA_DISPLAY" >/dev/null 2>&1 || true
    fi

    echo "Session $SESSION_ID finished. Changes saved to $SESSION_DIR/fs"
}

trap teardown EXIT

# Execution
SESSION_SOCK="$SESSION_DIR/session.sock"
LAUNCH_SCRIPT="$SESSION_DIR/launch.sh"
CAT_WRAPPER="$SESSION_DIR/wrapper.sh"
DNSMASQ_BIN=$(which dnsmasq)

# Opt-in podman docker-API service ("docker_api": true in any profile).
# Startup failure is a WARNING, not fatal — the docker CLI shim works
# without the service (contrast: nft/dnsmasq failures stay hard errors;
# egress safety is never best-effort). Killed when the command exits.
DOCKER_API_START=""
DOCKER_API_STOP=""
if [[ "$DOCKER_API" == "true" ]]; then
    DOCKER_API_START=$(cat <<APIEOF
mkdir -p "$(dirname "$PODMAN_SOCK")"
podman system service --time=0 "unix://$PODMAN_SOCK" > "$SESSION_DIR/podman-api.log" 2>&1 &
PODMAN_API_PID=\$!
for i in {1..10}; do
    [[ -S "$PODMAN_SOCK" ]] && break
    sleep 0.5
done
if [[ ! -S "$PODMAN_SOCK" ]]; then
    echo "Warning: podman API socket did not appear at $PODMAN_SOCK; docker SDK clients will fail (the docker CLI shim still works)." >&2
    cat "$SESSION_DIR/podman-api.log" >&2 || true
fi
APIEOF
)
    DOCKER_API_STOP='[[ -n "$PODMAN_API_PID" ]] && kill $PODMAN_API_PID 2>/dev/null || true'
fi

# userns:full only (which requires --net, enforced earlier): create the
# DNS-enabled "sbx0" network that containers.conf's default_network now
# points at. Idempotent — a repeat "already exists" failure is expected
# and harmless (confirmed: if creation ever failed for a real reason,
# podman fails loudly downstream with "network not found" when a
# container runs, not silently — but stderr is still logged here so the
# actual cause isn't lost). Only reachable via the net-profile wrapper
# below, since userns:full without --net is a hard error before session
# state is even created.
USERNS_NET_SETUP=""
if [[ "$USERNS_FULL" == "true" ]]; then
    USERNS_NET_SETUP="podman network create sbx0 >/dev/null 2>> \"$VIRT_DIR/network-create.log\" || true"
fi

NET_PRELUDE=""
if [[ -n "$NET_PROFILE" ]]; then
    # Serialise per-domain flags for expansion inside the heredoc.
    if [[ "$ALLOW_ALL" == "true" ]]; then
        # Wildcard: forward everything, populate allowed4 for every answer.
        DNSMASQ_DOMAIN_FLAGS="--server=$DNS_UPSTREAM --nftset=//inet#sbx_filter#allowed4"
    else
        DNSMASQ_DOMAIN_FLAGS=$(printf '%s ' "${DNSMASQ_DOMAIN_ARGS[@]}")
    fi

    # Runs in launch.sh: inside pasta's namespaces, before bwrap, with the
    # capabilities nft and dnsmasq need. Everything started here lives
    # outside the sandbox's PID and mount namespaces, so the payload can
    # neither signal dnsmasq nor alter the ruleset.
    NET_PRELUDE=$(cat <<EOF
ip link set lo up >/dev/null 2>&1

# Hard-fail if nftables rules cannot be loaded — never proceed with open egress.
if ! NFT_ERR=\$(nft -f "$NFT_RULES" 2>&1); then
    echo "Error: nftables rules failed to load — aborting." >&2
    echo "  nft: \$NFT_ERR" >&2
    exit 1
fi

# dnsmasq on 127.0.0.1:53.
# All options are CLI flags: AppArmor's usr.sbin.dnsmasq profile restricts
# config-file paths to /etc/dnsmasq.d/*, making arbitrary paths unreadable.
# --conf-file=/dev/null  suppress any host /etc/dnsmasq.conf
# --filter-AAAA          return only A records; IPv6 egress is nft-dropped anyway
# --nftset               auto-populates @allowed4 from A-record answers —
#                        no bespoke sniffer needed
"$DNSMASQ_BIN" \\
    --conf-file=/dev/null \\
    -d \\
    --port=53 \\
    --listen-address=127.0.0.1 \\
    --bind-interfaces \\
    --no-resolv \\
    --no-hosts \\
    --filter-AAAA \\
    $DNSMASQ_DOMAIN_FLAGS \\
    > "$DNS_DIR/dnsmasq.log" 2>&1 &
DNSMASQ_PID=\$!

# The probe must query this session's dnsmasq, but launch.sh sees the host
# /etc/resolv.conf. A throwaway bwrap binds the session resolv.conf so the
# check is accurate and every setup failure still prints before the session
# multiplexer starts.
probe_dns() {
    bwrap --ro-bind /usr /usr --symlink usr/bin /bin --symlink usr/lib /lib \\
        --symlink usr/lib64 /lib64 --ro-bind /etc /etc \\
        --ro-bind "$DNS_DIR/resolv.conf" /etc/resolv.conf \\
        --proc /proc --dev /dev \\
        -- getent ahostsv4 "$TEST_DOMAIN" >/dev/null 2>&1
}

DNS_READY=false
for i in {1..20}; do
    if ! kill -0 \$DNSMASQ_PID 2>/dev/null; then
        echo "Error: dnsmasq failed to start:" >&2
        cat "$DNS_DIR/dnsmasq.log" >&2
        exit 1
    fi
    if [[ -z "$TEST_DOMAIN" ]] || probe_dns; then
        DNS_READY=true
        break
    fi
    sleep 0.5
done
if [[ "\$DNS_READY" != "true" ]]; then
    echo "Error: dnsmasq did not become ready (could not resolve '$TEST_DOMAIN')." >&2
    cat "$DNS_DIR/dnsmasq.log" >&2
    kill \$DNSMASQ_PID 2>/dev/null
    exit 1
fi
EOF
)
fi

# The wrapper is now the payload and nothing else — network setup has moved
# to launch.sh, so both modes generate the same shape.
if [[ "$CAPS_KEEP" == "true" ]]; then
    cat > "$CAT_WRAPPER" <<EOF
#!/bin/bash
$USERNS_NET_SETUP
$DOCKER_API_START
$(printf "%q " "${COMMAND[@]}")
$DOCKER_API_STOP
EOF
else
    # setpriv spends the retained CAP_SETPCAP to empty the bounding set,
    # then execs the payload with every capability set at zero. If setpriv
    # is absent or fails, the exec fails and the payload never runs: the
    # failure mode is closed, not open. exec because a capless session has
    # no docker-API service to stop afterwards. USERNS_NET_SETUP and
    # DOCKER_API_START are both podman operations and are unreachable
    # without capabilities, so they are absent here by construction.
    cat > "$CAT_WRAPPER" <<EOF
#!/bin/bash
exec setpriv --bounding-set=-all --inh-caps=-all --ambient-caps=-all -- \\
    $(printf "%q " "${COMMAND[@]}")
EOF
fi
chmod +x "$CAT_WRAPPER"

# Generate the launch script with properly escaped BWRAP_ARGS.
# pasta runs this inside the session's user and net namespaces, so the
# network prelude lands there — outside every namespace bwrap creates.
{
    echo "#!/bin/bash"
    echo "# Start the sandbox"
    if [[ -n "$NET_PRELUDE" ]]; then
        echo "$NET_PRELUDE"
    fi
} > "$LAUNCH_SCRIPT"

# With networking the script must outlive bwrap to reap dnsmasq, so it
# cannot exec. Without networking there is nothing to clean up.
if [[ -n "$NET_PRELUDE" ]]; then
    printf "bwrap " >> "$LAUNCH_SCRIPT"
else
    printf "exec bwrap " >> "$LAUNCH_SCRIPT"
fi
for arg in "${BWRAP_ARGS[@]}"; do
    printf "%q " "$arg" >> "$LAUNCH_SCRIPT"
done
printf "%q -c %q %q\n" "$SESSION_MUX" "$SESSION_SOCK" "$CAT_WRAPPER" >> "$LAUNCH_SCRIPT"

if [[ -n "$NET_PRELUDE" ]]; then
    # Quoted heredoc: every expansion below belongs to launch.sh, not here.
    cat >> "$LAUNCH_SCRIPT" <<'REAPEOF'
SBX_RC=$?
kill $DNSMASQ_PID 2>/dev/null || true
exit $SBX_RC
REAPEOF
fi

chmod +x "$LAUNCH_SCRIPT"

# --no-map-gw on both calls: pasta otherwise translates the gateway address
# to the host's loopback, which would let the sandbox reach host-local
# services through $HOST_GW without ever traversing a rule that names them.
if [[ -n "$NET_PROFILE" ]]; then
    if [[ "$USERNS_FULL" == "true" ]]; then
        echo "Starting session $SESSION_ID with networking (full userns)..."
        # unshare claims the user's /etc/subuid range up front, via the
        # setuid newuidmap helper — still permitted here because bwrap's
        # no_new_privs only applies further down the chain. pasta must
        # then NOT create its own user namespace (that would discard the
        # multi-UID mapping): --netns-only.
        unshare --map-auto --map-root-user -- \
            pasta -f --config-net --netns-only --no-map-gw --interface "$HOST_IFACE" --no-ndp --no-dhcpv6 --no-ra -a "$HOST_IP" -g "$HOST_GW" -n "$HOST_MASK" -- "$LAUNCH_SCRIPT"
    else
        echo "Starting session $SESSION_ID with networking..."
        pasta -f --config-net --no-map-gw --interface "$HOST_IFACE" --no-ndp --no-dhcpv6 --no-ra -a "$HOST_IP" -g "$HOST_GW" -n "$HOST_MASK" -- "$LAUNCH_SCRIPT"
    fi
else
    echo "Starting session $SESSION_ID..."
    "$LAUNCH_SCRIPT"
fi
