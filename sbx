#!/bin/bash

# sbx - Portable Unprivileged Sandbox Orchestrator

set -e

STATE_DIR="$HOME/.local/state/sbx"
CONFIG_DIR="$HOME/.config/sbx"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# shellcheck source=lib/copy-mounts.sh
source "$SCRIPT_DIR/lib/copy-mounts.sh"

GUI_MODE=false
XPRA_DISPLAY=""

# Ensure state directory exists
mkdir -p "$STATE_DIR"

usage() {
    cat <<EOF
Usage: $(basename "$0") [options] [command]

Options:
  --list-profiles        Show available profiles
  --list-sessions        Show active sessions
  --changes [<id>]       Show what a record mount changed (default: latest)
  --join <session>       Open a new shell inside a running session
                         (--join <session> -- <cmd> runs <cmd> instead)
  --attach <session>     Reattach to a session's original terminal
  --fs <profile>         Apply a filesystem profile (multiple allowed)
  --net <profile>        Apply a network profile (multiple allowed)
  --cli <profile>        Apply a CLI/environment profile
  --host-port <spec>     Reach a host service on 127.0.0.1:<port> from inside.
                         <spec> is <port>[/tcp|/udp]; bare means tcp.
                         (repeatable; implies a network namespace)
  --wd <path>            Start in this directory inside the sandbox
                         (default: launch dir if present, else \$HOME, else /)
  --gui                  Enable isolated GUI via xpra (attach with: xpra attach :<N>)
  -h, --help             Show this help message

Profiles are searched in:
  1. ./.sbx/profiles/
  2. \$HOME/.config/sbx/profiles/
  3. $SCRIPT_DIR/profiles/
EOF
}

resolve_profile() {
    local type="$1"
    local name="$2"

    # If it's a direct path to a file, use it
    if [[ -f "$name" ]]; then
        realpath "$name"
        return 0
    fi
    if [[ -f "$name.json" ]]; then
        realpath "$name.json"
        return 0
    fi

    # Strip the type prefix if it was included (e.g., "cli/dev" -> "dev")
    if [[ "$name" == "$type/"* ]]; then
        name="${name#$type/}"
    fi

    local paths=(
        "./.sbx/profiles/$type/$name.json"
        "$CONFIG_DIR/profiles/$type/$name.json"
        "$SCRIPT_DIR/profiles/$type/$name.json"
    )

    for p in "${paths[@]}"; do
        if [[ -f "$p" ]]; then
            echo "$p"
            return 0
        fi
    done

    echo "Error: Profile '$name' of type '$type' not found." >&2
    exit 1
}

list_profiles() {
    local types=("cli" "fs" "net")
    local sources=(
        "Project:./.sbx/profiles"
        "User:$CONFIG_DIR/profiles"
        "Global:$SCRIPT_DIR/profiles"
    )

    echo "Available Profiles:"
    for type in "${types[@]}"; do
        echo ""
        echo "${type^^} Profiles:"
        local found=0
        for src in "${sources[@]}"; do
            local label="${src%%:*}"
            local path="${src#*:}"
            if [[ -d "$path/$type" ]]; then
                # Use a temporary variable to capture find output to avoid empty lines
                local files
                files=$(find "$path/$type" -name "*.json" | sed "s|$path/$type/||" | sed 's/\.json$//' | sort)
                if [[ -n "$files" ]]; then
                    while IFS= read -r profile; do
                        echo "  $profile ($label)"
                        found=1
                    done <<< "$files"
                fi
            fi
        done
        if [[ $found -eq 0 ]]; then
            echo "  (none)"
        fi
    done
}

# Main Argument Parsing
FS_PROFILES=()
NET_PROFILES=()
CLI_PROFILE=""
WORKDIR=""
HOST_PORTS_TCP=()
HOST_PORTS_UDP=()
COMMAND=()

# Parse one host-port spec: "<port>", "<port>/tcp" or "<port>/udp".
#
# A bare number means TCP. The two protocols are kept as separate lists all
# the way to pasta's -T and -U, which are genuinely independent — forwarding
# a TCP port does not open its UDP twin (verified; pasta only pairs the two
# under "-t auto", which sbx never uses). So a bare "8080" grants TCP and
# nothing else, and reaching a UDP service is always something the profile
# or command line said out loud. To get both, name the port twice.
add_host_port() {
    local spec="$1" origin="$2"
    local port="${spec%%/*}" proto="tcp"
    [[ "$spec" == */* ]] && proto="${spec#*/}"
    proto="${proto,,}"

    if ! [[ "$port" =~ ^[0-9]+$ ]] || (( port < 1 || port > 65535 )); then
        echo "Error: $origin expects <port>[/tcp|/udp] with a port 1-65535, got '$spec'." >&2
        exit 1
    fi
    case "$proto" in
        tcp) HOST_PORTS_TCP+=("$port") ;;
        udp) HOST_PORTS_UDP+=("$port") ;;
        *)   echo "Error: $origin names unknown protocol '$proto' in '$spec' (expected tcp or udp)." >&2
             exit 1 ;;
    esac
}
GUI_FLAG=false
CAPS_KEEP=false

while [[ $# -gt 0 ]]; do
    case "$1" in
        --list-profiles)
            list_profiles
            exit 0
            ;;
        --list-sessions)
            echo "Active Sessions (this directory):"
            for sdir in "$STATE_DIR"/*; do
                if [[ -d "$sdir" && -f "$sdir/session.json" ]]; then
                    # session.json sits inside the session directory, which
                    # is bound rw into the sandbox — treat every field as
                    # attacker-authored and strip control characters before
                    # echoing them to a terminal.
                    scwd=$(jq -r '.cwd' "$sdir/session.json" | tr -d '\000-\037')
                    if [[ "$scwd" == "$PWD" ]]; then
                        sid=$(jq -r '.id' "$sdir/session.json" | tr -d '\000-\037')
                        pid=$(jq -r '.pid // empty' "$sdir/session.json" | tr -d '\000-\037')
                        # Validated, not merely non-empty: an unchecked $pid
                        # reaching kill is a signal sent wherever the sandbox
                        # chose.
                        if [[ "$pid" =~ ^[0-9]+$ ]] && kill -0 "$pid" 2>/dev/null; then
                            echo "  $sid (active, PID: $pid)"
                        else
                            echo "  $sid (inactive)"
                        fi
                    fi
                fi
            done
            exit 0
            ;;
        --changes)
            CHANGES_DIR="$STATE_DIR/changes/$(sbx_copy_path_slug "$PWD")"
            if [[ -n "${2-}" && "$2" != -* ]]; then
                target="$CHANGES_DIR/$2"; shift 2
            else
                target=$(find "$CHANGES_DIR" -mindepth 1 -maxdepth 1 -type d 2>/dev/null |
                         LC_ALL=C sort | tail -n1)
                shift
            fi
            if [[ -z "$target" || ! -d "$target" ]]; then
                echo "No recorded changes for this directory." >&2
                exit 1
            fi
            echo "$target"
            # Paths are attacker-authored (a record mount's contents come
            # from inside the sandbox), so strip control characters before
            # echoing them to a terminal — same reasoning as --list-sessions.
            find "$target" -mindepth 2 -type f -printf '  + %P\n' | tr -d '\000-\037'
            for d in "$target"/*.deleted; do
                [[ -f "$d" ]] || continue
                sed 's/^/  - /' "$d" | tr -d '\000-\037'
            done
            exit 0
            ;;
        --join)
            JOIN_SESSION="$2"
            shift 2
            # A trailing `-- cmd` has to be consumed here: this branch exits
            # before the main loop ever reaches the `--` case.
            JOIN_CMD=()
            if [[ "${1-}" == "--" ]]; then
                shift
                JOIN_CMD=("$@")
            fi
            SDIR="$STATE_DIR/$JOIN_SESSION"
            # -S, not -f: the server's rendezvous point is a unix socket,
            # which is never a regular file.
            if [[ ! -d "$SDIR" || ! -S "$SDIR/tmux.sock" ]]; then
                echo "Error: Session '$JOIN_SESSION' not found or no socket available." >&2
                exit 1
            fi
            # Inline check, not require_tools: that function is defined
            # further down and does not exist yet during argument parsing.
            if ! command -v tmux >/dev/null 2>&1; then
                echo "Error: sbx requires tmux, which is not on PATH." >&2
                exit 1
            fi
            # No command means an interactive shell, matching the default
            # sbx runs when launched with no command at all.
            if [[ ${#JOIN_CMD[@]} -eq 0 ]]; then
                JOIN_CMD=("/bin/bash")
            fi
            # Everything --join needs to know about the session comes from
            # this sidecar. It deliberately does NOT live in $SESSION_DIR:
            # that directory is bound rw into the sandbox, so session.json
            # and any generated script in it are attacker-authored as far as
            # the host is concerned. $STATE_DIR itself is masked by a
            # --tmpfs inside the sandbox with only $SESSION_DIR bound back
            # in, so a file at this path is unreachable from inside.
            # Absent means the session was not launched by this sbx: fail
            # closed rather than guess at its capability policy.
            JOIN_META="$STATE_DIR/$JOIN_SESSION.join.json"
            if [[ ! -f "$JOIN_META" ]]; then
                echo "Error: Session '$JOIN_SESSION' has no join metadata; it was not started by this version of sbx." >&2
                exit 1
            fi
            JOIN_PATH=$(jq -r '.path' "$JOIN_META")
            JOIN_WD=$(jq -r '.workdir' "$JOIN_META")
            # Held for the whole life of the join, and released by the kernel
            # when this process finally exits. teardown() takes the same lock
            # exclusively before copy-writeback, which is what makes
            # "writeback never overlaps a live join" actually true: the
            # in-sandbox wait loop cannot guarantee it on its own, because
            # the payload can delete the socket or run `tmux kill-server`.
            # The fd survives the exec below on purpose.
            JOIN_LOCK="$STATE_DIR/$JOIN_SESSION.joinlock"
            if exec 9>>"$JOIN_LOCK"; then
                flock -s 9 || echo "Warning: could not lock $JOIN_LOCK; teardown may not wait for this join." >&2
            fi
            # new-session, NOT attach: a second client on the SAME session
            # would mirror the payload's terminal, which is exactly the
            # behaviour this flag exists to stop doing. A new session in the
            # same server is an independent client with its own pty and its
            # own size, and the server forks it.
            #
            # No capability drop here, and no on-disk wrapper to hold one:
            # the drop happens once, at the top, where launch.sh starts
            # session.sh under setpriv (see the comment there). The tmux
            # server is therefore already capless and everything it forks —
            # this join, and equally new-window/split-window/run-shell —
            # inherits an empty bounding set by construction. Re-applying
            # setpriv here would in fact fail with EPERM, since emptying a
            # bounding set needs the CAP_SETPCAP that is already gone.
            #
            # env PATH: tmux copies the *client's* PATH into a spawned pane
            # regardless of `update-environment ''`, so the host's PATH would
            # otherwise reach every join. /usr/bin/env by absolute path for
            # the same reason — it must not be resolved through that PATH.
            # -c: without it tmux uses the host client's cwd, so a join would
            # ignore the session's --wd. A directory that does not exist
            # inside the sandbox makes tmux fall back to $HOME, which is the
            # same default the payload gets.
            exec tmux -S "$SDIR/tmux.sock" new-session -c "$JOIN_WD" -- \
                /usr/bin/env "PATH=$JOIN_PATH" "${JOIN_CMD[@]}"
            ;;
        --attach)
            ATTACH_SESSION="$2"
            shift 2
            SDIR="$STATE_DIR/$ATTACH_SESSION"
            if [[ ! -d "$SDIR" || ! -S "$SDIR/tmux.sock" ]]; then
                echo "Error: Session '$ATTACH_SESSION' not found or no socket available." >&2
                exit 1
            fi
            if ! command -v tmux >/dev/null 2>&1; then
                echo "Error: sbx requires tmux, which is not on PATH." >&2
                exit 1
            fi
            # This one really is mirroring, deliberately and by name: it is
            # the way back to a payload you detached from. --join is the
            # non-mirroring door; without this, detaching the main session
            # would lock you out of a still-running payload for good.
            exec tmux -S "$SDIR/tmux.sock" attach -t main
            ;;
        --fs)
            FS_PROFILES+=("$(resolve_profile fs "$2")")
            shift 2
            ;;
        --net)
            NET_PROFILES+=("$(resolve_profile net "$2")")
            shift 2
            ;;
        --cli)
            CLI_PROFILE="$(resolve_profile cli "$2")"
            shift 2
            ;;
        --host-port)
            add_host_port "$2" "--host-port"
            shift 2
            ;;
        --wd)
            # envsubst for parity with every other path sbx accepts
            # (mounts, env, path), so '$HOME/src' works whether it reaches
            # us quoted from a script or expanded by the caller's shell.
            WORKDIR="$(echo "$2" | envsubst)"
            shift 2
            ;;
        --)
            shift
            COMMAND=("$@")
            break
            ;;
        --gui)
            GUI_FLAG=true
            shift
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            if [[ ${#COMMAND[@]} -eq 0 ]]; then
                COMMAND=("$@")
                break
            else
                break
            fi
            ;;
    esac
done

if [[ ${#COMMAND[@]} -eq 0 ]]; then
    COMMAND=("/bin/bash")
fi

# True when a resolved profile path lies inside the launch directory's
# .sbx tree — i.e. it was supplied by the project rather than by the user.
profile_is_project() {
    local abs proj
    abs=$(realpath -m "$1")
    proj=$(realpath -m "$PWD/.sbx")
    [[ "$abs" == "$proj/"* ]]
}

# A version-controlled project directory is untrusted input: it can ship
# .sbx/profiles that mount anything anywhere, authored by whoever wrote the
# repository. Using one is a decision the user makes explicitly, outside the
# repository.
#
# A project profile that git does not track is treated as the user's own
# scratch config — it cannot have arrived via clone or pull, so there is
# nobody else to distrust and no prompt is raised. (Tracked-but-uncommitted
# counts as version-controlled: once it is in the index it travels.)
confirm_project_profile() {
    local profile="$1"
    profile_is_project "$profile" || return 0
    [[ "${SBX_TRUST_PROJECT_PROFILES:-}" == "1" ]] && return 0
    git -C "$PWD" ls-files --error-unmatch "$profile" >/dev/null 2>&1 || return 0

    local remote="" rname=""
    rname=$(git -C "$PWD" remote 2>/dev/null | head -n1)
    if [[ -n "$rname" ]]; then
        remote=$(git -C "$PWD" remote get-url "$rname" 2>/dev/null || true)
    fi

    {
        echo ""
        echo "This launch would use a profile tracked by the project's git repository:"
        echo "  $profile"
        if [[ -n "$remote" ]]; then
            echo ""
            echo "  The repo has remote $remote — this profile was authored by"
            echo "  whoever wrote that repository, not by you."
        fi
        echo ""
        sed 's/^/  | /' "$profile"
        echo ""
    } >&2

    if [[ ! -t 0 ]]; then
        echo "Error: refusing to use a project profile non-interactively." >&2
        echo "  Set SBX_TRUST_PROJECT_PROFILES=1 to allow it." >&2
        exit 1
    fi

    local answer=""
    printf "Use this project profile? [y/N] " >&2
    read -r answer < /dev/tty
    if [[ "$answer" != "y" && "$answer" != "Y" ]]; then
        echo "Aborted." >&2
        exit 1
    fi
}

for profile in "${FS_PROFILES[@]}" "$CLI_PROFILE" "${NET_PROFILES[@]}"; do
    [[ -z "$profile" ]] && continue
    confirm_project_profile "$profile"
done

# Same reasoning for the rest of the toolchain. bwrap in particular used to
# be discovered only when the generated launch.sh tried to exec it, which
# reported nothing but "bwrap: not found" and exit 127 — after a session
# directory, an xpra display and a pasta namespace had already been built.
# The --net tools are checked only when a net profile is in play.
require_tools() {
    local missing=() tool
    for tool in "$@"; do
        command -v "$tool" >/dev/null 2>&1 || missing+=("$tool")
    done
    [[ ${#missing[@]} -eq 0 ]] && return 0

    echo "Error: sbx requires ${missing[*]}, which $([[ ${#missing[@]} -eq 1 ]] && echo "is" || echo "are") not on PATH." >&2
    for tool in "${missing[@]}"; do
        case "$tool" in
            bwrap)    echo "  bwrap    — Debian/Ubuntu: apt install bubblewrap   Arch: pacman -S bubblewrap" >&2 ;;
            pasta)    echo "  pasta    — Debian/Ubuntu: apt install passt        Arch: pacman -S passt" >&2 ;;
            nft)      echo "  nft      — Debian/Ubuntu: apt install nftables     Arch: pacman -S nftables" >&2 ;;
            dnsmasq)  echo "  dnsmasq  — Debian/Ubuntu: apt install dnsmasq      Arch: pacman -S dnsmasq" >&2 ;;
            jq)       echo "  jq       — Debian/Ubuntu: apt install jq           Arch: pacman -S jq" >&2 ;;
            envsubst) echo "  envsubst — Debian/Ubuntu: apt install gettext-base Arch: pacman -S gettext" >&2 ;;
            setpriv)  echo "  setpriv  — Debian/Ubuntu: apt install util-linux   Arch: pacman -S util-linux" >&2 ;;
            flock)    echo "  flock    — Debian/Ubuntu: apt install util-linux   Arch: pacman -S util-linux" >&2 ;;
            tmux)     echo "  tmux     — Debian/Ubuntu: apt install tmux        Arch: pacman -S tmux" >&2 ;;
        esac
    done
    exit 1
}

require_tools bwrap tmux jq envsubst setpriv flock
if [[ ${#NET_PROFILES[@]} -gt 0 ]]; then
    require_tools pasta nft dnsmasq
fi

# --- Profile feature-field scan (phase 2 virt) ---
# Optional fields honored in any applied fs/cli profile:
#   "userns": "full"    -> run the whole session inside an outer user
#                          namespace carrying the user's full subordinate-
#                          UID range (multi-UID podman). Requires --net.
#                          Implies "caps": "keep".
#   "caps": "keep"      -> retain capabilities inside the sandbox. Needed
#                          for nested user namespaces (podman), and it
#                          costs the ro-mount and firewall guarantees.
#   "docker_api": true  -> start a podman docker-API socket for the session.
#
# None of these are honored from a project-supplied profile: a repository
# must never be able to talk its way back to the pre-hardening boundary,
# with or without the interactive confirmation added elsewhere.
USERNS_FULL=false
DOCKER_API=false
USERNS_PROFILE=""
CAPS_PROFILE=""
for profile in "${FS_PROFILES[@]}" "$CLI_PROFILE"; do
    [[ -z "$profile" ]] && continue

    p_userns=$(jq -r '.userns // empty' "$profile")
    p_caps=$(jq -r '.caps // empty' "$profile")
    p_docker=$(jq -r '.docker_api // false' "$profile")

    if profile_is_project "$profile"; then
        if [[ -n "$p_userns" || -n "$p_caps" || "$p_docker" == "true" ]]; then
            echo "Error: project profile '$profile' may not set 'userns', 'caps' or 'docker_api'." >&2
            echo "  Move it to $CONFIG_DIR/profiles/ if you intend to grant it." >&2
            exit 1
        fi
        continue
    fi

    if [[ "$p_userns" == "full" ]]; then
        USERNS_FULL=true
        USERNS_PROFILE="$profile"
        CAPS_KEEP=true
        CAPS_PROFILE="$profile"
    fi
    if [[ "$p_caps" == "keep" ]]; then
        CAPS_KEEP=true
        CAPS_PROFILE="$profile"
    fi
    if [[ "$p_docker" == "true" ]]; then
        DOCKER_API=true
    fi
done

if [[ "$USERNS_FULL" == "true" && ${#NET_PROFILES[@]} -eq 0 ]]; then
    echo "Error: profile '$USERNS_PROFILE' sets \"userns\": \"full\", which requires networking. Add --net <profile>." >&2
    exit 1
fi

# --- Host-service access ---
# Ports named here are forwarded by pasta from the host's loopback into the
# sandbox's loopback at the same number, so a host service on 127.0.0.1:8080
# answers at 127.0.0.1:8080 inside. Ports NOT named are not forwarded.
#
# This has to be explicit. pasta's default is -T auto, which forwards every
# port bound on the host — including ports bound after the session starts,
# and ports bound by other users — so an --net sandbox could reach every
# host-local service without a single rule naming it. sbx passes an explicit
# list (or "none") instead, which is what makes host access an allow-list
# rather than an accident. It is also what stops a host service on :53 from
# taking the port this session's dnsmasq needs.
#
# Not honored from a project profile, for the same reason userns/caps/
# docker_api are not: a cloned repository must not be able to open a path
# from its sandbox to a service on the machine running it.
for np in "${NET_PROFILES[@]}"; do
    if profile_is_project "$np"; then
        if [[ "$(jq -r '(.host_ports // []) | length' "$np")" != "0" ]]; then
            echo "Error: project profile '$np' may not set 'host_ports'." >&2
            echo "  Move it to $CONFIG_DIR/profiles/ if you intend to grant it." >&2
            exit 1
        fi
    else
        while IFS= read -r hp; do
            [[ -z "$hp" ]] && continue
            add_host_port "$hp" "profile '$np'"
        done < <(jq -r '.host_ports[]? | tostring' "$np")
    fi
done

# Deduplicate, preserving nothing but the numbers pasta needs.
if [[ ${#HOST_PORTS_TCP[@]} -gt 0 ]]; then
    mapfile -t HOST_PORTS_TCP < <(printf '%s\n' "${HOST_PORTS_TCP[@]}" | sort -n -u)
fi
if [[ ${#HOST_PORTS_UDP[@]} -gt 0 ]]; then
    mapfile -t HOST_PORTS_UDP < <(printf '%s\n' "${HOST_PORTS_UDP[@]}" | sort -n -u)
fi

# A network namespace is needed for a net profile OR for host-port access.
# The second case is the no-internet one: pasta supplies the loopback splice
# to the host, and the ruleset below drops every other destination, so the
# session reaches the named host services and nothing else.
SBX_NETNS=false
if [[ ${#NET_PROFILES[@]} -gt 0 || ${#HOST_PORTS_TCP[@]} -gt 0 || ${#HOST_PORTS_UDP[@]} -gt 0 ]]; then
    SBX_NETNS=true
fi

if [[ "$CAPS_KEEP" == "true" ]]; then
    echo "Warning: profile '$(basename "$CAPS_PROFILE" .json)' retains capabilities — this session's" >&2
    echo "  ro mounts and egress firewall are NOT enforceable against code running inside it." >&2
fi

# Session Initialization
SESSION_ID=$(date +%Y%m%d-%H%M%S)-$(printf "%04x" $RANDOM)
SESSION_DIR="$STATE_DIR/$SESSION_ID"
mkdir -p "$SESSION_DIR/fs"
mkdir -p "$SESSION_DIR/tmp"

# Persistent store for cli-profile copy mounts, keyed by profile name AND
# the external invoking directory. `--cli claude` in ~/projA and in
# ~/projB get separate stores, because the fs profiles normalize every
# project to a fixed in-sandbox cwd (/workspace, /home/user/src), which
# would otherwise pile all projects' sessions into one bucket. The profile
# name comes from the resolved path, so `--cli claude`, `--cli cli/claude`
# and `--cli ./claude.json` share the name component. The cwd slug is $PWD
# (the value recorded as "cwd" in session.json) with slashes dashed.
# Safe to live under STATE_DIR: --list-sessions only considers directories
# with a session.json, which this never has.
CLI_PROFILE_NAME=""
CLI_STORE_DIR=""
if [[ -n "$CLI_PROFILE" ]]; then
    CLI_PROFILE_NAME=$(basename "$CLI_PROFILE" .json)
    CLI_STORE_DIR="$STATE_DIR/profiles/cli/$CLI_PROFILE_NAME/$(sbx_copy_path_slug "$PWD")"
fi

# Bwrap Arguments
BWRAP_ARGS=(
    --unshare-ipc
    --unshare-pid
    --unshare-uts
    --unshare-cgroup
    --new-session
    --proc /proc
    --dev /dev
    --tmpfs /tmp
    --tmpfs /run
    --ro-bind /usr /usr
    --ro-bind /opt /opt
    --ro-bind /etc /etc
    --symlink usr/bin /bin
    --symlink usr/lib /lib
    --symlink usr/lib64 /lib64
)

# Environment policy: clear everything, then reintroduce by name.
# --clearenv is unconditional and has no opt-out — the host environment
# routinely carries API keys, tokens and SSH_AUTH_SOCK, none of which a
# sandbox should see unless a profile asks for them by name.
BWRAP_ARGS+=(--clearenv)

# Base set: what a shell needs to behave like a shell.
SBX_BASE_ENV=(HOME USER LOGNAME TERM COLORTERM LANG TZ SHELL)
for var in "${SBX_BASE_ENV[@]}"; do
    # Explicit if, not `[[ ]] &&`: under `set -e` a trailing false test on
    # the final iteration would exit the script.
    if [[ -n "${!var-}" ]]; then
        BWRAP_ARGS+=(--setenv "$var" "${!var}")
    fi
done

# Locale variables travel as a family; ${!LC_@} lists the set ones by name.
for var in ${!LC_@}; do
    if [[ -n "${!var-}" ]]; then
        BWRAP_ARGS+=(--setenv "$var" "${!var}")
    fi
done

# Profile-declared passthrough: forwards named host variables. Applied
# before the profile `env` block below, so an explicit `env` value wins.
for profile in "${FS_PROFILES[@]}" "$CLI_PROFILE"; do
    [[ -z "$profile" ]] && continue
    while IFS= read -r var; do
        [[ -z "$var" ]] && continue
        if [[ -n "${!var-}" ]]; then
            BWRAP_ARGS+=(--setenv "$var" "${!var}")
        fi
    done < <(jq -r '.passthrough[]?' "$profile")
done

if [[ "$SBX_NETNS" == "true" ]]; then
    # When a network namespace is used, pasta creates the user and net
    # namespaces.
    # bwrap joins them and provides filesystem isolation.
    #
    # pasta maps the host uid to 0 inside the namespace. bwrap does NOT drop
    # inherited capabilities when it is not the namespace's creator, so
    # without an explicit --cap-drop ALL (added below) the payload would run
    # as uid 0 with a full ambient set — able to remount every ro bind rw and
    # to flush the nftables ruleset. nft and dnsmasq now run in launch.sh,
    # outside the sandbox, so nothing in here needs privilege.
    if [[ "$CAPS_KEEP" == "true" ]]; then
        # podman/crun decide rootless-vs-rootful by checking geteuid()==0, not
        # actual privilege. --cap-add ALL above makes the sandboxed process look
        # like real root (uid 0, full capability bits) to podman, so it skips its
        # normal single-UID-mapping fallback and assumes a genuine system gid=5
        # exists for its default devpts mount — which fails with EINVAL, since
        # this is still a single-identity-mapped namespace underneath. These
        # containers/common env vars are the documented override for exactly
        # this case (a process nested in a constrained namespace where EUID==0
        # doesn't mean real privilege): they force podman back onto the correct
        # rootless code path regardless of what geteuid() reports. Confirmed
        # this doesn't touch networking — container egress is still fully
        # gated by this session's own nftables allow-list either way.
        # In userns-full mode these overrides are exactly wrong: there podman
        # MUST run rootful-in-namespace (euid 0 backed by a real multi-UID
        # mapping), and forcing the rootless code path would resurrect the
        # single-UID limitation the outer userns exists to remove.
        if [[ "$USERNS_FULL" != "true" ]]; then
            BWRAP_ARGS+=(
                --setenv _CONTAINERS_USERNS_CONFIGURED done
                --setenv _CONTAINERS_ROOTLESS_UID "$(id -u)"
                --setenv _CONTAINERS_ROOTLESS_GID "$(id -g)"
            )
        fi
    fi
else
    # With neither a net profile nor host ports, bwrap creates its own
    # namespaces and the session has no network stack at all.
    # No --uid/--gid: bwrap defaults to mapping the real UID/GID into the
    # new user namespace, so the sandbox sees the same user/HOME identity
    # as the host (matches what the --net branch already does via pasta).
    BWRAP_ARGS+=(--unshare-user --unshare-net)
fi

# The payload never needs capabilities. Session setup does, but all of it
# now runs outside the sandbox: nft and dnsmasq in launch.sh, inside
# pasta's namespaces and before bwrap starts. So the drop applies to both
# modes.
#
# CAP_SETPCAP is retained deliberately and is the ONLY capability kept.
# It is the privilege setpriv needs to empty the bounding set, which bwrap
# leaves full whenever it JOINS an existing user namespace instead of
# creating one — i.e. the --net path. Dropping it here makes setpriv fail
# with "apply bounding set: Operation not permitted" and every session
# exit 127.
#
# Why that is not an escape surface: the setpriv that spends it is
# launch.sh's, above session.sh (see the comment there), so CAP_SETPCAP is
# held across one exec by one process and is gone before the tmux server,
# the payload, or any join exists. This ordering is load-bearing and was
# not always so — while the drop lived in wrapper.sh, the server ran
# holding CAP_SETPCAP for the life of the sandbox and handed it to every
# pane it forked, which is a long-lived RPC-reachable service parked on a
# capability, not a single exec. CAP_SETPCAP cannot mount, configure
# networking, or change ownership in any case.
#
# The "caps": "keep" opt-out needs --cap-add ALL in BOTH modes, not just
# --net. Where bwrap creates the user namespace itself (the no-net path) it
# hands the payload an empty effective AND bounding set unless told
# otherwise, so omitting the flag here would silently ignore the profile
# field rather than honour it.
if [[ "$CAPS_KEEP" == "true" ]]; then
    BWRAP_ARGS+=(--cap-add ALL)
else
    BWRAP_ARGS+=(--cap-drop ALL --cap-add CAP_SETPCAP)
fi

# Reap the sandbox if sbx itself dies, rather than leaking a detached
# session with no supervisor.
BWRAP_ARGS+=(--die-with-parent)

# --- Virt (podman/qemu) base plumbing ---
# Always applied: adds no attack surface (nested single-UID userns was
# already reachable; masking subuid/subgid only reduces surface). The
# actual device access (/dev/kvm, /dev/net/tun) stays opt-in via the
# podman/qemu fs profiles.
VIRT_DIR="$SESSION_DIR/virt"
mkdir -p "$VIRT_DIR"

if [[ "$USERNS_FULL" == "true" ]]; then
    # userns-full sessions run podman rootful-in-namespace: rootful podman
    # reads graphroot, not rootless_storage_path. Expanded at write time
    # (HOME inside the sandbox equals host HOME). No ignore_chown_errors:
    # ownership is real in this mode (full subordinate-UID range). This
    # store is separate from the single-UID one by design — the ownership
    # layouts are incompatible.
    cat > "$VIRT_DIR/storage.conf" <<CONFEOF
[storage]
driver = "overlay"
graphroot = "$HOME/.local/state/sbx/virt/containers-full"
CONFEOF
else
    # rootless_storage_path expands $HOME using podman's own runtime env (sbx
    # doesn't clear or override HOME, so it resolves to the same value inside
    # the sandbox as outside). Written literally — do not let bash expand it.
    cat > "$VIRT_DIR/storage.conf" <<'CONFEOF'
[storage]
driver = "overlay"
rootless_storage_path = "$HOME/.local/state/sbx/virt/containers"

[storage.options.overlay]
ignore_chown_errors = "true"
CONFEOF
fi

# cgroupfs/disabled are the only values that can work inside bwrap: the
# systemd cgroup manager needs a user systemd instance over dbus, which
# can't exist here (--unshare-ipc, /run is tmpfs).
cat > "$VIRT_DIR/containers.conf" <<'CONFEOF'
[containers]
cgroups = "disabled"

[engine]
cgroup_manager = "cgroupfs"
events_logger = "file"
CONFEOF

if [[ "$USERNS_FULL" == "true" ]]; then
    # Podman's implicit default "podman" bridge network ships with
    # dns_enabled=false; only explicitly-created custom networks default
    # to DNS-enabled (verified empirically — podman network inspect
    # shows dns_enabled:true only for a network made via `podman network
    # create`). aardvark-dns for containers on this network inherits the
    # sandbox's own /etc/resolv.conf (127.0.0.1 -> sbx's dnsmasq) as its
    # upstream, so routing containers through it is what lets
    # hostname-based `allow` entries populate the forward chain's
    # allowed4 set (see USERNS_NET_SETUP below, which creates this
    # network). Without this, container DNS goes straight to public
    # resolvers, which the forward chain correctly drops (no egress
    # leak) but which also means hostname-based allow entries never
    # resolve for containers — only CIDR-based allow entries work.
    cat >> "$VIRT_DIR/containers.conf" <<'CONFEOF2'

[network]
default_network = "sbx0"
CONFEOF2
fi

: > "$VIRT_DIR/empty"

BWRAP_ARGS+=(
    --tmpfs /var
    --dir /var/tmp
    --dir "/run/user/$(id -u)"
    --ro-bind /sys /sys
    --ro-bind "$VIRT_DIR/empty" /etc/subuid
    --ro-bind "$VIRT_DIR/empty" /etc/subgid
    --setenv XDG_RUNTIME_DIR "/run/user/$(id -u)"
    --setenv CONTAINERS_STORAGE_CONF "$VIRT_DIR/storage.conf"
    --setenv CONTAINERS_CONF "$VIRT_DIR/containers.conf"
)

# Docker compat: a `docker` CLI shim (execs podman) and DOCKER_HOST are
# always on — both are free (no processes; $SESSION_DIR is already bound
# into every sandbox). The socket DOCKER_HOST points at only exists when
# a profile sets "docker_api": true (see wrapper generation). The path is
# pinned to the sbx-computed /run/user/<uid> — deliberately NOT
# $XDG_RUNTIME_DIR, which a profile may override and silently diverge
# from DOCKER_HOST.
PODMAN_SOCK="/run/user/$(id -u)/podman/podman.sock"
mkdir -p "$SESSION_DIR/bin"
cat > "$SESSION_DIR/bin/docker" <<'SHIMEOF'
#!/bin/sh
exec podman "$@"
SHIMEOF
chmod +x "$SESSION_DIR/bin/docker"
BWRAP_ARGS+=(--setenv DOCKER_HOST "unix://$PODMAN_SOCK")

COPY_MOUNTS=()     # fs-profile copy mounts,  "source:dest" — ephemeral
CLI_COPY_MOUNTS=() # cli-profile copy mounts, "source:dest" — persistent
SKIPPED_MOUNTS=()  # profile mounts whose source is absent on this host
FORKED_MOUNTS=()   # "profile<TAB>source<TAB>dest" — sandbox-owned, seeded once
RECORD_MOUNTS=()   # "source<TAB>dest" — host-owned, reseeded, changes archived

apply_mounts() {
    local profile="$1" kind="${2:-fs}"
    local profile_name
    profile_name=$(basename "$profile" .json)
    # Use jq to extract mounts
    mounts=$(jq -c '.mounts[]?' "$profile")
    [[ -z "$mounts" ]] && return

    while IFS= read -r m; do
        [[ -z "$m" ]] && continue
        source=$(echo "$m" | jq -r '.source' | envsubst)
        source=$(realpath -m "$source")
        dest=$(echo "$m" | jq -r '.dest' | envsubst)
        perm=$(echo "$m" | jq -r '.perm')

        # rw mounts may point at a persistent host directory that doesn't
        # exist yet (e.g. first-ever use of a profile's storage dir).
        if [[ "$perm" == "rw" && ! -e "$source" ]]; then
            mkdir -p "$source"
        fi

        # Ensure parent directories exist in the sandbox
        parent=$(dirname "$dest")
        if [[ "$parent" != "/" ]]; then
            IFS='/' read -ra ADDR <<< "$parent"
            curr=""
            for i in "${ADDR[@]}"; do
                if [[ -n "$i" ]]; then
                    curr="$curr/$i"
                    BWRAP_ARGS+=(--dir "$curr")
                fi
            done
        fi

        # The -try variants: a profile names paths that are optional on any
        # given host ($HOME/.nvm, $HOME/.npm-global, /dev/kvm), and a plain
        # --ro-bind on a missing source aborts the whole launch with
        # "No such file or directory" — one absent toolchain takes down a
        # sandbox that had no need of it. -try skips the mount instead.
        # Only profile-declared mounts are made tolerant; the base binds
        # (/usr, /etc, the session dir) stay strict, because a sandbox
        # missing those is broken rather than merely reduced.
        if [[ ! -e "$source" ]]; then
            SKIPPED_MOUNTS+=("$perm $source")
        fi

        case "$perm" in
            ro)
                BWRAP_ARGS+=(--ro-bind-try "$source" "$dest")
                ;;
            rw)
                BWRAP_ARGS+=(--bind-try "$source" "$dest")
                ;;
            dev)
                BWRAP_ARGS+=(--dev-bind-try "$source" "$dest")
                ;;
            copy)
                # `copy` means different things by profile type: ephemeral
                # snapshot in an fs profile, persistent overlay in a cli
                # profile. See docs/superpowers/specs/2026-07-23-persistent-cli-profiles-design.md
                if [[ "$kind" == "cli" ]]; then
                    CLI_COPY_MOUNTS+=("$source:$dest")
                else
                    COPY_MOUNTS+=("$source:$dest")
                fi
                ;;
            forked)
                FORKED_MOUNTS+=("$profile_name"$'\t'"$source"$'\t'"$dest")
                ;;
            record)
                RECORD_MOUNTS+=("$source"$'\t'"$dest")
                ;;
        esac
    done <<< "$mounts"
}

for profile in "${FS_PROFILES[@]}"; do
    apply_mounts "$profile" fs
done

if [[ -n "$CLI_PROFILE" ]]; then
    apply_mounts "$CLI_PROFILE" cli
fi

# A -try mount that finds nothing is dropped without a word from bwrap, which
# turns "my toolchain is missing inside the sandbox" into a debugging session.
# Name them once, here, rather than leaving the absence to be inferred.
if [[ ${#SKIPPED_MOUNTS[@]} -gt 0 ]]; then
    echo "Note: ${#SKIPPED_MOUNTS[@]} profile mount(s) skipped — source not present on this host:" >&2
    for sm in "${SKIPPED_MOUNTS[@]}"; do
        echo "  ${sm%% *} ${sm#* }" >&2
    done
fi

# Pre-population for copy mounts. fs-profile mounts are seeded from the
# host alone; cli-profile mounts additionally overlay the profile's
# persistent store, so the previous session's changes come back.
mkdir -p "$SESSION_DIR/tmp_mounts"

seed_copy_mount() {
    local src="$1" dst="$2" store="$3"
    local mount_id tmp_src
    mount_id=$(sbx_copy_mount_id "$dst")
    tmp_src="$SESSION_DIR/tmp_mounts/$mount_id"

    sbx_copy_seed "$src" "$tmp_src" "$store"

    if [[ -d "$src" ]]; then
        BWRAP_ARGS+=(--tmpfs "$dst")
        BWRAP_ARGS+=(--bind "$tmp_src" "$dst")
    elif [[ -f "$src" ]]; then
        BWRAP_ARGS+=(--bind "$tmp_src/$(basename "$src")" "$dst")
    fi
}

for cm in "${COPY_MOUNTS[@]}"; do
    seed_copy_mount "${cm%%:*}" "${cm#*:}" ""
done

for cm in "${CLI_COPY_MOUNTS[@]}"; do
    dst="${cm#*:}"
    seed_copy_mount "${cm%%:*}" "$dst" "$CLI_STORE_DIR/$(sbx_copy_mount_id "$dst")"
done

# Sandbox-owned mounts. Seeded from the host only when the store does not
# yet exist; from then on the store IS the tree and the host source is
# never consulted again. That is the defining property of `forked`, not an
# optimization — see the design spec. Bound rw directly, so there is no
# write-back at teardown and nothing to diff.
for fm in "${FORKED_MOUNTS[@]}"; do
    IFS=$'\t' read -r f_prof f_src f_dest <<< "$fm"
    f_id=$(sbx_copy_mount_id "$f_dest")
    f_store="$STATE_DIR/forked/$f_prof/$(sbx_copy_path_slug "$PWD")/$f_id"

    if [[ ! -e "$f_store" ]]; then
        mkdir -p "$f_store"
        sbx_copy_seed "$f_src" "$f_store"
    fi

    if [[ -f "$f_src" ]]; then
        BWRAP_ARGS+=(--bind "$f_store/$(basename "$f_src")" "$f_dest")
    else
        BWRAP_ARGS+=(--tmpfs "$f_dest")
        BWRAP_ARGS+=(--bind "$f_store" "$f_dest")
    fi
done

# Host-owned mounts with change detection. A private working copy is seeded
# fresh every launch and hashed into a manifest; teardown diffs the working
# copy against THAT manifest rather than against the live host source, so a
# host edit made while the session runs cannot be misattributed to the
# sandbox.
RECORD_WORK_DIR="$STATE_DIR/work/$SESSION_ID"
for rm_ in "${RECORD_MOUNTS[@]}"; do
    IFS=$'\t' read -r r_src r_dest <<< "$rm_"
    r_id=$(sbx_copy_mount_id "$r_dest")
    r_work="$RECORD_WORK_DIR/$r_id"

    mkdir -p "$r_work"
    sbx_copy_seed "$r_src" "$r_work"
    sbx_manifest_build "$r_work" "$RECORD_WORK_DIR/$r_id.manifest"

    if [[ -f "$r_src" ]]; then
        BWRAP_ARGS+=(--bind "$r_work/$(basename "$r_src")" "$r_dest")
    else
        BWRAP_ARGS+=(--tmpfs "$r_dest")
        BWRAP_ARGS+=(--bind "$r_work" "$r_dest")
    fi
done

# Parse Environment from all profiles
SANDBOX_PATH=""
for profile in "${FS_PROFILES[@]}" "$CLI_PROFILE"; do
    [[ -z "$profile" ]] && continue

    # "workingDirectory" used to be a profile field resolved last-one-wins.
    # That never composed: --fs a --fs b and --fs b --fs a mount the same
    # tree but start the session in different places, so the cwd depended on
    # flag order rather than on what the profiles actually provide. It is now
    # a single --wd on the command line. Warned about rather than ignored,
    # because silently starting somewhere else is the confusing failure.
    if [[ "$(jq -r 'has("workingDirectory")' "$profile")" == "true" ]]; then
        echo "Warning: profile '$(basename "$profile" .json)' sets \"workingDirectory\", which is no longer honored." >&2
        echo "  Pass --wd $(jq -r '.workingDirectory' "$profile") instead." >&2
    fi

    # Environment Variables
    while IFS='=' read -r key value; do
        if [[ -n "$key" ]]; then
            val=$(echo "$value" | envsubst)
            [[ "$key" == "PATH" ]] && SANDBOX_PATH="$val"
            BWRAP_ARGS+=(--setenv "$key" "$val")
        fi
    done < <(jq -r '.env // {} | to_entries[]? | "\(.key)=\(.value)"' "$profile")
done

if [[ -n "$WORKDIR" ]]; then
    BWRAP_ARGS+=(--chdir "$WORKDIR")
fi

# Handle CLI-specific 'path' prepending
DEFAULT_PATH="/usr/local/bin:/usr/bin:/bin"
if [[ -n "$CLI_PROFILE" ]]; then
    EXTRA_PATHS=$(jq -r '.path[]?' "$CLI_PROFILE" | envsubst | paste -sd: -)
    if [[ -n "$EXTRA_PATHS" ]]; then
        if [[ -n "$SANDBOX_PATH" ]]; then
            SANDBOX_PATH="$EXTRA_PATHS:$SANDBOX_PATH:$DEFAULT_PATH"
        else
            SANDBOX_PATH="$EXTRA_PATHS:$DEFAULT_PATH"
        fi
    else
        [[ -z "$SANDBOX_PATH" ]] && SANDBOX_PATH="$DEFAULT_PATH"
    fi
else
    [[ -z "$SANDBOX_PATH" ]] && SANDBOX_PATH="$DEFAULT_PATH"
fi
# $SESSION_DIR/bin holds the docker shim; first on PATH so `docker` always
# resolves to it (the host docker socket is never reachable in a sandbox).
BWRAP_ARGS+=(--setenv PATH "$SESSION_DIR/bin:$SANDBOX_PATH")

# Network Setup
if [[ "$SBX_NETNS" == "true" ]]; then
    # Detect host network settings for manual injection if pasta auto-config fails
    HOST_IFACE=$(ip route show default | awk '{print $5}' | head -n 1)
    HOST_IP=$(ip addr show "$HOST_IFACE" | grep "inet " | awk '{print $2}' | cut -d/ -f1 | head -n 1)
    HOST_GW=$(ip route show default | awk '{print $3}' | head -n 1)
    HOST_MASK=$(ip addr show "$HOST_IFACE" | grep "inet " | awk '{print $2}' | cut -d/ -f2 | head -n 1)
    
    export HOST_IFACE HOST_IP HOST_GW HOST_MASK

    DNS_DIR="$SESSION_DIR/dns"
    mkdir -p "$DNS_DIR"

    # Loopback address for this session's dnsmasq. Deliberately NOT
    # 127.0.0.1: pasta's UDP handler binds 127.0.0.1:53 inside the network
    # namespace it creates whenever the host has anything listening on port
    # 53 (systemd-resolved's 127.0.0.53/127.0.0.54 stubs, and under WSL2 the
    # 10.255.255.254 DNS proxy). dnsmasq then loses the race and dies with
    # "failed to create listening socket for 127.0.0.1: Address already in
    # use", taking the whole session with it. Neither -u none nor -t none
    # suppresses that bind; only --no-udp does, and that would break
    # dnsmasq's own upstream queries. Any other 127.0.0.0/8 address is
    # untouched by pasta and is local via lo's 127.0.0.1/8.
    SBX_DNS_ADDR="127.0.0.2"

    # Everything from here to the resolv.conf bind is DNS machinery, which
    # only a net profile needs: a host-ports-only session resolves nothing,
    # because its one reachable destination is a loopback address.
    if [[ ${#NET_PROFILES[@]} -gt 0 ]]; then

    # --- Composing several net profiles ---
    #
    # Each destination is paired with the ports of the profile that allowed
    # it, rather than every destination sharing one union of every profile's
    # ports. Stacking `--net web` (80,443) with `--net db` (5432) therefore
    # grants the web hosts 80,443 and the database host 5432 — not both hosts
    # on all three ports, which is what a flat union would produce and is
    # strictly more access than either profile asked for.
    #
    # Pairing is done by giving each distinct port list its own nftables set
    # and pointing each domain at the set for its ports. This is forced by
    # dnsmasq: a domain feeds exactly ONE nftset (verified — with two
    # --nftset options for one domain, only the first receives the answer),
    # so a domain cannot be gated two different ways at once. Hence the one
    # place a union is unavoidable: a domain named by several profiles gets
    # the union of their ports. That is also the right reading, since each
    # profile independently authorized it.
    #
    # An explicit CIDR needs no set — it is already an address — so it is
    # emitted as its own rule, gated by the same paired port list.

    declare -A DOMAIN_PORTS=()      # domain -> port signature ("*" or "80,443")
    declare -A DOMAIN_UPSTREAM=()   # domain -> resolver that profile chose
    declare -A CIDR_PORTS=()        # cidr   -> port signature
    ALLOW_ALL=false
    ALLOW_ALL_PORTS=""
    DNS_UPSTREAMS=()

    # Union of two port signatures. "*" absorbs everything.
    merge_ports() {
        local a="$1" b="$2"
        [[ -z "$a" ]] && { echo "$b"; return; }
        [[ "$a" == "*" || "$b" == "*" ]] && { echo "*"; return; }
        printf '%s\n%s\n' "${a//,/$'\n'}" "${b//,/$'\n'}" | sort -n -u | paste -sd, -
    }

    for np in "${NET_PROFILES[@]}"; do
        # DNS upstream must be a plain IP — dnsmasq does not speak DoH stamps.
        # If the profile supplies a stamp or leaves dns empty, fall back to
        # Cloudflare. Resolved per profile: each profile's domains are asked
        # of the resolver that profile named.
        np_upstream=$(jq -r '.dns // empty' "$np")
        if ! [[ "$np_upstream" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
            np_upstream="1.1.1.1"
        fi
        DNS_UPSTREAMS+=("$np_upstream")

        # This profile's port signature, normalised once.
        if jq -e '.ports[]? | select(. == "*")' "$np" >/dev/null 2>&1; then
            np_ports="*"
        else
            np_ports=$(jq -r '.ports[]?' "$np" | sort -n -u | paste -sd, -)
            # Hostnames allowed but no ports specified -> default to web.
            [[ -z "$np_ports" ]] && np_ports="80,443"
        fi

        while IFS= read -r entry; do
            [[ -z "$entry" ]] && continue
            if [[ "$entry" == "*" ]]; then
                ALLOW_ALL=true
                ALLOW_ALL_PORTS=$(merge_ports "$ALLOW_ALL_PORTS" "$np_ports")
                continue
            fi
            # Strips leading '*.' — dnsmasq --server=/domain/up matches the
            # apex plus all subdomains.
            domain="${entry#\*.}"
            DOMAIN_PORTS["$domain"]=$(merge_ports "${DOMAIN_PORTS[$domain]:-}" "$np_ports")
            [[ -n "${DOMAIN_UPSTREAM[$domain]:-}" ]] || DOMAIN_UPSTREAM["$domain"]="$np_upstream"
        done < <(jq -r '.allow[]? | select(type == "string" and test("^[a-zA-Z*]"))' "$np")

        while IFS= read -r cidr; do
            [[ -z "$cidr" ]] && continue
            CIDR_PORTS["$cidr"]=$(merge_ports "${CIDR_PORTS[$cidr]:-}" "$np_ports")
        done < <(jq -r '.allow[]? | select(type == "string" and test("^[0-9]"))' "$np")
    done

    mapfile -t DNS_UPSTREAMS < <(printf '%s\n' "${DNS_UPSTREAMS[@]}" | sort -u)
    DNS_UPSTREAM="${DNS_UPSTREAMS[0]}"

    # A wildcard profile authorizes every domain, including ones another
    # profile also named on narrower ports. Because a domain feeds exactly
    # one nftset, and dnsmasq prefers the more specific match, such a domain
    # would otherwise land in the narrow set and lose the access the
    # wildcard already granted — stacking a profile would REMOVE reach.
    # Folding the wildcard's ports into every named domain keeps the rule
    # that composing profiles only ever adds.
    if [[ "$ALLOW_ALL" == "true" ]]; then
        for domain in "${!DOMAIN_PORTS[@]}"; do
            DOMAIN_PORTS["$domain"]=$(merge_ports "${DOMAIN_PORTS[$domain]}" "$ALLOW_ALL_PORTS")
        done
    fi

    # Assign every distinct port signature its own set name, then build the
    # dnsmasq flags: one --server and one --nftset per domain.
    declare -A PORTS_SETNAME=()
    SET_INDEX=0
    DNSMASQ_DOMAIN_ARGS=()
    for domain in "${!DOMAIN_PORTS[@]}"; do
        sig="${DOMAIN_PORTS[$domain]}"
        if [[ -z "${PORTS_SETNAME[$sig]:-}" ]]; then
            SET_INDEX=$((SET_INDEX + 1))
            PORTS_SETNAME["$sig"]="allowed4_$SET_INDEX"
        fi
        DNSMASQ_DOMAIN_ARGS+=("--server=/$domain/${DOMAIN_UPSTREAM[$domain]}")
        DNSMASQ_DOMAIN_ARGS+=("--nftset=/$domain/inet#sbx_filter#${PORTS_SETNAME[$sig]}")
    done

    if [[ "$ALLOW_ALL" == "true" ]]; then
        if [[ -z "${PORTS_SETNAME[$ALLOW_ALL_PORTS]:-}" ]]; then
            SET_INDEX=$((SET_INDEX + 1))
            PORTS_SETNAME["$ALLOW_ALL_PORTS"]="allowed4_$SET_INDEX"
        fi
        ALLOW_ALL_SET="${PORTS_SETNAME[$ALLOW_ALL_PORTS]}"
    fi

    # First hostname from any profile, for the readiness probe.
    TEST_DOMAIN=""
    for np in "${NET_PROFILES[@]}"; do
        TEST_DOMAIN=$(jq -r '.allow[]? | select(type=="string" and test("^[a-zA-Z]"))' "$np" | head -n1)
        [[ -n "$TEST_DOMAIN" ]] && break
    done

    # resolv.conf points into the sandbox at our dnsmasq instance.
    printf 'nameserver %s\n' "$SBX_DNS_ADDR" > "$DNS_DIR/resolv.conf"

    else
        # Host-ports-only: no resolver runs and no destination outside
        # loopback is reachable, so an empty resolv.conf is the honest
        # description. Name lookups fail immediately instead of hanging on
        # a nameserver the ruleset drops; "localhost" still resolves,
        # because that comes from /etc/hosts rather than DNS.
        : > "$DNS_DIR/resolv.conf"
        ALLOW_ALL=false
        TEST_DOMAIN=""
        DNSMASQ_DOMAIN_ARGS=()
        DNS_UPSTREAMS=()
        declare -A PORTS_SETNAME=()
        declare -A CIDR_PORTS=()
    fi

    # /etc is bound read-only above, so whatever /etc/resolv.conf is on the
    # host appears in the sandbox — and on many hosts it is a symlink out of
    # /etc entirely (/mnt/wsl/resolv.conf under WSL2, /run/systemd/resolve/
    # stub-resolv.conf under systemd-resolved). The kernel resolves a bind
    # mount's destination through symlinks, and neither target exists in the
    # sandbox's fresh root, so binding at the /etc path fails outright with
    # "mount point is a symbolic link to nowhere". Bind at the resolved
    # target instead: bwrap creates the missing parents on the root tmpfs,
    # and the inherited symlink then points at our file.
    RESOLV_DEST=/etc/resolv.conf
    if [[ -L /etc/resolv.conf ]]; then
        RESOLV_DEST=$(readlink -f /etc/resolv.conf 2>/dev/null) || RESOLV_DEST=""
        [[ -n "$RESOLV_DEST" ]] || RESOLV_DEST=/etc/resolv.conf
    fi
    BWRAP_ARGS+=(--ro-bind "$DNS_DIR/resolv.conf" "$RESOLV_DEST")

    # nftables egress rules — default-drop, permit only:
    #   lo / established / DNS to $SBX_DNS_ADDR / upstream DNS on port 53
    #   explicit CIDRs from profile / @allowed4 (auto-populated by dnsmasq --nftset)
    # Raw IP connections and all IPv6 egress are dropped.
    # Shared egress accept rules, emitted into both the output chain
    # (process-originated traffic) and the forward chain. The forward
    # chain exists because rootful podman under userns:full uses the
    # netavark bridge backend: bridge-forwarded container traffic
    # traverses the kernel forward hook, never output, so an output-only
    # table would leave podman-full container egress completely ungated.
    # One accept per destination, carrying the ports that destination was
    # actually granted. A "*" signature means any port.
    emit_dest_rule() {
        local dest="$1" sig="$2"
        if [[ "$sig" == "*" ]]; then
            echo "        ip daddr $dest accept"
        else
            echo "        ip daddr $dest tcp dport { $sig } accept"
            echo "        ip daddr $dest udp dport { $sig } accept"
        fi
    }

    emit_egress_allow_rules() {
        # Explicit CIDRs, each gated by the ports of the profile that
        # allowed it.
        local cidr sig
        for cidr in "${!CIDR_PORTS[@]}"; do
            emit_dest_rule "$cidr" "${CIDR_PORTS[$cidr]}"
        done

        # One rule per port signature, naming that signature's set. Domains
        # were sorted into these sets by dnsmasq --nftset as answers arrived.
        for sig in "${!PORTS_SETNAME[@]}"; do
            emit_dest_rule "@${PORTS_SETNAME[$sig]}" "$sig"
        done
    }

    NFT_RULES="$DNS_DIR/rules.nft"
    {
        echo "table inet sbx_filter {"
        for sig in "${!PORTS_SETNAME[@]}"; do
            echo "    set ${PORTS_SETNAME[$sig]} {"
            echo "        type ipv4_addr"
            echo "        flags timeout"
            echo "    }"
        done
        echo "    chain output {"
        echo "        type filter hook output priority 0; policy drop;"
        # Loopback carries the host-port splice: pasta binds each named
        # host port inside this namespace, so reaching a host service is
        # loopback traffic and needs no destination rule of its own. The
        # allow-list for it is pasta's -T list, not this table.
        echo "        oif \"lo\" accept"
        echo "        ct state established,related accept"

        if [[ ${#NET_PROFILES[@]} -gt 0 ]]; then
            echo "        ip daddr $SBX_DNS_ADDR udp dport 53 accept"
            echo "        ip daddr $SBX_DNS_ADDR tcp dport 53 accept"
            for upstream in "${DNS_UPSTREAMS[@]}"; do
                echo "        ip daddr $upstream udp dport 53 accept"
                echo "        ip daddr $upstream tcp dport 53 accept"
            done

            emit_egress_allow_rules
        fi

        echo "        meta nfproto ipv6 drop"
        echo "    }"

        # Forward chain: gates bridge-forwarded container egress (netavark,
        # used by rootful podman under userns:full). Deliberately omits the
        # lo/DNS-to-$SBX_DNS_ADDR/DNS-to-upstream accepts above: container->
        # aardvark DNS is delivered via the input hook, and aardvark's own
        # upstream queries originate from a session process and hit output.
        echo "    chain forward {"
        echo "        type filter hook forward priority 0; policy drop;"
        echo "        ct state established,related accept"
        if [[ ${#NET_PROFILES[@]} -gt 0 ]]; then
            emit_egress_allow_rules
        fi
        echo "        meta nfproto ipv6 drop"
        echo "    }"

        echo "}"
    } > "$NFT_RULES"
fi

# Session State Persistence
cat > "$SESSION_DIR/session.json" <<EOF
{
    "id": "$SESSION_ID",
    "cwd": "$PWD",
    "pid": $$,
    "fs_profiles": $(printf '%s\n' "${FS_PROFILES[@]}" | jq -R . | jq -s .),
    "net_profiles": $(printf '%s\n' "${NET_PROFILES[@]}" | jq -R . | jq -s 'map(select(. != ""))'),
    "cli_profile": $([[ -n "$CLI_PROFILE" ]] && jq -R . <<< "$CLI_PROFILE" || echo "null")
}
EOF

# The join sidecar. Same information session.json would have carried, but
# kept OUTSIDE $SESSION_DIR on purpose: that directory is bound rw into the
# sandbox, so anything in it is attacker-authored, and --join must not take
# security-relevant input from the sandbox it is about to enter. $STATE_DIR
# is masked by a --tmpfs inside with only $SESSION_DIR bound back in, so
# this path does not exist from the sandbox's point of view.
#   path      the session's own PATH, which --join re-imposes because tmux
#             otherwise hands the pane the host client's PATH.
#   workdir   what `tmux new-session -c` should use, so a join starts where
#             the payload did rather than in the host's cwd. Empty --wd means
#             "wherever bwrap would have landed", which is the launch dir.
#   caps_keep informational: the drop is applied (or not) once at launch, in
#             launch.sh, so --join does not consult this. Recorded so a
#             capful join is explainable without re-deriving the profiles.
cat > "$STATE_DIR/$SESSION_ID.join.json" <<EOF
{
    "path": $(jq -R . <<< "$SESSION_DIR/bin:$SANDBOX_PATH"),
    "workdir": $(jq -R . <<< "${WORKDIR:-$PWD}"),
    "caps_keep": $([[ "$CAPS_KEEP" == "true" ]] && echo true || echo false)
}
EOF

# GUI Setup (xpra virtual display)
if [[ "$GUI_FLAG" == "true" ]]; then
    if ! command -v xpra >/dev/null 2>&1; then
        echo "Error: xpra is not installed. Cannot use --gui mode." >&2
        exit 1
    fi

    # Find a free X11 display slot
    DISPLAY_NUM=100
    while [[ -S "/tmp/.X11-unix/X$DISPLAY_NUM" ]]; do
        DISPLAY_NUM=$((DISPLAY_NUM + 1))
    done
    XPRA_DISPLAY=":$DISPLAY_NUM"
    XPRA_LOG="$SESSION_DIR/xpra.log"

    echo "Starting xpra on display $XPRA_DISPLAY..."
    xpra start "$XPRA_DISPLAY" \
        --daemon=yes \
        --log-file="$XPRA_LOG" \
        --mdns=no \
        --notifications=no \
        --bell=no \
        --speaker=disabled \
        --microphone=disabled \
        > /dev/null 2>&1

    # Wait for the virtual X11 socket to appear
    X11_SOCK="/tmp/.X11-unix/X$DISPLAY_NUM"
    echo -n "Waiting for display"
    XPRA_READY=false
    for i in {1..40}; do
        if [[ -S "$X11_SOCK" ]]; then
            XPRA_READY=true
            break
        fi
        sleep 0.25
        echo -n "."
    done
    echo

    if [[ "$XPRA_READY" != "true" ]]; then
        echo "Error: xpra display $XPRA_DISPLAY failed to start. Check $XPRA_LOG" >&2
        xpra stop "$XPRA_DISPLAY" >/dev/null 2>&1 || true
        exit 1
    fi

    # Build a session Xauthority cookie for the display.
    # xpra writes its cookie to the host Xauthority keyed to the host hostname,
    # but the sandbox runs under a different hostname (e.g. pasta-<host> when
    # networking is on, or no UTS name otherwise). We rewrite the cookie's
    # address family to FamilyWild (ffff) so it matches from any hostname.
    HOST_XAUTH="${XAUTHORITY:-$HOME/.Xauthority}"
    SBX_XAUTH="$SESSION_DIR/Xauthority"
    rm -f "$SBX_XAUTH"

    # The cookie may lag slightly behind the socket; retry briefly.
    for i in {1..20}; do
        if xauth -f "$HOST_XAUTH" nlist "$XPRA_DISPLAY" 2>/dev/null | grep -q .; then
            break
        fi
        sleep 0.25
    done

    if xauth -f "$HOST_XAUTH" nlist "$XPRA_DISPLAY" 2>/dev/null \
        | sed -e 's/^..../ffff/' \
        | xauth -f "$SBX_XAUTH" nmerge - 2>/dev/null; then
        : # cookie installed
    else
        echo "Warning: could not build X11 auth cookie; GUI apps may fail with auth errors." >&2
    fi

    # Expose the X11 socket and auth cookie inside the sandbox
    BWRAP_ARGS+=(--dir /tmp/.X11-unix)
    BWRAP_ARGS+=(--bind "$X11_SOCK" "/tmp/.X11-unix/X$DISPLAY_NUM")
    BWRAP_ARGS+=(--setenv DISPLAY "$XPRA_DISPLAY")
    if [[ -f "$SBX_XAUTH" ]]; then
        BWRAP_ARGS+=(--ro-bind "$SBX_XAUTH" /tmp/.sbx-Xauthority)
        BWRAP_ARGS+=(--setenv XAUTHORITY /tmp/.sbx-Xauthority)
    fi
    # Prevent MIT-SHM errors (IPC is unshared, so SHM won't work)
    BWRAP_ARGS+=(--setenv LIBGL_ALWAYS_INDIRECT 1)

    GUI_MODE=true
    echo "GUI display $XPRA_DISPLAY is ready."
    echo "  Attach viewer : xpra attach $XPRA_DISPLAY"
    echo "  Stop display  : xpra stop $XPRA_DISPLAY"
fi

# Masks, appended after every profile mount because bwrap applies mount
# arguments in order: a profile mounting $HOME or $HOME/.local would
# otherwise re-expose these. The sandbox gets its own session directory
# and nothing else — no sibling sessions, no persistent cli stores, and
# no ability to author the profiles that configure the next launch.
BWRAP_ARGS+=(--tmpfs "$STATE_DIR")
BWRAP_ARGS+=(--bind "$SESSION_DIR" "$SESSION_DIR")
BWRAP_ARGS+=(--tmpfs "$CONFIG_DIR")

# Teardown Logic
teardown() {
    # Must be the first line: in an EXIT trap $? is the status the script is
    # dying with, i.e. bwrap's. That is NOT the payload's exit code (a tmux
    # session's status does not reach its client, and dropping it is
    # deliberate) — it is the launch's own, and a caller has to be able to
    # tell "the sandbox never came up" apart from "the session ran".
    local exit_status=$?
    echo "Tearing down session $SESSION_ID..."

    # The in-sandbox wait loop is not sufficient to keep writeback off a
    # live join: its liveness test is "can a client connect to this socket",
    # and both the socket and the server are under the payload's control
    # (`rm tmux.sock`, `tmux kill-server`). This lock is on the host side and
    # on a path the sandbox cannot see (see the --join branch), so it holds
    # regardless of what happens inside. Bounded, never an unbounded block:
    # a stale lock must not be able to hang teardown forever.
    JOIN_LOCK="$STATE_DIR/$SESSION_ID.joinlock"
    if exec 9>>"$JOIN_LOCK"; then
        if ! flock -w 30 -x 9; then
            echo "Warning: a --join still holds the session lock after 30s; running write-back anyway." >&2
        fi
    fi

    # Egress for copy mounts. fs-profile mounts land in this session's
    # fs/ directory; cli-profile mounts land in the profile's persistent
    # store (keyed by profile + launch dir), where the next --cli session
    # from the same directory picks them up. The diff baseline is the host
    # source in BOTH cases — not for survival (write-back never prunes the
    # store, so a file written in an earlier session persists regardless of
    # baseline) but so the store stays a minimal delta from the user's real
    # config rather than a full mirror of it.
    for cm in "${COPY_MOUNTS[@]}"; do
        src="${cm%%:*}"
        dst="${cm#*:}"
        mount_id=$(sbx_copy_mount_id "$dst")
        sbx_copy_writeback "$src" "$SESSION_DIR/tmp_mounts/$mount_id" "$SESSION_DIR/fs/$mount_id"
    done

    for cm in "${CLI_COPY_MOUNTS[@]}"; do
        src="${cm%%:*}"
        dst="${cm#*:}"
        mount_id=$(sbx_copy_mount_id "$dst")
        sbx_copy_writeback "$src" "$SESSION_DIR/tmp_mounts/$mount_id" "$CLI_STORE_DIR/$mount_id"
    done

    # Change archive for record mounts. The baseline is the launch-time
    # manifest, not the host source, so this reports what the SANDBOX did.
    if [[ ${#RECORD_MOUNTS[@]} -gt 0 ]]; then
        arch_dir="$STATE_DIR/changes/$(sbx_copy_path_slug "$PWD")/$(date +%Y%m%d-%H%M%S)-$SESSION_ID"
        for rm_ in "${RECORD_MOUNTS[@]}"; do
            IFS=$'\t' read -r r_src r_dest <<< "$rm_"
            r_id=$(sbx_copy_mount_id "$r_dest")
            r_work="$RECORD_WORK_DIR/$r_id"
            r_base="$RECORD_WORK_DIR/$r_id.manifest"
            [[ -d "$r_work" ]] || continue

            r_cur="$RECORD_WORK_DIR/$r_id.manifest.now"
            sbx_manifest_build "$r_work" "$r_cur"

            mkdir -p "$arch_dir/$r_id"
            while IFS= read -r rel; do
                [[ -z "$rel" ]] && continue
                mkdir -p "$arch_dir/$r_id/$(dirname "$rel")"
                cp -a "$r_work/$rel" "$arch_dir/$r_id/$rel"
            done < <(sbx_manifest_changed "$r_base" "$r_cur")

            sbx_manifest_deleted "$r_base" "$r_cur" > "$arch_dir/$r_id.deleted"
            echo "Changes from this session: $arch_dir/$r_id"
        done
    fi
    rm -rf "$RECORD_WORK_DIR"

    rm -rf "$SESSION_DIR/tmp_mounts"
    rm -f "$SESSION_DIR/tmux.sock" "$SESSION_DIR/tmux.conf" \
          "$SESSION_DIR/session.sh" "$SESSION_DIR/wrapper.sh"
    # Both live outside $SESSION_DIR; go once the session cannot be joined.
    rm -f "$STATE_DIR/$SESSION_ID.join.json" "$JOIN_LOCK"

    if [[ -n "$XPRA_DISPLAY" ]]; then
        echo "Stopping xpra display $XPRA_DISPLAY..."
        xpra stop "$XPRA_DISPLAY" >/dev/null 2>&1 || true
    fi

    if [[ "$exit_status" -ne 0 ]]; then
        # Saying "changes saved" here would be a lie a CI job cannot see
        # through: the sandbox may never have got as far as running anything.
        echo "Session $SESSION_ID ended with status $exit_status; the payload may never have run." >&2
    else
        echo "Session $SESSION_ID finished. Changes saved to $SESSION_DIR/fs"
    fi
}

trap teardown EXIT

# Execution
TMUX_SOCK="$SESSION_DIR/tmux.sock"
TMUX_CONF="$SESSION_DIR/tmux.conf"
SESSION_SCRIPT="$SESSION_DIR/session.sh"
LAUNCH_SCRIPT="$SESSION_DIR/launch.sh"
CAT_WRAPPER="$SESSION_DIR/wrapper.sh"
DNSMASQ_BIN=$(which dnsmasq)

# Opt-in podman docker-API service ("docker_api": true in any profile).
# Startup failure is a WARNING, not fatal — the docker CLI shim works
# without the service (contrast: nft/dnsmasq failures stay hard errors;
# egress safety is never best-effort). Killed when the command exits.
DOCKER_API_START=""
DOCKER_API_STOP=""
if [[ "$DOCKER_API" == "true" ]]; then
    DOCKER_API_START=$(cat <<APIEOF
mkdir -p "$(dirname "$PODMAN_SOCK")"
podman system service --time=0 "unix://$PODMAN_SOCK" > "$SESSION_DIR/podman-api.log" 2>&1 &
PODMAN_API_PID=\$!
for i in {1..10}; do
    [[ -S "$PODMAN_SOCK" ]] && break
    sleep 0.5
done
if [[ ! -S "$PODMAN_SOCK" ]]; then
    echo "Warning: podman API socket did not appear at $PODMAN_SOCK; docker SDK clients will fail (the docker CLI shim still works)." >&2
    cat "$SESSION_DIR/podman-api.log" >&2 || true
fi
APIEOF
)
    DOCKER_API_STOP='[[ -n "$PODMAN_API_PID" ]] && kill $PODMAN_API_PID 2>/dev/null || true'
fi

# userns:full only (which requires --net, enforced earlier): create the
# DNS-enabled "sbx0" network that containers.conf's default_network now
# points at. Idempotent — a repeat "already exists" failure is expected
# and harmless (confirmed: if creation ever failed for a real reason,
# podman fails loudly downstream with "network not found" when a
# container runs, not silently — but stderr is still logged here so the
# actual cause isn't lost). Only reachable via the net-profile wrapper
# below, since userns:full without --net is a hard error before session
# state is even created.
USERNS_NET_SETUP=""
if [[ "$USERNS_FULL" == "true" ]]; then
    USERNS_NET_SETUP="podman network create sbx0 >/dev/null 2>> \"$VIRT_DIR/network-create.log\" || true"
fi

NET_PRELUDE=""
if [[ "$SBX_NETNS" == "true" && ${#NET_PROFILES[@]} -eq 0 ]]; then
    # Host-ports-only: load the ruleset (which permits loopback and nothing
    # else) and start no resolver. Same hard-fail contract as the net path —
    # a session must never come up with the egress table missing.
    NET_PRELUDE=$(cat <<EOF
ip link set lo up >/dev/null 2>&1

if ! NFT_ERR=\$(nft -f "$NFT_RULES" 2>&1); then
    echo "Error: nftables rules failed to load — aborting." >&2
    echo "  nft: \$NFT_ERR" >&2
    exit 1
fi
EOF
)
elif [[ ${#NET_PROFILES[@]} -gt 0 ]]; then
    # Serialise per-domain flags for expansion inside the heredoc. A
    # wildcard profile adds a catch-all server and set on top of the
    # per-domain flags rather than replacing them: dnsmasq prefers the more
    # specific match, so a domain another profile named on narrow ports
    # keeps its own set (and its own ports) even alongside `allow: ["*"]`.
    DNSMASQ_DOMAIN_FLAGS=""
    if [[ ${#DNSMASQ_DOMAIN_ARGS[@]} -gt 0 ]]; then
        DNSMASQ_DOMAIN_FLAGS=$(printf '%s ' "${DNSMASQ_DOMAIN_ARGS[@]}")
    fi
    if [[ "$ALLOW_ALL" == "true" ]]; then
        DNSMASQ_DOMAIN_FLAGS+="--server=$DNS_UPSTREAM --nftset=//inet#sbx_filter#$ALLOW_ALL_SET"
    fi

    # Runs in launch.sh: inside pasta's namespaces, before bwrap, with the
    # capabilities nft and dnsmasq need. Everything started here lives
    # outside the sandbox's PID and mount namespaces, so the payload can
    # neither signal dnsmasq nor alter the ruleset.
    NET_PRELUDE=$(cat <<EOF
ip link set lo up >/dev/null 2>&1

# Hard-fail if nftables rules cannot be loaded — never proceed with open egress.
if ! NFT_ERR=\$(nft -f "$NFT_RULES" 2>&1); then
    echo "Error: nftables rules failed to load — aborting." >&2
    echo "  nft: \$NFT_ERR" >&2
    exit 1
fi

# dnsmasq on $SBX_DNS_ADDR:53 (see SBX_DNS_ADDR above).
# All options are CLI flags: AppArmor's usr.sbin.dnsmasq profile restricts
# config-file paths to /etc/dnsmasq.d/*, making arbitrary paths unreadable.
# --conf-file=/dev/null  suppress any host /etc/dnsmasq.conf
# --filter-AAAA          return only A records; IPv6 egress is nft-dropped anyway
# --nftset               auto-populates @allowed4 from A-record answers —
#                        no bespoke sniffer needed
"$DNSMASQ_BIN" \\
    --conf-file=/dev/null \\
    -d \\
    --port=53 \\
    --listen-address=$SBX_DNS_ADDR \\
    --bind-interfaces \\
    --no-resolv \\
    --no-hosts \\
    --filter-AAAA \\
    $DNSMASQ_DOMAIN_FLAGS \\
    > "$DNS_DIR/dnsmasq.log" 2>&1 &
DNSMASQ_PID=\$!

# The probe must query this session's dnsmasq, but launch.sh sees the host
# /etc/resolv.conf. A throwaway bwrap binds the session resolv.conf so the
# check is accurate and every setup failure still prints before the session
# multiplexer starts.
probe_dns() {
    bwrap --ro-bind /usr /usr --symlink usr/bin /bin --symlink usr/lib /lib \\
        --symlink usr/lib64 /lib64 --ro-bind /etc /etc \\
        --ro-bind "$DNS_DIR/resolv.conf" "$RESOLV_DEST" \\
        --proc /proc --dev /dev \\
        -- getent ahostsv4 "$TEST_DOMAIN" >/dev/null 2>&1
}

DNS_READY=false
for i in {1..20}; do
    if ! kill -0 \$DNSMASQ_PID 2>/dev/null; then
        echo "Error: dnsmasq failed to start:" >&2
        cat "$DNS_DIR/dnsmasq.log" >&2
        exit 1
    fi
    if [[ -z "$TEST_DOMAIN" ]] || probe_dns; then
        DNS_READY=true
        break
    fi
    sleep 0.5
done
if [[ "\$DNS_READY" != "true" ]]; then
    echo "Error: dnsmasq did not become ready (could not resolve '$TEST_DOMAIN')." >&2
    cat "$DNS_DIR/dnsmasq.log" >&2
    kill \$DNSMASQ_PID 2>/dev/null
    exit 1
fi
EOF
)
fi

# The wrapper is now the payload and nothing else — network setup has moved
# to launch.sh, so both modes generate the same shape.
if [[ "$CAPS_KEEP" == "true" ]]; then
    cat > "$CAT_WRAPPER" <<EOF
#!/bin/bash
$USERNS_NET_SETUP
$DOCKER_API_START
$(printf "%q " "${COMMAND[@]}")
$DOCKER_API_STOP
EOF
else
    # No setpriv here any more. The drop used to sit in this wrapper, which
    # covered the payload and nothing else — the tmux server, being started
    # by session.sh, kept CAP_SETPCAP and handed it to every pane it forked
    # (new-window and split-window are default key bindings). It now happens
    # once in launch.sh, above session.sh, so this process is already capless
    # before it starts and a second --bounding-set=-all would fail with
    # EPERM: emptying a bounding set itself requires CAP_SETPCAP.
    # exec because a capless session has no docker-API service to stop
    # afterwards. USERNS_NET_SETUP and DOCKER_API_START are both podman
    # operations and are unreachable without capabilities, so they are
    # absent here by construction.
    cat > "$CAT_WRAPPER" <<EOF
#!/bin/bash
exec $(printf "%q " "${COMMAND[@]}")
EOF
fi
chmod +x "$CAT_WRAPPER"

# Per-session tmux config. The -f that loads this is not cosmetic: the
# sandbox usually has $HOME mounted, so without it the server would read
# the user's ~/.tmux.conf and session behaviour would depend on host
# dotfiles. Every setting here is load-bearing:
#   update-environment  SECURITY. A tmux client ships its environment to the
#                  server, and this list is what gets applied to new
#                  sessions — by default DISPLAY, SSH_AUTH_SOCK and friends.
#                  Leaving it at the default drives a host-env hole straight
#                  through the --clearenv policy above. Emptied deliberately.
#                  NOT sufficient on its own: tmux copies the client's PATH
#                  into a spawned pane regardless of this list, which is why
#                  --join re-imposes the session's PATH itself.
#   exit-empty     the session-lifetime rule — server exits with its last
#                  session, which is what lets session.sh stop waiting.
#   prefix C-\     a host tmux keeps C-b, so nesting needs no doubled
#                  prefix. C-\ is also abduco's old detach chord.
#   window-size    per-client sizing, so one join cannot resize another.
#   status-left    makes "you are inside a sandbox" visible at a glance.
cat > "$TMUX_CONF" <<EOF
set -g update-environment ''
set -g exit-empty on
set -g escape-time 0
set -g window-size latest
unbind C-b
set -g prefix C-\\\\
bind C-\\\\ send-prefix
set -g status on
set -g status-left ' sbx:$SESSION_ID '
set -g status-left-length 40
EOF

# PID 1 inside the sandbox. This script — not the tmux server, and not the
# payload — is what bwrap waits on, and that is the whole implementation of
# the session-lifetime rule: the server daemonizes, so if this exited,
# bwrap's direct child would be gone and the pid namespace would take every
# live session with it, joins included. Instead it hangs around until the
# server is gone, which (with exit-empty on) means the last session — payload
# or join, whichever ends last — has exited. Only then does bwrap return and
# launch.sh proceed to copy-writeback. Note what this does and does not
# promise: it keeps the sandbox alive for joins the payload has finished
# outliving, but it is not itself a guarantee that write-back never overlaps
# a live join. Its liveness test is socket connectivity, and the payload can
# delete the socket or run `tmux kill-server` — it can end its own sandbox
# whenever it likes, taking any live join with it. The host-side flock in
# teardown() is what makes the no-overlap property true.
#
# No `set -e`: attach is expected to fail when the payload is short-lived
# enough to have exited before we get here, and that is not an error. A
# failure to start the server is a different thing entirely and is checked
# explicitly: without it, `attach` fails into `|| true`, the loop's first
# list-sessions fails, this script exits 0 and sbx reports a session whose
# payload never ran as one whose changes were saved.
cat > "$SESSION_SCRIPT" <<EOF
#!/bin/bash
if ! tmux -f $(printf '%q' "$TMUX_CONF") -S $(printf '%q' "$TMUX_SOCK") \\
    new-session -d -s main -- $(printf '%q' "$CAT_WRAPPER"); then
    echo "sbx: the in-sandbox tmux server failed to start; the payload did not run." >&2
    exit 1
fi
tmux -S $(printf '%q' "$TMUX_SOCK") attach -t main || true
while tmux -S $(printf '%q' "$TMUX_SOCK") list-sessions >/dev/null 2>&1; do
    sleep 0.5
done
EOF
chmod +x "$SESSION_SCRIPT"

# Generate the launch script with properly escaped BWRAP_ARGS.
# pasta runs this inside the session's user and net namespaces, so the
# network prelude lands there — outside every namespace bwrap creates.
{
    echo "#!/bin/bash"
    echo "# Start the sandbox"
    if [[ -n "$NET_PRELUDE" ]]; then
        echo "$NET_PRELUDE"
    fi
} > "$LAUNCH_SCRIPT"

# With a net profile the script must outlive bwrap to reap dnsmasq, so it
# cannot exec. A host-ports-only session starts no resolver, so it can.
if [[ ${#NET_PROFILES[@]} -gt 0 ]]; then
    printf "bwrap " >> "$LAUNCH_SCRIPT"
else
    printf "exec bwrap " >> "$LAUNCH_SCRIPT"
fi
for arg in "${BWRAP_ARGS[@]}"; do
    printf "%q " "$arg" >> "$LAUNCH_SCRIPT"
done
# THE capability drop, applied exactly once and as high up as it can go.
# bwrap's direct child is setpriv, which empties every capability set and
# then execs session.sh as PID 1 — so the tmux server, the payload, every
# join, and every pane the server forks by any route (new-window,
# split-window, respawn-pane, run-shell, hooks, default-command) is capless
# by construction rather than because some wrapper remembered to re-apply a
# drop. This is deliberately not done in tmux.conf's default-command: the
# payload holds the server socket and could simply `tmux set -g
# default-command` its way out of that one.
#
# The retained CAP_SETPCAP (--cap-add CAP_SETPCAP above) is spent here, by
# this setpriv, and is gone before any of the session's own code runs. If
# setpriv is missing or fails, the exec fails and nothing runs: the failure
# mode is closed, not open.
#
# "caps": "keep" sessions are deliberately not wrapped — keeping
# capabilities is the entire point of that opt-out, and it extends to their
# joins, which is why --join needs no capability logic of its own.
if [[ "$CAPS_KEEP" != "true" ]]; then
    printf "setpriv --bounding-set=-all --inh-caps=-all --ambient-caps=-all -- " >> "$LAUNCH_SCRIPT"
fi
printf "%q\n" "$SESSION_SCRIPT" >> "$LAUNCH_SCRIPT"

if [[ ${#NET_PROFILES[@]} -gt 0 ]]; then
    # Quoted heredoc: every expansion below belongs to launch.sh, not here.
    cat >> "$LAUNCH_SCRIPT" <<'REAPEOF'
SBX_RC=$?
kill $DNSMASQ_PID 2>/dev/null || true
exit $SBX_RC
REAPEOF
fi

chmod +x "$LAUNCH_SCRIPT"

# -T / -U: the explicit host-port forward lists, or "none". Between them
# they are the whole of the host-access allow-list — pasta binds exactly
# these ports inside the namespace and splices them to the host's loopback,
# so an unnamed host service has nothing listening for it to reach. "none"
# on both is the default, and is what replaces pasta's -T/-U auto, which
# would forward every port bound on the host. Keeping the two lists separate
# is what stops a TCP grant from quietly carrying its UDP twin along, and
# what keeps a host resolver from claiming the port dnsmasq needs unless the
# session actually asked for udp/53.
#
# --no-map-gw on every call: pasta otherwise translates the gateway address
# to the host's loopback, which would let the sandbox reach host-local
# services through $HOST_GW without ever traversing a rule that names them.
# Host access goes through -T/-U, which is per-port and per-protocol;
# --map-gw is all-or-nothing.
join_ports() {
    if [[ $# -eq 0 ]]; then
        echo none
    else
        local joined; joined=$(printf '%s,' "$@"); echo "${joined%,}"
    fi
}
PASTA_FWD_TCP=$(join_ports "${HOST_PORTS_TCP[@]}")
PASTA_FWD_UDP=$(join_ports "${HOST_PORTS_UDP[@]}")
PASTA_PORT_ARGS=(-T "$PASTA_FWD_TCP" -U "$PASTA_FWD_UDP")

# Human-readable summary for the startup line, protocols named explicitly.
HOST_PORT_DESC=""
[[ "$PASTA_FWD_TCP" != "none" ]] && HOST_PORT_DESC="tcp $PASTA_FWD_TCP"
if [[ "$PASTA_FWD_UDP" != "none" ]]; then
    [[ -n "$HOST_PORT_DESC" ]] && HOST_PORT_DESC+=", "
    HOST_PORT_DESC+="udp $PASTA_FWD_UDP"
fi

if [[ "$SBX_NETNS" == "true" ]]; then
    if [[ "$USERNS_FULL" == "true" ]]; then
        echo "Starting session $SESSION_ID with networking (full userns)..."
        # unshare claims the user's /etc/subuid range up front, via the
        # setuid newuidmap helper — still permitted here because bwrap's
        # no_new_privs only applies further down the chain. pasta must
        # then NOT create its own user namespace (that would discard the
        # multi-UID mapping): --netns-only.
        unshare --map-auto --map-root-user -- \
            pasta -f --config-net --netns-only --no-map-gw "${PASTA_PORT_ARGS[@]}" --interface "$HOST_IFACE" --no-ndp --no-dhcpv6 --no-ra -a "$HOST_IP" -g "$HOST_GW" -n "$HOST_MASK" -- "$LAUNCH_SCRIPT"
    else
        if [[ ${#NET_PROFILES[@]} -gt 0 ]]; then
            echo "Starting session $SESSION_ID with networking..."
        else
            echo "Starting session $SESSION_ID with host ports $HOST_PORT_DESC (no internet)..."
        fi
        pasta -f --config-net --no-map-gw "${PASTA_PORT_ARGS[@]}" --interface "$HOST_IFACE" --no-ndp --no-dhcpv6 --no-ra -a "$HOST_IP" -g "$HOST_GW" -n "$HOST_MASK" -- "$LAUNCH_SCRIPT"
    fi
else
    echo "Starting session $SESSION_ID..."
    "$LAUNCH_SCRIPT"
fi
