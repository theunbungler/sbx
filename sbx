#!/bin/bash

# sbx - Portable Unprivileged Sandbox Orchestrator

set -e

STATE_DIR="$HOME/.local/state/sbx"
CONFIG_DIR="$HOME/.config/sbx"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Ensure state directory exists
mkdir -p "$STATE_DIR"

usage() {
    cat <<EOF
Usage: $(basename "$0") [options] [command]

Options:
  --list-profiles        Show available profiles
  --list-sessions        Show active sessions
  --join <session>       Attach to an existing session
  --fs <profile>         Apply a filesystem profile (multiple allowed)
  --net <profile>        Apply a network profile
  --cli <profile>        Apply a CLI/environment profile
  -h, --help             Show this help message

Profiles are searched in:
  1. ./.sbx/profiles/
  2. \$HOME/.config/sbx/profiles/
  3. $SCRIPT_DIR/profiles/
EOF
}

resolve_profile() {
    local type="$1"
    local name="$2"

    # If it's a direct path to a file, use it
    if [[ -f "$name" ]]; then
        realpath "$name"
        return 0
    fi
    if [[ -f "$name.json" ]]; then
        realpath "$name.json"
        return 0
    fi

    # Strip the type prefix if it was included (e.g., "cli/dev" -> "dev")
    if [[ "$name" == "$type/"* ]]; then
        name="${name#$type/}"
    fi

    local paths=(
        "./.sbx/profiles/$type/$name.json"
        "$CONFIG_DIR/profiles/$type/$name.json"
        "$SCRIPT_DIR/profiles/$type/$name.json"
    )

    for p in "${paths[@]}"; do
        if [[ -f "$p" ]]; then
            echo "$p"
            return 0
        fi
    done

    echo "Error: Profile '$name' of type '$type' not found." >&2
    exit 1
}

list_profiles() {
    local types=("cli" "fs" "net")
    local sources=(
        "Project:./.sbx/profiles"
        "User:$CONFIG_DIR/profiles"
        "Global:$SCRIPT_DIR/profiles"
    )

    echo "Available Profiles:"
    for type in "${types[@]}"; do
        echo ""
        echo "${type^^} Profiles:"
        local found=0
        for src in "${sources[@]}"; do
            local label="${src%%:*}"
            local path="${src#*:}"
            if [[ -d "$path/$type" ]]; then
                # Use a temporary variable to capture find output to avoid empty lines
                local files
                files=$(find "$path/$type" -name "*.json" | sed "s|$path/$type/||" | sed 's/\.json$//' | sort)
                if [[ -n "$files" ]]; then
                    while IFS= read -r profile; do
                        echo "  $profile ($label)"
                        found=1
                    done <<< "$files"
                fi
            fi
        done
        if [[ $found -eq 0 ]]; then
            echo "  (none)"
        fi
    done
}

# Main Argument Parsing
FS_PROFILES=()
NET_PROFILE=""
CLI_PROFILE=""
COMMAND=()

while [[ $# -gt 0 ]]; do
    case "$1" in
        --list-profiles)
            list_profiles
            exit 0
            ;;
        --list-sessions)
            echo "Active Sessions (this directory):"
            for sdir in "$STATE_DIR"/*; do
                if [[ -d "$sdir" && -f "$sdir/session.json" ]]; then
                    scwd=$(jq -r '.cwd' "$sdir/session.json")
                    if [[ "$scwd" == "$PWD" ]]; then
                        sid=$(jq -r '.id' "$sdir/session.json")
                        pid=$(jq -r '.pid // empty' "$sdir/session.json")
                        if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
                            echo "  $sid (active, PID: $pid)"
                        else
                            echo "  $sid (inactive)"
                        fi
                    fi
                fi
            done
            exit 0
            ;;
        --join)
            JOIN_SESSION="$2"
            shift 2
            SDIR="$STATE_DIR/$JOIN_SESSION"
            if [[ -d "$SDIR" && -f "$SDIR/abduco.sock" ]]; then
                abduco -a "$SDIR/abduco.sock"
            else
                echo "Error: Session '$JOIN_SESSION' not found or no socket available." >&2
                exit 1
            fi
            exit 0
            ;;
        --fs)
            FS_PROFILES+=("$(resolve_profile fs "$2")")
            shift 2
            ;;
        --net)
            NET_PROFILE="$(resolve_profile net "$2")"
            shift 2
            ;;
        --cli)
            CLI_PROFILE="$(resolve_profile cli "$2")"
            shift 2
            ;;
        --)
            shift
            COMMAND=("$@")
            break
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            if [[ ${#COMMAND[@]} -eq 0 ]]; then
                COMMAND=("$@")
                break
            else
                break
            fi
            ;;
    esac
done

if [[ ${#COMMAND[@]} -eq 0 ]]; then
    COMMAND=("/bin/bash")
fi

# Session Initialization
SESSION_ID=$(date +%Y%m%d-%H%M%S)-$(printf "%04x" $RANDOM)
SESSION_DIR="$STATE_DIR/$SESSION_ID"
mkdir -p "$SESSION_DIR/fs"
mkdir -p "$SESSION_DIR/tmp"

# Bwrap Arguments
BWRAP_ARGS=(
    --unshare-ipc
    --unshare-pid
    --unshare-uts
    --unshare-cgroup
    --new-session
    --proc /proc
    --dev /dev
    --tmpfs /tmp
    --tmpfs /run
    --ro-bind /usr /usr
    --ro-bind /etc /etc
    --symlink usr/bin /bin
    --symlink usr/lib /lib
    --symlink usr/lib64 /lib64
    --bind "$SESSION_DIR" "$SESSION_DIR"
)

if [[ -n "$NET_PROFILE" ]]; then
    # When networking is enabled, pasta creates the user and net namespaces.
    # bwrap joins them and provides filesystem isolation.
    # We need to keep capabilities to allow dnscrypt-proxy and nftables to work.
    BWRAP_ARGS+=(--cap-add ALL)
else
    # Without networking, bwrap creates its own namespaces.
    BWRAP_ARGS+=(--unshare-user --unshare-net --uid 0 --gid 0)
fi

COPY_MOUNTS=() # Array of "source:dest"

apply_mounts() {
    local profile="$1"
    # Use jq to extract mounts
    mounts=$(jq -c '.mounts[]?' "$profile")
    [[ -z "$mounts" ]] && return

    while IFS= read -r m; do
        [[ -z "$m" ]] && continue
        source=$(echo "$m" | jq -r '.source' | envsubst)
        source=$(realpath -m "$source")
        dest=$(echo "$m" | jq -r '.dest' | envsubst)
        perm=$(echo "$m" | jq -r '.perm')

        # Ensure parent directories exist in the sandbox
        parent=$(dirname "$dest")
        if [[ "$parent" != "/" ]]; then
            IFS='/' read -ra ADDR <<< "$parent"
            curr=""
            for i in "${ADDR[@]}"; do
                if [[ -n "$i" ]]; then
                    curr="$curr/$i"
                    BWRAP_ARGS+=(--dir "$curr")
                fi
            done
        fi

        case "$perm" in
            ro)
                BWRAP_ARGS+=(--ro-bind "$source" "$dest")
                ;;
            rw)
                BWRAP_ARGS+=(--bind "$source" "$dest")
                ;;
            copy)
                BWRAP_ARGS+=(--tmpfs "$dest")
                COPY_MOUNTS+=("$source:$dest")
                ;;
        esac
    done <<< "$mounts"
}

for profile in "${FS_PROFILES[@]}"; do
    apply_mounts "$profile"
done

if [[ -n "$CLI_PROFILE" ]]; then
    apply_mounts "$CLI_PROFILE"
fi

# Pre-population for copy mounts
mkdir -p "$SESSION_DIR/tmp_mounts"

for cm in "${COPY_MOUNTS[@]}"; do
    src="${cm%%:*}"
    dst="${cm#*:}"
    
    mount_id=$(echo "$dst" | tr '/' '_')
    tmp_src="$SESSION_DIR/tmp_mounts/$mount_id"
    mkdir -p "$tmp_src"
    
    if [[ -d "$src" ]]; then
        cp -a "$src/." "$tmp_src/"
    elif [[ -f "$src" ]]; then
        cp -a "$src" "$tmp_src/"
    fi
    
    BWRAP_ARGS+=(--bind "$tmp_src" "$dst")
done

# Parse Environment and Working Directory from all profiles
WORKDIR=""
SANDBOX_PATH=""
for profile in "${FS_PROFILES[@]}" "$CLI_PROFILE"; do
    [[ -z "$profile" ]] && continue
    
    # Working Directory (last one wins)
    WDIR=$(jq -r '.workingDirectory // empty' "$profile" | envsubst)
    [[ -n "$WDIR" ]] && WORKDIR="$WDIR"

    # Environment Variables
    while IFS='=' read -r key value; do
        if [[ -n "$key" ]]; then
            val=$(echo "$value" | envsubst)
            [[ "$key" == "PATH" ]] && SANDBOX_PATH="$val"
            BWRAP_ARGS+=(--setenv "$key" "$val")
        fi
    done < <(jq -r '.env // {} | to_entries[]? | "\(.key)=\(.value)"' "$profile")
done

if [[ -n "$WORKDIR" ]]; then
    BWRAP_ARGS+=(--chdir "$WORKDIR")
fi

# Handle CLI-specific 'path' prepending
DEFAULT_PATH="/usr/local/bin:/usr/bin:/bin"
if [[ -n "$CLI_PROFILE" ]]; then
    EXTRA_PATHS=$(jq -r '.path[]?' "$CLI_PROFILE" | envsubst | paste -sd: -)
    if [[ -n "$EXTRA_PATHS" ]]; then
        if [[ -n "$SANDBOX_PATH" ]]; then
            SANDBOX_PATH="$EXTRA_PATHS:$SANDBOX_PATH:$DEFAULT_PATH"
        else
            SANDBOX_PATH="$EXTRA_PATHS:$DEFAULT_PATH"
        fi
    else
        [[ -z "$SANDBOX_PATH" ]] && SANDBOX_PATH="$DEFAULT_PATH"
    fi
else
    [[ -z "$SANDBOX_PATH" ]] && SANDBOX_PATH="$DEFAULT_PATH"
fi
BWRAP_ARGS+=(--setenv PATH "$SANDBOX_PATH")

# Network Setup
if [[ -n "$NET_PROFILE" ]]; then
    # Detect host network settings for manual injection if pasta auto-config fails
    HOST_IFACE=$(ip route show default | awk '{print $5}' | head -n 1)
    HOST_IP=$(ip addr show "$HOST_IFACE" | grep "inet " | awk '{print $2}' | cut -d/ -f1 | head -n 1)
    HOST_GW=$(ip route show default | awk '{print $3}' | head -n 1)
    HOST_MASK=$(ip addr show "$HOST_IFACE" | grep "inet " | awk '{print $2}' | cut -d/ -f2 | head -n 1)
    
    export HOST_IFACE HOST_IP HOST_GW HOST_MASK

    DNS_DIR="$SESSION_DIR/dns"
    mkdir -p "$DNS_DIR"
    
    ALLOWED_NAMES="$DNS_DIR/allowed-names.txt"
    jq -r '.allow[]? | select(type == "string" and test("^[a-zA-Z*]"))' "$NET_PROFILE" > "$ALLOWED_NAMES"
    
    DNS_SETTING=$(jq -r '.dns // empty' "$NET_PROFILE")
    
    # Generate dnscrypt-proxy.toml and potential forwarding rules
    if [[ "$DNS_SETTING" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
        # It's an IP address - use it as a forwarder
        echo ". $DNS_SETTING" > "$DNS_DIR/forwarding-rules.txt"
        cat > "$DNS_DIR/dnscrypt-proxy.toml" <<EOF
listen_addresses = ['127.0.0.1:53']
ignore_system_dns = true
block_ipv6 = true
server_names = ['fallback']
forwarding_rules = '$DNS_DIR/forwarding-rules.txt'

[static]
  [static.fallback]
    stamp = 'sdns://AgcAAAAAAAAABzEuMS4xLjEAEmRucy5jbG91ZGZsYXJlLmNvbQovZG5zLXF1ZXJ5'

[query_log]
  file = '$DNS_DIR/query.log'

[allowed_names]
  allowed_names_file = '$ALLOWED_NAMES'
EOF
    else
        # It's a stamp or name (default to Cloudflare if empty)
        [[ -z "$DNS_SETTING" ]] && DNS_SETTING="sdns://AgcAAAAAAAAABzEuMS4xLjEAEmRucy5jbG91ZGZsYXJlLmNvbQovZG5zLXF1ZXJ5"
        
        cat > "$DNS_DIR/dnscrypt-proxy.toml" <<EOF
listen_addresses = ['127.0.0.1:53']
ignore_system_dns = true
block_ipv6 = true
server_names = ['custom']

[static]
  [static.custom]
    stamp = '$DNS_SETTING'

[query_log]
  file = '$DNS_DIR/query.log'

[allowed_names]
  allowed_names_file = '$ALLOWED_NAMES'
EOF
    fi

    # resolv.conf
    cat > "$DNS_DIR/resolv.conf" <<EOF
nameserver 127.0.0.1
EOF
    BWRAP_ARGS+=(--ro-bind "$DNS_DIR/resolv.conf" /etc/resolv.conf)

    # nftables setup
    NFT_RULES="$DNS_DIR/rules.nft"
    {
        echo "table inet sbx_filter {"
        echo "    chain output {"
        echo "        type filter hook output priority 0; policy drop;"
        echo "        oif \"lo\" accept"
        echo "        ct state established,related accept"
        echo "        ip daddr 127.0.0.1 udp dport 53 accept"
        echo "        ip daddr 127.0.0.1 tcp dport 53 accept"
        
        # Automatically allow the DNS server if it's an IP
        if [[ "$DNS_SETTING" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
            echo "        ip daddr $DNS_SETTING udp dport 53 accept"
            echo "        ip daddr $DNS_SETTING tcp dport 53 accept"
        fi

        # Add CIDRs
        jq -r '.allow[]? | select(test("^[0-9]"))' "$NET_PROFILE" | while read -r cidr; do
            [[ -z "$cidr" ]] && continue
            echo "        ip daddr $cidr accept"
        done
        
        # Add Ports
        if jq -e '.ports[]? | select(. == "*")' "$NET_PROFILE" >/dev/null 2>&1; then
            echo "        meta l4proto tcp accept"
            echo "        meta l4proto udp accept"
        else
            ports=$(jq -r '.ports[]?' "$NET_PROFILE" | paste -sd, -)
            if [[ -n "$ports" ]]; then
                echo "        tcp dport { $ports } accept"
                echo "        udp dport { $ports } accept"
            elif [[ -n "$(jq -r '.allow[]? | select(test("^[a-zA-Z]"))' "$NET_PROFILE")" ]]; then
                # If hostnames are allowed but no ports specified, allow 80/443
                echo "        tcp dport { 80, 443 } accept"
            fi
        fi
    } > "$NFT_RULES"
    echo "    }" >> "$NFT_RULES"
    echo "}" >> "$NFT_RULES"
fi

# Session State Persistence
cat > "$SESSION_DIR/session.json" <<EOF
{
    "id": "$SESSION_ID",
    "cwd": "$PWD",
    "fs_profiles": $(printf '%s\n' "${FS_PROFILES[@]}" | jq -R . | jq -s .),
    "net_profile": $([[ -n "$NET_PROFILE" ]] && jq -R . <<< "$NET_PROFILE" || echo "null"),
    "cli_profile": $([[ -n "$CLI_PROFILE" ]] && jq -R . <<< "$CLI_PROFILE" || echo "null")
}
EOF

# Teardown Logic
teardown() {
    echo "Tearing down session $SESSION_ID..."
    
    # Egress for copy mounts
    for cm in "${COPY_MOUNTS[@]}"; do
        src="${cm%%:*}"
        dst="${cm#*:}"
        mount_id=$(echo "$dst" | tr '/' '_')
        tmp_src="$SESSION_DIR/tmp_mounts/$mount_id"
        
        egress_dir="$SESSION_DIR/fs/$mount_id"
        mkdir -p "$egress_dir"
        
        if [[ -d "$src" ]]; then
            if command -v rsync >/dev/null 2>&1; then
                # Optimized sync using rsync
                rsync -a --compare-dest="$src/" "$tmp_src/" "$egress_dir/"
            else
                (
                    cd "$tmp_src"
                    find . -type f -print0 | while IFS= read -r -d '' rel_path; do
                        rel_path="${rel_path#./}"
                        file="$tmp_src/$rel_path"
                        orig_file="$src/$rel_path"

                        needs_copy=0
                        if [[ ! -f "$orig_file" ]]; then
                            needs_copy=1
                        else
                            if [[ $(stat -c %s "$file") -ne $(stat -c %s "$orig_file") ]] || \
                               [[ $(stat -c %Y "$file") -gt $(stat -c %Y "$orig_file") ]]; then
                                needs_copy=1
                            fi
                        fi

                        if [[ $needs_copy -eq 1 ]]; then
                            mkdir -p "$(dirname "$egress_dir/$rel_path")"
                            cp -a "$file" "$egress_dir/$rel_path"
                        fi
                    done
                )
            fi
        elif [[ -f "$src" ]]; then
            # If it's a single file, it's copied into tmp_src/$(basename src)
            filename=$(basename "$src")
            file="$tmp_src/$filename"
            
            needs_copy=0
            if [[ $(stat -c %s "$file") -ne $(stat -c %s "$src") ]] || \
               [[ $(stat -c %Y "$file") -gt $(stat -c %Y "$src") ]]; then
                needs_copy=1
            fi
            
            if [[ $needs_copy -eq 1 ]]; then
                cp -a "$file" "$egress_dir/$filename"
            fi
        fi
    done

    rm -rf "$SESSION_DIR/tmp_mounts"
    rm -f "$SESSION_DIR/abduco.sock" "$SESSION_DIR/wrapper.sh"
    
    echo "Session $SESSION_ID finished. Changes saved to $SESSION_DIR/fs"
}

trap teardown EXIT

# Execution
ABDUCO_SOCK="$SESSION_DIR/abduco.sock"
LAUNCH_SCRIPT="$SESSION_DIR/launch.sh"
CAT_WRAPPER="$SESSION_DIR/wrapper.sh"
DNSCRYPT_BIN=$(which dnscrypt-proxy)
if [[ -n "$NET_PROFILE" ]]; then
    cat > "$CAT_WRAPPER" <<EOF
#!/bin/bash
# Manual network initialization inside the namespace
ip link set lo up >/dev/null 2>&1

# Apply nftables rules (we are root in the sandbox userns)
if [[ -f "$NFT_RULES" ]]; then
    # Try to apply nft rules, but don't fail the whole session if it fails
    # Some environments have restrictive sysctls even for root in a userns
    nft -f "$NFT_RULES" >/dev/null 2>&1 || echo "Warning: Could not apply nftables rules. Networking will be unrestricted." >&2
fi

"$DNSCRYPT_BIN" -config "$DNS_DIR/dnscrypt-proxy.toml" > "$DNS_DIR/dnscrypt.log" 2>&1 &
DNS_PID=\$!
# Wait for dnscrypt-proxy to start and check if it's still running
for i in {1..20}; do
    if kill -0 \$DNS_PID 2>/dev/null; then
        if grep -q "Now listening" "$DNS_DIR/dnscrypt.log" 2>/dev/null; then
            # Verify DNS is actually working before proceeding
            if getent hosts github.com >/dev/null 2>&1; then
                break
            fi
        fi
    else
        echo "Error: dnscrypt-proxy failed to start. Log output:" >&2
        cat "$DNS_DIR/dnscrypt.log" >&2
        exit 1
    fi
    sleep 0.5
done
$(printf "%q " "${COMMAND[@]}")
kill \$DNS_PID 2>/dev/null || true
EOF
else
    cat > "$CAT_WRAPPER" <<EOF
#!/bin/bash
$(printf "%q " "${COMMAND[@]}")
EOF
fi
chmod +x "$CAT_WRAPPER"

# Generate the launch script with properly escaped BWRAP_ARGS
cat > "$LAUNCH_SCRIPT" <<EOF
#!/bin/bash
# Start the sandbox
EOF

printf "exec bwrap " >> "$LAUNCH_SCRIPT"
for arg in "${BWRAP_ARGS[@]}"; do
    printf "%q " "$arg" >> "$LAUNCH_SCRIPT"
done
ABDUCO_BIN=$(which abduco)
printf "%q -c %q %q\n" "$ABDUCO_BIN" "$ABDUCO_SOCK" "$CAT_WRAPPER" >> "$LAUNCH_SCRIPT"

chmod +x "$LAUNCH_SCRIPT"

if [[ -n "$NET_PROFILE" ]]; then
    echo "Starting session $SESSION_ID with networking..."
    pasta -f --config-net --interface "$HOST_IFACE" --no-ndp --no-dhcpv6 --no-ra -a "$HOST_IP" -g "$HOST_GW" -n "$HOST_MASK" -- "$LAUNCH_SCRIPT"
else
    echo "Starting session $SESSION_ID..."
    "$LAUNCH_SCRIPT"
fi
