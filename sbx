#!/bin/bash

# sbx - Portable Unprivileged Sandbox Orchestrator

set -e

STATE_DIR="$HOME/.local/state/sbx"
CONFIG_DIR="$HOME/.config/sbx"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Ensure state directory exists
mkdir -p "$STATE_DIR"

usage() {
    cat <<EOF
Usage: $(basename "$0") [options] [command]

Options:
  --list-profiles        Show available profiles
  --list-sessions        Show active sessions
  --join <session>       Attach to an existing session
  --fs <profile>         Apply a filesystem profile (multiple allowed)
  --net <profile>        Apply a network profile
  --cli <profile>        Apply a CLI/environment profile
  -h, --help             Show this help message

Profiles are searched in:
  1. ./.sbx/profiles/
  2. \$HOME/.config/sbx/profiles/
  3. $SCRIPT_DIR/profiles/
EOF
}

resolve_profile() {
    local type="$1"
    local name="$2"

    # If it's a direct path to a file, use it
    if [[ -f "$name" ]]; then
        realpath "$name"
        return 0
    fi
    if [[ -f "$name.json" ]]; then
        realpath "$name.json"
        return 0
    fi

    # Strip the type prefix if it was included (e.g., "cli/dev" -> "dev")
    if [[ "$name" == "$type/"* ]]; then
        name="${name#$type/}"
    fi

    local paths=(
        "./.sbx/profiles/$type/$name.json"
        "$CONFIG_DIR/profiles/$type/$name.json"
        "$SCRIPT_DIR/profiles/$type/$name.json"
    )

    for p in "${paths[@]}"; do
        if [[ -f "$p" ]]; then
            echo "$p"
            return 0
        fi
    done

    echo "Error: Profile '$name' of type '$type' not found." >&2
    exit 1
}

list_profiles() {
    local types=("cli" "fs" "net")
    local sources=(
        "Project:./.sbx/profiles"
        "User:$CONFIG_DIR/profiles"
        "Global:$SCRIPT_DIR/profiles"
    )

    echo "Available Profiles:"
    for type in "${types[@]}"; do
        echo ""
        echo "${type^^} Profiles:"
        local found=0
        for src in "${sources[@]}"; do
            local label="${src%%:*}"
            local path="${src#*:}"
            if [[ -d "$path/$type" ]]; then
                # Use a temporary variable to capture find output to avoid empty lines
                local files
                files=$(find "$path/$type" -name "*.json" | sed "s|$path/$type/||" | sed 's/\.json$//' | sort)
                if [[ -n "$files" ]]; then
                    while IFS= read -r profile; do
                        echo "  $profile ($label)"
                        found=1
                    done <<< "$files"
                fi
            fi
        done
        if [[ $found -eq 0 ]]; then
            echo "  (none)"
        fi
    done
}

# Main Argument Parsing
FS_PROFILES=()
NET_PROFILE=""
CLI_PROFILE=""
COMMAND=()

while [[ $# -gt 0 ]]; do
    case "$1" in
        --list-profiles)
            list_profiles
            exit 0
            ;;
        --list-sessions)
            echo "Active Sessions (this directory):"
            for sdir in "$STATE_DIR"/*; do
                if [[ -d "$sdir" && -f "$sdir/session.json" ]]; then
                    scwd=$(jq -r '.cwd' "$sdir/session.json")
                    if [[ "$scwd" == "$PWD" ]]; then
                        sid=$(jq -r '.id' "$sdir/session.json")
                        pid=$(jq -r '.pid // empty' "$sdir/session.json")
                        if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
                            echo "  $sid (active, PID: $pid)"
                        else
                            echo "  $sid (inactive)"
                        fi
                    fi
                fi
            done
            exit 0
            ;;
        --join)
            JOIN_SESSION="$2"
            shift 2
            SDIR="$STATE_DIR/$JOIN_SESSION"
            if [[ -d "$SDIR" && -f "$SDIR/abduco.sock" ]]; then
                abduco -a "$SDIR/abduco.sock"
            else
                echo "Error: Session '$JOIN_SESSION' not found or no socket available." >&2
                exit 1
            fi
            exit 0
            ;;
        --fs)
            FS_PROFILES+=("$(resolve_profile fs "$2")")
            shift 2
            ;;
        --net)
            NET_PROFILE="$(resolve_profile net "$2")"
            shift 2
            ;;
        --cli)
            CLI_PROFILE="$(resolve_profile cli "$2")"
            shift 2
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            if [[ ${#COMMAND[@]} -eq 0 ]]; then
                COMMAND=("$@")
                break
            else
                break
            fi
            ;;
    esac
done

if [[ ${#COMMAND[@]} -eq 0 ]]; then
    COMMAND=("/bin/bash")
fi

# Session Initialization
SESSION_ID=$(date +%Y%m%d-%H%M%S)-$(printf "%04x" $RANDOM)
SESSION_DIR="$STATE_DIR/$SESSION_ID"
mkdir -p "$SESSION_DIR/fs"
mkdir -p "$SESSION_DIR/tmp"

# Bwrap Arguments
BWRAP_ARGS=(
    --unshare-user
    --unshare-ipc
    --unshare-pid
    --unshare-uts
    --unshare-cgroup
    --new-session
    --proc /proc
    --dev /dev
    --tmpfs /tmp
    --tmpfs /run
    --ro-bind /usr /usr
    --ro-bind /etc /etc
    --symlink usr/bin /bin
    --symlink usr/lib /lib
    --symlink usr/lib64 /lib64
    --bind "$SESSION_DIR" "$SESSION_DIR"
)

if [[ -z "$NET_PROFILE" ]]; then
    BWRAP_ARGS+=(--unshare-net)
fi

COPY_MOUNTS=() # Array of "source:dest"

apply_mounts() {
    local profile="$1"
    # Use jq to extract mounts
    mounts=$(jq -c '.mounts[]?' "$profile")
    [[ -z "$mounts" ]] && return

    while IFS= read -r m; do
        [[ -z "$m" ]] && continue
        source=$(echo "$m" | jq -r '.source' | envsubst)
        source=$(realpath -m "$source")
        dest=$(echo "$m" | jq -r '.dest' | envsubst)
        perm=$(echo "$m" | jq -r '.perm')

        # Ensure parent directories exist in the sandbox
        parent=$(dirname "$dest")
        if [[ "$parent" != "/" ]]; then
            IFS='/' read -ra ADDR <<< "$parent"
            curr=""
            for i in "${ADDR[@]}"; do
                if [[ -n "$i" ]]; then
                    curr="$curr/$i"
                    BWRAP_ARGS+=(--dir "$curr")
                fi
            done
        fi

        case "$perm" in
            ro)
                BWRAP_ARGS+=(--ro-bind "$source" "$dest")
                ;;
            rw)
                BWRAP_ARGS+=(--bind "$source" "$dest")
                ;;
            copy)
                BWRAP_ARGS+=(--tmpfs "$dest")
                COPY_MOUNTS+=("$source:$dest")
                ;;
        esac
    done <<< "$mounts"
}

for profile in "${FS_PROFILES[@]}"; do
    apply_mounts "$profile"
done

if [[ -n "$CLI_PROFILE" ]]; then
    apply_mounts "$CLI_PROFILE"
fi

# Pre-population for copy mounts
mkdir -p "$SESSION_DIR/tmp_mounts"

for cm in "${COPY_MOUNTS[@]}"; do
    src="${cm%%:*}"
    dst="${cm#*:}"
    
    mount_id=$(echo "$dst" | tr '/' '_')
    tmp_src="$SESSION_DIR/tmp_mounts/$mount_id"
    mkdir -p "$tmp_src"
    
    if [[ -d "$src" ]]; then
        cp -a "$src/." "$tmp_src/"
    elif [[ -f "$src" ]]; then
        cp -a "$src" "$tmp_src/"
    fi
    
    BWRAP_ARGS+=(--bind "$tmp_src" "$dst")
done

# Parse CLI Profile
if [[ -n "$CLI_PROFILE" ]]; then
    WORKDIR=$(jq -r '.workingDirectory // empty' "$CLI_PROFILE" | envsubst)
    if [[ -n "$WORKDIR" ]]; then
        BWRAP_ARGS+=(--chdir "$WORKDIR")
    fi

    while IFS='=' read -r key value; do
        if [[ -n "$key" ]]; then
            BWRAP_ARGS+=(--setenv "$key" "$(echo "$value" | envsubst)")
        fi
    done < <(jq -r '.env | to_entries[] | "\(.key)=\(.value)"' "$CLI_PROFILE")
fi

# Network Setup
if [[ -n "$NET_PROFILE" ]]; then
    DNS_DIR="$SESSION_DIR/dns"
    mkdir -p "$DNS_DIR"
    
    ALLOWED_NAMES="$DNS_DIR/allowed-names.txt"
    jq -r '.allow[]? | select(test("^[a-zA-Z]"))' "$NET_PROFILE" > "$ALLOWED_NAMES"
    
    # Minimal dnscrypt-proxy.toml
    cat > "$DNS_DIR/dnscrypt-proxy.toml" <<EOF
listen_addresses = ['127.0.0.1:53']
server_names = ['cloudflare']
[query_log]
  file = '$DNS_DIR/query.log'
[allowed_names]
  allowed_names_file = '$ALLOWED_NAMES'
EOF

    # resolv.conf
    cat > "$DNS_DIR/resolv.conf" <<EOF
nameserver 127.0.0.1
EOF
    BWRAP_ARGS+=(--ro-bind "$DNS_DIR/resolv.conf" /etc/resolv.conf)

    # nftables setup
    NFT_RULES="$DNS_DIR/rules.nft"
    {
        echo "table inet sbx_filter {"
        echo "    chain output {"
        echo "        type filter hook output priority 0; policy drop;"
        echo "        oif \"lo\" accept"
        echo "        ct state established,related accept"
        echo "        ip daddr 127.0.0.1 udp dport 53 accept"
        
        # Add CIDRs
        jq -r '.allow[]? | select(test("^[0-9]"))' "$NET_PROFILE" | while read -r cidr; do
            [[ -z "$cidr" ]] && continue
            echo "        ip daddr $cidr accept"
        done
        
        # Add Ports
        ports=$(jq -r '.ports[]?' "$NET_PROFILE" | paste -sd, -)
        if [[ -n "$ports" ]]; then
            echo "        tcp dport { $ports } accept"
            echo "        udp dport { $ports } accept"
        elif [[ -n "$(jq -r '.allow[]? | select(test("^[a-zA-Z]"))' "$NET_PROFILE")" ]]; then
            # If hostnames are allowed but no ports specified, allow 80/443
            echo "        tcp dport { 80, 443 } accept"
        fi
        echo "    }"
        echo "}"
    } > "$NFT_RULES"
fi

# Session State Persistence
cat > "$SESSION_DIR/session.json" <<EOF
{
    "id": "$SESSION_ID",
    "cwd": "$PWD",
    "fs_profiles": $(printf '%s\n' "${FS_PROFILES[@]}" | jq -R . | jq -s .),
    "net_profile": $([[ -n "$NET_PROFILE" ]] && jq -R . <<< "$NET_PROFILE" || echo "null"),
    "cli_profile": $([[ -n "$CLI_PROFILE" ]] && jq -R . <<< "$CLI_PROFILE" || echo "null")
}
EOF

# Teardown Logic
teardown() {
    echo "Tearing down session $SESSION_ID..."
    
    # Kill remaining processes in the namespace
    PID=$(jq -r '.pid // empty' "$SESSION_DIR/session.json")
    if [[ -n "$PID" ]]; then
        kill -TERM -"$PID" 2>/dev/null || true
    fi

    # Egress for copy mounts
    for cm in "${COPY_MOUNTS[@]}"; do
        src="${cm%%:*}"
        dst="${cm#*:}"
        mount_id=$(echo "$dst" | tr '/' '_')
        tmp_src="$SESSION_DIR/tmp_mounts/$mount_id"
        
        egress_dir="$SESSION_DIR/fs/$mount_id"
        mkdir -p "$egress_dir"
        
        if [[ -d "$src" ]]; then
            (
                cd "$tmp_src"
                find . -type f -print0 | while IFS= read -r -d '' rel_path; do
                    rel_path="${rel_path#./}"
                    file="$tmp_src/$rel_path"
                    orig_file="$src/$rel_path"
                    
                    needs_copy=0
                    if [[ ! -f "$orig_file" ]]; then
                        needs_copy=1
                    else
                        if [[ $(stat -c %s "$file") -ne $(stat -c %s "$orig_file") ]] || \
                           [[ $(stat -c %Y "$file") -gt $(stat -c %Y "$orig_file") ]]; then
                            needs_copy=1
                        fi
                    fi
                    
                    if [[ $needs_copy -eq 1 ]]; then
                        mkdir -p "$(dirname "$egress_dir/$rel_path")"
                        cp -a "$file" "$egress_dir/$rel_path"
                    fi
                done
            )
        elif [[ -f "$src" ]]; then
            # If it's a single file, it's copied into tmp_src/$(basename src)
            filename=$(basename "$src")
            file="$tmp_src/$filename"
            
            needs_copy=0
            if [[ $(stat -c %s "$file") -ne $(stat -c %s "$src") ]] || \
               [[ $(stat -c %Y "$file") -gt $(stat -c %Y "$src") ]]; then
                needs_copy=1
            fi
            
            if [[ $needs_copy -eq 1 ]]; then
                cp -a "$file" "$egress_dir/$filename"
            fi
        fi
    done

    rm -rf "$SESSION_DIR/tmp_mounts"
    rm -f "$SESSION_DIR/abduco.sock" "$SESSION_DIR/wrapper.sh"
    
    echo "Session $SESSION_ID finished. Changes saved to $SESSION_DIR/fs"
}

trap teardown EXIT

# Execution
ABDUCO_SOCK="$SESSION_DIR/abduco.sock"
LAUNCH_SCRIPT="$SESSION_DIR/launch.sh"
CAT_WRAPPER="$SESSION_DIR/wrapper.sh"

if [[ -n "$NET_PROFILE" ]]; then
    cat > "$CAT_WRAPPER" <<EOF
#!/bin/bash
dnscrypt-proxy -config "$DNS_DIR/dnscrypt-proxy.toml" > "$DNS_DIR/dnscrypt.log" 2>&1 &
DNS_PID=\$!
sleep 5
"${COMMAND[@]}"
kill \$DNS_PID 2>/dev/null || true
EOF
else
    cat > "$CAT_WRAPPER" <<EOF
#!/bin/bash
"${COMMAND[@]}"
EOF
fi
chmod +x "$CAT_WRAPPER"

# Generate the launch script with properly escaped BWRAP_ARGS
cat > "$LAUNCH_SCRIPT" <<EOF
#!/bin/bash
# Record PID
jq ".pid = \$\$" "$SESSION_DIR/session.json" > "$SESSION_DIR/session.json.tmp" && mv "$SESSION_DIR/session.json.tmp" "$SESSION_DIR/session.json"

# Apply nftables rules if they exist (must be done in the net namespace)
if [[ -n "\$NFT_RULES" && -f "\$NFT_RULES" ]]; then
    nft -f "\$NFT_RULES"
fi

# Start the sandbox
EOF

printf "exec bwrap " >> "$LAUNCH_SCRIPT"
for arg in "${BWRAP_ARGS[@]}"; do
    printf "%q " "$arg" >> "$LAUNCH_SCRIPT"
done
ABDUCO_BIN=$(which abduco)
printf "%q -c %q %q\n" "$ABDUCO_BIN" "$ABDUCO_SOCK" "$CAT_WRAPPER" >> "$LAUNCH_SCRIPT"

chmod +x "$LAUNCH_SCRIPT"

if [[ -n "$NET_PROFILE" ]]; then
    echo "Starting session $SESSION_ID with networking..."
    pasta -f -- "$LAUNCH_SCRIPT"
else
    echo "Starting session $SESSION_ID..."
    "$LAUNCH_SCRIPT"
fi
